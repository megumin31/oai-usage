def joint_portion(atoms: list) -> dict:
    """An indivisible aggregate contamination budget over original raw edges."""
    first, last = atoms[0], atoms[-1]
    identity = ":".join((first["before"]["id"], last["after"]["id"]))
    return {"id": "joint-portion:" + identity,
        "before": first["before"], "after": last["after"],
        "quota_epoch_id": first.get("quota_epoch_id"), "profile": first.get("profile"),
        "policy_id": "joint_portions", "alignment_offset_seconds": first.get("alignment_offset_seconds"),
        "known_api_cost_usd": sum(b["known_api_cost_usd"] for b in atoms),
        "delta_percent": sum(b["delta_percent"] for b in atoms),
        "span_seconds": sum(b["span_seconds"] for b in atoms),
        "atomic_block_ids": [b["id"] for b in atoms], "atoms": atoms,
        "clean_budget_eligible": all(b.get("clean_budget_eligible", True) for b in atoms)}


def joint_discovery_tilings(blocks: list, spans: tuple = (300, 900, 1800)) -> list:
    """Time-only nonoverlapping partitions. Every tail survives; gaps split."""
    blocks = frontier_unique_blocks(blocks)
    tilings = {}
    for span in spans:
        if not math.isfinite(span) or span <= 0:
            raise ValueError("Joint discovery span must be finite and positive")
        base, pending = [], []
        duration = 0.0
        for block in blocks:
            if pending and not frontier_adjacent(pending[-1], block):
                base.append(joint_portion(pending))
                pending, duration = [], 0.0
            pending.append(block)
            duration += block["span_seconds"]
            if duration >= span:
                base.append(joint_portion(pending))
                pending, duration = [], 0.0
        if pending:
            base.append(joint_portion(pending))
        for count in (1, 2, 4, 8):
            portions, pending = [], []
            for unit in base:
                if pending and not frontier_adjacent(pending[-1], unit):
                    portions.append(joint_portion([b for p in pending for b in p["atoms"]]))
                    pending = []
                pending.append(unit)
                if len(pending) == count:
                    portions.append(joint_portion([b for p in pending for b in p["atoms"]]))
                    pending = []
            if pending:
                portions.append(joint_portion([b for p in pending for b in p["atoms"]]))
            key = tuple(tuple(p["atomic_block_ids"]) for p in portions)
            if key not in tilings:
                tilings[key] = {"portions": portions, "discovery_schemes": []}
            tilings[key]["discovery_schemes"].append({"target_span_seconds": span, "coarsening_count": count})
    return list(tilings.values())


def joint_portion_interval(portion: dict, envelope: float) -> dict:
    return robust_rate_interval(portion["atoms"], set(portion["atomic_block_ids"]), envelope,
                                clean_portions=[portion])


def joint_disjoint_membership(portions: list, eligible: set) -> set:
    """Phase-neutral maximum-cardinality non-touching portion subset.

    These portions have separate budgets and share no endpoints. Selection is a
    discovery aid; the all-raw exact solver still validates every proposal.
    """
    best = [((), 0.0, 0.0)]
    def choose(a, b):
        ka, kb = (len(a[0]), a[1], a[2]), (len(b[0]), b[1], b[2])
        return a if ka > kb or (ka == kb and a[0] < b[0]) else b
    for index, p in enumerate(portions):
        winner = best[-1]
        if p['id'] in eligible:
            boundary_shared = index > 0 and portions[index-1]['after']['id'] == p['before']['id']
            prefix = best[index-1 if boundary_shared else index]
            proposal = (prefix[0]+(p['id'],), prefix[1]+p['known_api_cost_usd'], prefix[2]+p['span_seconds'])
            winner = choose(winner, proposal)
        best.append(winner)
    return set(best[-1][0])


def joint_overlap_memberships(portions: list, envelope: float,
                              one_sided: Optional[dict] = None) -> list:
    """Marginal overlaps plus informative, jointly checkable separated subsets.

    All membership alternatives remain conditional. This finite discovery
    family does not enumerate every possible feasible clean-portion subset.
    """
    events = defaultdict(lambda: {'start': set(), 'end': set(), 'info_start': set(), 'info_end': set()})
    for portion in portions:
        if portion['known_api_cost_usd'] <= 0 or not portion.get('clean_budget_eligible', True):
            continue
        interval = joint_portion_interval(portion, envelope)
        if not interval['feasible'] or interval['upper'] is None:
            continue
        low, high = interval['lower'], interval['upper']
        if one_sided is not None:
            low = max(low, one_sided['lower'])
            high = min(high, one_sided['upper']) if one_sided['upper'] is not None else high
        if high < low or high <= 0:
            continue
        events[low]['start'].add(portion['id']); events[high]['end'].add(portion['id'])
        low_before, _ = robust_endpoint_error(portion['before'], envelope)
        _, high_after = robust_endpoint_error(portion['after'], envelope)
        observed_lower = portion['delta_percent'] - (high_after-low_before)
        informative_low = max(low, 2*envelope/portion['known_api_cost_usd'])
        if observed_lower > 1e-10 and informative_low <= high:
            events[informative_low]['info_start'].add(portion['id'])
            events[high]['info_end'].add(portion['id'])
    active, info, memberships = set(), set(), set()
    cuts = sorted(events)
    def emit():
        if active:
            memberships.add(frozenset(active))
        separated = joint_disjoint_membership(portions, info)
        if separated:
            memberships.add(frozenset(separated))
    for n, cut in enumerate(cuts):
        active.update(events[cut]['start']); info.update(events[cut]['info_start'])
        if cut > 0:
            emit()
        active.difference_update(events[cut]['end']); info.difference_update(events[cut]['info_end'])
        if n+1 < len(cuts) and cuts[n+1] > max(0, cut):
            emit()
    return [set(ids) for ids in sorted(memberships, key=lambda ids: tuple(sorted(ids)))]


def joint_support(portions: list, selected: set, raw_weights: dict,
                  rate: Optional[float], envelope: float) -> dict:
    # A whole clean budget may be merged with another, never split into anchors.
    weights = {p["id"]: sum(raw_weights.get(bid, 0) for bid in p["atomic_block_ids"]) for p in portions}
    support = frontier_support_groups(portions, selected, weights, rate, envelope)
    by_id = {p["id"]: p for p in portions}
    used_portions = {pid for g in support["groups"] for pid in g["atomic_block_ids"]}
    raw_ids = {bid for pid in used_portions for bid in by_id[pid]["atomic_block_ids"]}
    selected_raw = {bid for pid in selected for bid in by_id[pid]["atomic_block_ids"]}
    support.update(covered_clean_portion_count=len(used_portions), covered_raw_edge_count=len(raw_ids),
        selected_clean_portion_count=len(selected), selected_raw_edge_count=len(selected_raw),
        original_raw_edge_count=len({bid for p in portions for bid in p["atomic_block_ids"]}),
        budget_units_are_indivisible=True, discovery_schemes_are_not_repetitions=True,
        weight_semantics="unique target cost divided by 2E; no observation-cadence multiplier; not statistical information",
        support_unit="selected disjoint aggregate-clean portions or adjacent merges; never fragments of one budget")
    return support


def joint_fit(blocks: list, *, envelope: float = 1,
              discovery_spans: tuple = (300, 900, 1800)) -> dict:
    blocks = frontier_unique_blocks(blocks)
    if blocks and any(any(b.get(key) != blocks[0].get(key) for key in
        ("quota_epoch_id", "profile", "alignment_offset_seconds")) for b in blocks[1:]):
        raise ValueError("Joint fit requires one epoch/profile/offset hypothesis")
    one_sided = robust_rate_interval(blocks, set(), envelope, clean_portions=[])
    endpoints = {b[side]["id"] for b in blocks for side in ("before", "after")}
    raw_weights = {b["id"]: b["known_api_cost_usd"] / (2 * envelope) for b in blocks}
    hypotheses, accepted, seen = [], [], set()
    tilings = joint_discovery_tilings(blocks, discovery_spans) if one_sided["feasible"] else []
    for tiling in tilings:
        portions = tiling["portions"]
        for selected in joint_overlap_memberships(portions, envelope, one_sided):
            clean = [p for p in portions if p["id"] in selected]
            # Same union under different subdivisions means different budgets.
            key = tuple(tuple(p["atomic_block_ids"]) for p in clean)
            if key in seen:
                continue
            seen.add(key)
            ids = {bid for p in clean for bid in p["atomic_block_ids"]}
            physical = robust_rate_interval(blocks, ids, envelope, clean_portions=clean)
            cost = sum(p["known_api_cost_usd"] for p in clean)
            delta = sum(p["delta_percent"] for p in clean)
            raw_rate = delta / cost if cost > 0 else None
            rate = min(max(raw_rate, physical["lower"]), physical["upper"]) if raw_rate is not None and raw_rate > 0 and physical["feasible"] and physical["upper"] is not None else None
            support = joint_support(portions, selected, raw_weights, rate, envelope)
            bounds = frontier_capacity_range(physical)
            reasons = []
            if rate is None or rate <= 0:
                reasons.append("no_positive_jointly_feasible_rate")
            if not physical["feasible"]:
                reasons.append("raw_shared_endpoint_constraints_infeasible")
            if bounds["lower"] is None or bounds["upper"] is None:
                reasons.append("no_finite_conditional_measurement_range")
            if support["group_count"] < 2:
                reasons.append("fewer_than_two_indivisible_informative_clean_groups")
            if (support["clean_predicted_delta_percent"] or 0) < 4 * envelope - 1e-10:
                reasons.append("insufficient_aggregate_quota_signal")
            row = {"id": f"joint-hypothesis-{len(hypotheses)+1}", "rate_interval": physical,
                "a_percent_per_usd": rate, "raw_ratio_of_sums_a": raw_rate,
                "estimated_total_api_cost_usd": 100 / rate if rate and rate > 0 else None,
                "conditional_range_usd": bounds, "support": support,
                "clean_portions": clean, "all_portions": portions,
                "discovery_schemes": tiling["discovery_schemes"],
                "reasons": reasons, "status": "supported_conditional_hypothesis" if not reasons else "unsupported_hypothesis"}
            hypotheses.append(row)
            if not reasons:
                accepted.append(row)
    neighborhoods = []
    for h in sorted(accepted, key=lambda h: (h["rate_interval"]["lower"], h["rate_interval"]["upper"], h["id"])):
        interval = h["rate_interval"]
        if neighborhoods and interval["lower"] <= neighborhoods[-1]["upper"]:
            neighborhoods[-1]["upper"] = max(neighborhoods[-1]["upper"], interval["upper"])
            neighborhoods[-1]["members"].append(h)
        else:
            neighborhoods.append({"lower": interval["lower"], "upper": interval["upper"], "members": [h]})
    chosen = min(neighborhoods[0]["members"], key=lambda h: (
        -h["support"]["covered_information_weight"], -h["support"]["group_count"],
        -h["support"]["span_seconds"], tuple(tuple(p["atomic_block_ids"]) for p in h["clean_portions"]))) if neighborhoods else None
    flags = []
    quantization = {"status": "unavailable", "capacity_range_usd": None}
    stress = {"status": "unavailable", "capacity_range_usd": None}
    if chosen:
        clean = chosen["clean_portions"]
        ids = {bid for p in clean for bid in p["atomic_block_ids"]}
        if all(float(b[s]["used_percent"]).is_integer() and 0 <= b[s]["used_percent"] < 100 for b in blocks for s in ("before", "after")):
            qi = robust_rate_interval(blocks, ids, .5, clip_endpoints=False, clean_portions=clean)
            quantization = {"status": "feasible" if qi["feasible"] else "quantization_alone_insufficient",
                "rate_interval": qi, "capacity_range_usd": frontier_capacity_range(qi),
                "main_point_compatible": robust_rate_contains(qi, chosen["a_percent_per_usd"]),
                "assumption": "fixed unknown-phase 1pp quantizer; no absolute clipping, timing or cache error",
                "frozen_clean_portion_budgets": True}
            if not qi["feasible"] or not quantization["main_point_compatible"]:
                flags.append("selected_point_requires_more_than_quantization_only_error")
        else:
            quantization["status"] = "not_applicable_to_noninteger_or_saturated_display"
        si = robust_rate_interval(blocks, ids, 2, clean_portions=clean)
        stress = {"status": "feasible" if si["feasible"] else "infeasible", "rate_interval": si,
            "capacity_range_usd": frontier_capacity_range(si), "frozen_clean_portion_budgets": True}
        if chosen["support"]["independent_support_count"] < 2:
            flags.append("repeated_groups_share_endpoint_errors")
        if chosen["support"]["support_weight_fraction"] < .25:
            flags.append("rare_frontier_support")
        if stress["capacity_range_usd"]["upper"] is None:
            flags.append("stress_upper_capacity_unbounded")
        cr = chosen["conditional_range_usd"]
        if (cr["upper"] - cr["lower"]) / chosen["estimated_total_api_cost_usd"] > .5:
            flags.append("wide_conditional_measurement_range")
    def portion_export(p):
        return {k: v for k, v in p.items() if k not in ("atoms", "before", "after", "profile", "policy_id")} | {
            "before_id": p["before"]["id"], "after_id": p["after"]["id"],
            "before_observed_at": p["before"].get("observed_at"), "after_observed_at": p["after"].get("observed_at")}
    reasons = [] if chosen else (["all_raw_one_sided_constraints_infeasible"] if not one_sided["feasible"] else
        sorted({r for h in hypotheses for r in h["reasons"]}) or ["no_raw_joint_near_clean_hypothesis"])
    return {"status": "conditional_joint_estimate" if chosen else "cannot_estimate",
        "estimated_total_api_cost_usd": chosen["estimated_total_api_cost_usd"] if chosen else None,
        "a_percent_per_usd": chosen["a_percent_per_usd"] if chosen else None,
        "conditional_range_usd": chosen["conditional_range_usd"] if chosen else {"lower": None, "upper": None, "feasible": False, "not_confidence_interval": True},
        "selected_hypothesis_id": chosen["id"] if chosen else None,
        "selected_clean_portions": [portion_export(p) for p in chosen["clean_portions"]] if chosen else [],
        "selected_raw_edge_ids": sorted({bid for p in chosen["clean_portions"] for bid in p["atomic_block_ids"]}) if chosen else [],
        "rate_interval": chosen["rate_interval"] if chosen else None,
        "support": chosen["support"] if chosen else {"group_count": 0, "covered_raw_edge_count": 0},
        "evidence_counts": {"raw_edges": len(blocks), "unique_raw_endpoints": len(endpoints),
            "one_sided_constraints": len(blocks), "endpoint_box_constraints": 2*len(endpoints),
            "cost_lower_bound_only_edges": sum(not b.get("clean_budget_eligible", True) for b in blocks),
            "selected_aggregate_clean_constraints": len(chosen["clean_portions"]) if chosen else 0,
            "discovery_tilings": len(tilings), "unique_membership_hypotheses": len(hypotheses),
            "supported_membership_hypotheses": len(accepted)},
        "endpoint_error_percent": envelope, "quality_flags": flags, "reasons": reasons,
        "quantization_only": quantization, "endpoint_error_stress": stress,
        "one_sided_rate_interval": one_sided,
        "unconditional_identification": {"upper_capacity_usd": None, "finite_upper_identified": False,
            "conditional_measurement_lower_usd": frontier_capacity_range(one_sided)["lower"]},
        "selection_rule": "lowest separate joint-rate neighborhood; strongest unique raw information within overlap",
        "near_clean_budget_scope": "each selected disjoint portion as a whole, never separately on its interior raw edges",
        "discovery_completeness": "finite time-tiling overlap and informative endpoint-disjoint subset family; not exhaustive over every feasible subset",
        "unavailable_does_not_prove_nonidentifiability": True,
        "membership_sensitivity": [{"rate_lower": n["lower"], "rate_upper": n["upper"],
            "conditional_capacity_envelope_usd": {"lower": 100/n["upper"], "upper": 100/n["lower"]},
            "hypothesis_count": len(n["members"]), "not_one_fixed_membership_interval": True} for n in neighborhoods],
        "hypotheses": [{k: h[k] for k in ("id", "status", "a_percent_per_usd", "estimated_total_api_cost_usd", "conditional_range_usd", "discovery_schemes", "reasons")} |
            {"raw_edge_count": len({bid for p in h["clean_portions"] for bid in p["atomic_block_ids"]}),
             "clean_portion_count": len(h["clean_portions"]), "support_group_count": h["support"]["group_count"]} for h in hypotheses]}


def joint_validate_frozen(training: dict, holdout: list, *, envelope: float = 1) -> dict:
    rate = training["a_percent_per_usd"]
    result = {"frozen_a_percent_per_usd": rate,
        "training_candidate_usd": training["estimated_total_api_cost_usd"],
        "applies_only_to_training_candidate": True, "candidate_refitted_on_holdout": False,
        "not_accuracy_against_true_capacity": True, "support": None, "reasons": []}
    if rate is None:
        return result | {"status": "training_frontier_unavailable"}
    if not holdout:
        return result | {"status": "no_later_evidence"}
    one = robust_rate_interval(holdout, set(), envelope, clean_portions=[])
    if not robust_rate_contains(one, rate):
        return result | {"status": "contradicted_under_endpoint_error_assumption", "one_sided_compatible": False}
    best = None
    weights = {b["id"]: b["known_api_cost_usd"] / (2 * envelope) for b in holdout}
    def failures(support):
        reasons = []
        if support["independent_support_count"] < 2:
            reasons.append("fewer_than_two_endpoint_disjoint_later_groups")
        if (support["clean_predicted_delta_percent"] or 0) < 5 - 1e-10:
            reasons.append("later_signal_below_5pp")
        if support["support_weight_fraction"] < .25:
            reasons.append("later_low_interference_support_below_25_percent")
        if support["span_seconds"] < 300:
            reasons.append("later_support_duration_too_short")
        return reasons
    for tiling in joint_discovery_tilings(holdout):
        portions = tiling["portions"]
        compatible = {p["id"] for p in portions if p["known_api_cost_usd"] > 0 and p.get("clean_budget_eligible", True)
            and robust_rate_contains(joint_portion_interval(p, envelope), rate)}
        informative = set()
        for p in portions:
            low_before, _ = robust_endpoint_error(p["before"], envelope)
            _, high_after = robust_endpoint_error(p["after"], envelope)
            if p["id"] in compatible and rate*p["known_api_cost_usd"] >= 2*envelope-1e-10 and p["delta_percent"]-(high_after-low_before)>1e-10:
                informative.add(p["id"])
        proposals = [compatible, joint_disjoint_membership(portions, informative)]
        for selected in proposals:
            clean = [p for p in portions if p["id"] in selected]
            ids = {bid for p in clean for bid in p["atomic_block_ids"]}
            interval = robust_rate_interval(holdout, ids, envelope, clean_portions=clean)
            if not robust_rate_contains(interval, rate):
                continue
            support = joint_support(portions, selected, weights, rate, envelope)
            reasons = failures(support)
            rank = (not reasons, support["covered_information_weight"], support["independent_support_count"], support["group_count"])
            if best is None or rank > best[0]:
                best = (rank, support, reasons)
    reasons = best[2] if best else ["no_jointly_compatible_later_clean_portions"]
    return result | {"status": "limited_later_recurrence" if reasons else "later_recurrence_supported",
        "support": best[1] if best else None, "reasons": reasons, "one_sided_compatible": True,
        "membership_search": "compatible full sets and informative endpoint-disjoint subsets; any passing proposal outranks failing proposals"}


def joint_union_capacity_ranges(ranges: list) -> list:
    """Union mutually exclusive feasible hypotheses. Never intersect them."""
    values = sorted(((r["lower"], r["upper"]) for r in ranges if r.get("feasible", True) and r.get("lower") is not None), key=lambda pair: (pair[0], float("inf") if pair[1] is None else pair[1]))
    merged = []
    for low, high in values:
        if not merged or (merged[-1]["upper"] is not None and low > merged[-1]["upper"]):
            merged.append({"lower": low, "upper": high})
        elif merged[-1]["upper"] is None or high is None:
            merged[-1]["upper"] = None
        else:
            merged[-1]["upper"] = max(merged[-1]["upper"], high)
    return merged


def joint_segments(roots: list, prices: dict, *, source_label: str = "selected_local_roots",
                   account_label: str = "unverified", now: Optional[datetime] = None,
                   offsets: tuple = (-60, 0, 60)) -> tuple:
    now = now or datetime.now(UTC)
    data, paths = historical_segments(roots, prices, source_label=source_label, account_label=account_label,
        now=now, offsets=offsets, _raw_graph_only=True, _source_aware_epochs=True)
    epochs = {e["quota_epoch_id"]: e for e in data["quota_epochs"]}
    exposure_intervals = defaultdict(list)
    for row in data["raw_model_scenarios"]:
        key = (row["quota_epoch_id"], tuple(row["profile"].values()))
        exposure_intervals[key].extend((timestamp(b["before"]["observed_at"]), timestamp(b["after"]["observed_at"]))
            for b in row["edges"] if b["status"] == "eligible" and b["local_event_count"] > 0)
    partitions = {key: robust_exposure_partition(intervals) for key, intervals in exposure_intervals.items()}
    scenarios, groups = [], defaultdict(list)
    for row in data["raw_model_scenarios"]:
        epoch = epochs[row["quota_epoch_id"]]
        valid = [b for b in row["edges"] if b["status"] == "eligible"]
        fit = joint_fit(valid)
        key = (row["quota_epoch_id"], tuple(row["profile"].values()))
        exposure = partitions.get(key)
        cutoff = exposure["cutoff"] if exposure else None
        training = [b for b in valid if cutoff and timestamp(b["after"]["observed_at"]) <= cutoff]
        later = [b for b in valid if cutoff and timestamp(b["before"]["observed_at"]) > cutoff]
        train_fit = joint_fit(training)
        validation = joint_validate_frozen(train_fit, later)
        full_point, old_point = fit["estimated_total_api_cost_usd"], train_fit["estimated_total_api_cost_usd"]
        shift = (full_point-old_point)/old_point if full_point and old_point else None
        if validation["status"] != "later_recurrence_supported":
            fit["quality_flags"].append(validation["status"])
        if shift is not None and abs(shift) > .25:
            fit["quality_flags"].append("substantial_change_from_earlier_training_estimate")
        if epoch.get("ambiguity_reasons") or epoch.get("continuity_assumptions"):
            fit["quality_flags"].append("conditional_epoch_interpretation")
        blocked = list(data["global_reasons"])
        if epoch["status"] == "quarantined":
            blocked.append("retired_window_return")
        if any(timestamp(b["after"]["observed_at"]) > now for b in valid):
            blocked.append("evidence_after_analysis_time")
        if blocked:
            fit["reasons"] = sorted(set(fit["reasons"] + blocked))
            fit["status"], fit["estimated_total_api_cost_usd"] = "cannot_estimate", None
            fit["conditional_range_usd"] = {"lower": None, "upper": None, "feasible": False, "not_confidence_interval": True}
        fit["quality_flags"] = sorted(set(fit["quality_flags"]))
        fit["historical_validation"] = validation
        fit["training_frontier"] = {k: train_fit[k] for k in ("status", "estimated_total_api_cost_usd", "conditional_range_usd", "evidence_counts")}
        fit["full_vs_training_point_relative_change"] = shift
        fit["confidence_label"] = "unavailable" if fit["estimated_total_api_cost_usd"] is None else "provisional_conditional"
        result = {"quota_epoch_id": row["quota_epoch_id"], "profile": row["profile"],
            "alignment_offset_seconds": row["alignment_offset_seconds"], "identity": epoch["identity"],
            "epoch_started_at": epoch["started_at"], "epoch_status": epoch["status"],
            "epoch_ambiguity_reasons": epoch.get("ambiguity_reasons", []), "frontier": fit,
            "status": fit["status"], "estimated_total_api_cost_usd": fit["estimated_total_api_cost_usd"],
            "conditional_range_usd": fit["conditional_range_usd"],
            "counts": {"attempted_raw_edges": len(row["edges"]), "admitted_raw_edges": len(valid),
                "excluded_raw_edges": len(row["edges"])-len(valid)},
            "exclusion_reasons": dict(sorted(Counter(r for b in row["edges"] for r in b["reasons"]).items())),
            "split": {"cutoff_at": cutoff.isoformat() if cutoff else None,
                "training_raw_edges": len(training), "holdout_raw_edges": len(later),
                "purged_raw_edges": len(valid)-len(training)-len(later),
                "shared_across_offsets": True, "basis": "union of eligible original target-receipt edge exposure"}}
        scenarios.append(result)
        groups[key].append(result)
    summaries = []
    for members in groups.values():
        available = [r for r in members if r["estimated_total_api_cost_usd"] is not None]
        chosen = min(available or members, key=lambda r: ({0: 0, -60: 1, 60: 2}.get(r["alignment_offset_seconds"], 3), r["alignment_offset_seconds"]))
        alternatives = [{"alignment_offset_seconds": r["alignment_offset_seconds"], "status": r["status"],
            "estimated_total_api_cost_usd": r["estimated_total_api_cost_usd"],
            "conditional_range_usd": r["conditional_range_usd"], "evidence_counts": r["frontier"]["evidence_counts"],
            "reasons": r["frontier"]["reasons"]} for r in members]
        union = joint_union_capacity_ranges([r["conditional_range_usd"] for r in available])
        points = [r["estimated_total_api_cost_usd"] for r in available]
        flags = list(chosen["frontier"]["quality_flags"])
        if len(available) < len(members):
            flags.append("some_timing_hypotheses_unavailable")
        if points and (max(points)-min(points))/(robust_median(points) or 1) > .25:
            flags.append("timing_hypothesis_sensitive")
        if chosen["alignment_offset_seconds"] != 0:
            flags.append("nominal_zero_offset_unavailable")
        summaries.append({k: chosen[k] for k in ("quota_epoch_id", "profile", "identity", "epoch_started_at", "status", "estimated_total_api_cost_usd", "conditional_range_usd", "alignment_offset_seconds")} |
            {k: chosen["frontier"][k] for k in ("quantization_only", "endpoint_error_stress", "support", "evidence_counts", "historical_validation", "full_vs_training_point_relative_change", "confidence_label")} |
            {"quality_flags": sorted(set(flags)), "offset_alternatives": alternatives,
             "offset_conditional_feasible_union_usd": union,
             "offset_union_scope": "only supported near-clean hypotheses; missing/invalid alternatives are disclosed, not proved impossible",
             "offsets_intersected": False, "selection": "nominal zero offset if supported, otherwise frozen -60,+60 priority; no largest-capacity selection",
             "finite_unconditional_upper_identified": False, "estimated_remaining_api_cost_usd": None})
    return {k: v for k, v in data.items() if k != "raw_model_scenarios"} | {
        "kind": "joint_raw_edge_quota_scenarios", "schema_version": 1, "experimental": True,
        "protocol": copy.deepcopy(JOINT_PROTOCOL), "status": "conditional_joint_estimate" if any(s["estimated_total_api_cost_usd"] is not None for s in summaries) else "cannot_estimate",
        "model_scenarios": scenarios, "model_epoch_estimates": summaries,
        "raw_profile_edges": data["raw_model_scenarios"],
        "analysis_clock_policy": "clock only, not input cutoff; genuine prefix replay requires physically truncated inputs",
        "statistical_confidence_interval": None, "limitations": JOINT_PROTOCOL["assumptions"]}, paths


def render_joint_segments(data: dict) -> str:
    lines = ["R5 joint original-reading conditional estimates (experimental)",
        "All admitted raw edges constrain one epoch/profile coefficient; selected whole-portion 5% nuisance budgets are assumed.",
        "Ranges are conditional feasibility sets, not confidence intervals or official quota. Offsets are alternatives, never intersected."]
    for row in data["model_epoch_estimates"]:
        if row["estimated_total_api_cost_usd"] is None:
            continue
        p, bounds = row["profile"], row["conditional_range_usd"]
        evidence = row["evidence_counts"]
        lines.append(f"{p['model']} / {p['mode']} / {p['effort']} / {row['epoch_started_at']}: ${row['estimated_total_api_cost_usd']:.2f}, E1 [${bounds['lower']:.2f}, ${bounds['upper']:.2f}], offset {row['alignment_offset_seconds']}s")
        lines.append(f"  {evidence['raw_edges']} original edges, {evidence['unique_raw_endpoints']} endpoints, {evidence['selected_aggregate_clean_constraints']} selected whole-portion clean budgets; {row['confidence_label']}")
        lines.append("  " + ", ".join(row["quality_flags"]))
    if not any(r["estimated_total_api_cost_usd"] is not None for r in data["model_epoch_estimates"]):
        lines.append("No supported finite conditional estimate under the declared raw-endpoint measurement assumptions.")
    lines.append("Every unselected edge remains a one-sided contamination constraint. Without near-clean anchors the capacity upper bound stays unbounded.")
    return "\n".join(safe_text(line) for line in lines)


def render_robust_segments(data: dict) -> str:
    def number(value):
        return "unknown/unbounded" if value is None else f"{value:.2f}"
    def interval(value):
        return "unavailable" if value is None else f"[${number(value.get('lower'))}, ${number(value.get('upper'))}]"
    lines = ["EXPERIMENTAL stable-frontier conditional estimates — not official quota or a confidence interval",
        "Same epoch/profile only. A repeated near-clean frontier is assumed; if every episode is contaminated, the entire frontier may be low.",
        "Primary ranges assume bounded endpoint error. Quantization-only and timing stress are separate assumptions.",
        "Historical validation labels an earlier frozen candidate; the displayed all-evidence estimate is retrospective.",
        "Each model/epoch uses the first supported predefined timing scheme, never the largest capacity. Alternatives are not additive."]
    summaries = data.get("model_epoch_estimates", [])
    for model in data["observed_models"]:
        rows = [row for row in summaries if row["profile"]["model"] == model["model"]]
        available = [row for row in rows if row["estimated_total_api_cost_usd"] is not None]
        lines.append(f"{model['model']}: {len(available)} conditional epoch/profile estimates; strict validation is reported separately")
        for row in sorted(available, key=lambda r: (r["epoch_started_at"], r["quota_epoch_id"]), reverse=True):
            support = row["support"]
            lines.append(f"  {row['epoch_started_at']} | {row['identity']['plan_type']} {row['identity']['limit_id']}/{row['identity']['window_kind']} | mode={row['profile']['mode']} effort={row['profile']['effort']}")
            lines.append(f"  CONDITIONAL frontier B=${number(row['estimated_total_api_cost_usd'])}; E1 measurement range {interval(row['conditional_range_usd'])}; {row['confidence_label']}")
            quant = row["quantization_only"]
            lines.append(f"  Quantization-only: {quant['status']} {interval(quant.get('capacity_range_usd'))}; no cache/settlement guarantee")
            lines.append(f"  E2 stress range: {interval(row['endpoint_error_stress'].get('capacity_range_usd'))}; no unconditional finite upper bound")
            lines.append(f"  Support: {support['group_count']} informative groups, {support['independent_support_count']} endpoint-disjoint, {support['covered_atomic_block_count']} unique atomic blocks, {support['span_seconds']/60:.1f} min, predicted {support['clean_predicted_delta_percent']:.2f}pp; shared endpoints solved jointly")
            validation = row["historical_validation"]
            lines.append(f"  Earlier frozen candidate ${number(validation['training_candidate_usd'])}: {validation['status']}; later signal {number(validation['support']['clean_predicted_delta_percent'])}pp; not measured accuracy")
            timing = row["timing_sensitivity"]
            lines.append(f"  Scheme {row['policy_id']} / {row['alignment_offset_seconds']:+g}s; {timing['available_schemes']}/{timing['expected_schemes']} supported timing alternatives, points ${number(timing['candidate_min'])}–${number(timing['candidate_max'])}; not independent samples")
            if row["quality_flags"]:
                lines.append("  Quality flags: " + ", ".join(row["quality_flags"]))
        if not available:
            reasons = sorted({reason for row in rows for reason in row["reasons"]}) or ["no_quota_paired_profile_evidence"]
            lines.append("  No finite supported frontier: " + ", ".join(reasons))
    for current in data["current_quota_epochs"]:
        lines.append(f"Current {current['limit_id']}/{current['window_kind']}: {current['status']}; primary remaining unknown (no independently fresh snapshot)")
    lines.append("Single-sided contamination alone leaves B's upper bound unbounded; every finite range above additionally assumes its selected atoms are near-clean.")
    return "\n".join(safe_text(line) for line in lines)


def write_segment_json_stdout(data: dict) -> None:
    # Full-history diagnostics can exceed a gigabyte. Do not allocate another
    # giant string (plus encoder fragments) before writing the first byte.
    json.dump(data, sys.stdout, ensure_ascii=False, allow_nan=False, indent=2)
    sys.stdout.write("\n")


async def run_segments(args: argparse.Namespace) -> int:
    try:
        protected = {Path(__file__).resolve()} if __file__ != "<stdin>" else set()
        if args.segment_command in ("analyze", "diagnose", "historical", "robust", "joint"):
            price_path = Path(args.price_catalog).expanduser()
            protected.add(price_path.resolve())
            with price_path.open("rb") as handle:
                catalog = parse_price_catalog(strict_json(handle.read(MAX_BYTES + 1)), str(price_path))
            if args.segment_command == "analyze":
                input_path = Path(args.input).expanduser()
                protected.add(input_path.resolve())
                data = analyze_segments(read_segment_json(input_path), catalog.prices)
            else:
                roots = [Path(path).expanduser().resolve() for path in args.root]
                if args.segment_command in ("historical", "robust", "joint"):
                    estimator = {"robust": robust_segments, "joint": joint_segments, "historical": historical_segments}[args.segment_command]
                    data, log_paths = estimator(roots, catalog.prices, source_label=args.source_label,
                                                         account_label=args.account_label)
                else:
                    data, log_paths = diagnose_segments(roots, catalog.prices)
                protected.update(log_paths)
            data["price_catalog"] = catalog_info(catalog)
        else:
            for key in ("id", "account_key", "mode", "limit_id"):
                segment_text(getattr(args, key), key)
            if args.output and args.output != "-" and Path(args.output).expanduser().exists():
                raise ValueError("Experimental output already exists; use a new filename")
            started = datetime.now(UTC)
            live, error = await fetch_live(args.codex_binary, args.timeout, _raw_result=True)
            if not live:
                raise ValueError(error or "No live quota snapshot")
            payload = live.get("result")
            pools = payload.get("rateLimitsByLimitId") if isinstance(payload, dict) else None
            raw_bucket = pools.get(args.limit_id) if isinstance(pools, dict) else None
            raw_kind = "individualLimit" if args.window == "individual_limit" else args.window
            raw_window = first(raw_bucket, raw_kind, args.window) if isinstance(raw_bucket, dict) else None
            if not isinstance(raw_window, dict):
                raise ValueError("Requested quota pool/window was not returned")
            # Validate BEFORE dashboard normalization can truncate numbers. v1
            # requires the server's integer-duration/integer-reset identity.
            minutes = first(raw_window, "windowDurationMins", "window_minutes")
            reset = first(raw_window, "resetsAt", "resets_at")
            if type(minutes) is not int or not 1 <= minutes <= 5256000 or type(reset) is not int or reset <= 0:
                raise ValueError("Live quota window/reset identity must contain positive integers")
            segment_number(first(raw_window, "usedPercent", "used_percent"), "used_percent", 0, 100)
            for key in ("limitId", "limit_id"):
                if key in raw_bucket and raw_bucket[key] != args.limit_id:
                    raise ValueError("Returned quota pool identity does not match the requested pool")
            bucket = normalize_bucket(raw_bucket, args.limit_id)
            if bucket["limit_id"] != args.limit_id:
                raise ValueError("Returned quota pool identity does not match the requested pool")
            plan = bucket.get("plan_type")
            if not isinstance(plan, str) or not plan:
                raise ValueError("Live quota does not identify the plan; cannot record this experiment")
            window = bucket[args.window]
            data = {"id": args.id, "context": {"account_key": args.account_key, "plan_type": plan,
                    "limit_id": args.limit_id, "window_kind": args.window, "mode": args.mode},
                    "capture_started_at": started.isoformat(), "observed_at": live["fetched_at"],
                    "window_minutes": window["window_minutes"], "resets_at": window["resets_at_utc"],
                    "used_percent": window["used_percent"], "percent_resolution": 1,
                    "source": "app_server_rpc", "observation_basis": "retrieved_not_measured"}
            segment_snapshot(data)
        if args.output and args.output != "-":
            output = Path(args.output).expanduser()
            if output.exists():
                raise ValueError("Experimental output already exists; use a new filename")
            write_json(output, data, protected)
        if args.segment_command == "snapshot" or args.json or args.output == "-":
            write_segment_json_stdout(data)
        else:
            if args.segment_command == "joint":
                print(render_joint_segments(data))
            elif args.segment_command == "robust":
                print(render_robust_segments(data))
            elif args.segment_command == "historical":
                print(render_historical_segments(data))
            else:
                print(render_segment_diagnostics(data) if args.segment_command == "diagnose" else render_segments(data))
        return 0
    except (OSError, ValueError, OverflowError) as exc:
        print(f"oai-usage segments: {safe_text(str(exc))}", file=sys.stderr)
        return 1


def positive(value: str) -> float:
    number = finite(value)
    if number is None or number <= 0 or number > 86400:
        raise argparse.ArgumentTypeError("Enter a finite number greater than 0 and at most 86400")
    return number


def days_value(value: str) -> int:
    if value.lower() == "all":
        return 0
    try:
        number = int(value)
        if not 0 <= number <= 365000:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError("Enter a nonnegative number of days, or all")


def parse_args(argv: Optional[list] = None) -> argparse.Namespace:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] not in ("report", "watch", "prices", "segments", "-h", "--help", "--version"):
        args.insert(0, "report")
    parser = argparse.ArgumentParser(prog="oai-usage", description="Local Codex usage, API-equivalent costs, and account quotas",
        allow_abbrev=False,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  oai-usage                         Current account cycle (30-day fallback)
  oai-usage --today                  Today in the selected timezone
  oai-usage watch                    Live dashboard; Ctrl+C to quit
  oai-usage --days all --by session  All session details
  oai-usage --by day --output report.json
  oai-usage --quota off --json       JSON report without quota lookup
  oai-usage report --help            All filter, pricing, and quota options""")
    parser.add_argument("--version", action="version", version=f"oai-usage {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)
    for name, help_text in (("report", "Usage report (default)"), ("watch", "Continuously refresh usage")):
        p = sub.add_parser(name, help=help_text, description=help_text, allow_abbrev=False)
        dates = p.add_mutually_exclusive_group()
        dates.add_argument("--days", type=days_value, default=None, metavar="N|all", help="Last N x 24 hours; all for all history (default: current cycle, or 30 days if unavailable)")
        dates.add_argument("--today", action="store_true", help="Today in the selected timezone")
        dates.add_argument("--since", metavar="YYYY-MM-DD", help="Inclusive start date")
        p.add_argument("--until", metavar="YYYY-MM-DD", help="Inclusive end date")
        p.add_argument("--timezone", default="local", metavar="ZONE", help="Calendar timezone, e.g. UTC or America/New_York (default: system timezone)")
        p.add_argument("--by", choices=("model", "day", "week", "month", "session"), default="model", help="Grouping (default: model)")
        p.add_argument("--all", dest="all_dimensions", action="store_true", help="Show model, day, and session details together")
        p.add_argument("--top", type=int, default=15, help="Show N entries; 0 for all. JSON is never truncated (default: 15)")
        p.add_argument("--root", action="append", help="Replace default log directories; repeatable. Defaults use CODEX_HOME or ~/.codex")
        p.add_argument("--quota", choices=("auto", "live", "logs", "off"), default="auto", help="Quota source (default: live with log fallback)")
        p.add_argument("--limit", dest="limit_id", help="Select a quota bucket ID (default: prefer codex)")
        p.add_argument("--no-project", dest="project", action="store_false", help="Hide the current-cycle section in terminal output")
        p.add_argument("--codex-binary", help="Path to the Codex executable")
        p.add_argument("--timeout", type=positive, default=10, help="Live quota timeout in seconds (default: 10)")
        p.add_argument("--price", action="append", default=[], metavar="MODEL=IN,CACHED,OUT[,WRITE]", help="Custom USD rates per million tokens")
        p.add_argument("--json", action="store_true", help="Only print JSON to stdout; watch emits one JSON document per line")
        p.add_argument("--output", help="Atomically save the full JSON report; - for stdout")
        color = p.add_mutually_exclusive_group()
        color.add_argument("--no-color", action="store_true", help="Disable colors")
        color.add_argument("--color", action="store_true", help="Enable title colors")
        p.add_argument("--refresh", type=positive, default=2, help="Watch refresh interval in seconds (default: 2)")
        p.add_argument("--quota-interval", type=positive, default=30, help="Watch live quota polling interval in seconds (default: 30)")
        p.add_argument("--count", type=int, default=0, help="Exit watch after N refreshes; 0 to keep running")
    p = sub.add_parser("prices", help="Show current prices and data sources", allow_abbrev=False)
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("segments", help="Opt-in experimental segmented quota analysis", allow_abbrev=False)
    commands = p.add_subparsers(dest="segment_command", required=True)
    p = commands.add_parser("analyze", help="Offline explicit snapshot/receipt manifest; no log scanning or network", allow_abbrev=False)
    p.add_argument("--input", required=True, help="Experimental manifest JSON (schema_version 1 or per-model schema_version 2)")
    p.add_argument("--price-catalog", required=True, help="Explicit local prices.json; never downloaded")
    p.add_argument("--json", action="store_true")
    p.add_argument("--output", help="Save JSON to a new file, or - for stdout")
    p = commands.add_parser("diagnose", help="Existing-log candidate diagnostics; never certifies cached quota", allow_abbrev=False)
    p.add_argument("--root", action="append", required=True, help="Explicit local log directory; repeat for archived logs (no defaults)")
    p.add_argument("--price-catalog", required=True, help="Explicit local prices.json; never downloaded")
    p.add_argument("--json", action="store_true")
    p.add_argument("--output", help="Save all diagnostic candidates to a new JSON file, or - for stdout")
    p = commands.add_parser("historical", help="Offline low-trust historical estimates with all timing/alignment sensitivities", allow_abbrev=False)
    p.add_argument("--root", action="append", required=True, help="Explicit local log directory; repeatable, no defaults")
    p.add_argument("--price-catalog", required=True, help="Explicit local prices.json; never downloaded")
    p.add_argument("--source-label", default="selected_local_roots", help="Opaque local source label; does not verify account identity")
    p.add_argument("--account-label", default="unverified", help="Optional local account label; no identity or activity attestation")
    p.add_argument("--json", action="store_true")
    p.add_argument("--output", help="Save all historical scenarios and attempts to a new JSON file, or - for stdout")
    p = commands.add_parser("robust", help="Offline conditional robust contamination model with chronological holdout", allow_abbrev=False)
    p.add_argument("--root", action="append", required=True, help="Explicit local log directory; repeatable, no defaults")
    p.add_argument("--price-catalog", required=True, help="Explicit local prices.json; never downloaded")
    p.add_argument("--source-label", default="selected_local_roots")
    p.add_argument("--account-label", default="unverified")
    p.add_argument("--json", action="store_true")
    p.add_argument("--output", help="Save every block, candidate and validation result to a new JSON file, or - for stdout")
    p = commands.add_parser("joint", help="R5 offline joint original-reading constraints with aggregate near-clean portions", allow_abbrev=False)
    p.add_argument("--root", action="append", required=True, help="Explicit local log directory; repeatable, no defaults")
    p.add_argument("--price-catalog", required=True, help="Explicit local prices.json; never downloaded")
    p.add_argument("--source-label", default="selected_local_roots")
    p.add_argument("--account-label", default="unverified")
    p.add_argument("--json", action="store_true")
    p.add_argument("--output", help="Save original-edge constraints and alternative hypotheses to a new JSON file, or -")
    p = commands.add_parser("snapshot", help="One explicit quota RPC; receipt time is not measurement time", allow_abbrev=False)
    p.add_argument("--id", required=True, help="Unique observation ID to reference in a manifest")
    p.add_argument("--account-key", required=True, help="Local opaque account label; not verified and not sent to Codex")
    p.add_argument("--mode", required=True, help="Declared workload mode, e.g. standard; not verified by quota RPC")
    p.add_argument("--limit", dest="limit_id", default="codex")
    p.add_argument("--window", choices=("primary", "secondary", "individual_limit"), default="secondary")
    p.add_argument("--codex-binary")
    p.add_argument("--timeout", type=positive, default=10)
    p.add_argument("--output", help="Save the snapshot to a new JSON file; always print JSON")
    parsed = parser.parse_args(args)
    if parsed.command not in ("prices", "segments"):
        try:
            if parsed.top < 0 or parsed.count < 0:
                raise ValueError("--top and --count must be nonnegative")
            if parsed.today and parsed.until:
                raise ValueError("--today cannot be combined with --until")
            calendar = Calendar.make(parsed.timezone)
            bounds(parsed, calendar, datetime.now(UTC))
            price_overrides(parsed.price, {})
        except ZoneInfoNotFoundError:
            parser.error(f"Time zone data unavailable for {parsed.timezone!r}; check the zone name or install "
                         "tzdata with 'python -m pip install tzdata'. Use --timezone local or UTC without extra data.")
        except (ValueError, OverflowError) as exc:
            parser.error(f"Invalid date, timezone, or price option: {exc}")
    return parsed


async def async_main(argv: Optional[list] = None) -> int:
    args = parse_args(argv)
    if args.command == "segments":
        return await run_segments(args)
    scheduler = QueryScheduler(args)
    try:
        return await run_command(args, scheduler)
    finally:
        await scheduler.stop()


async def run_command(args: argparse.Namespace, scheduler: QueryScheduler) -> int:
    try:
        await scheduler.start()
    except (OSError, ValueError) as exc:
        print(f"oai-usage: {exc}", file=sys.stderr)
        return 1
    price_catalog, live = scheduler.snapshot()
    if args.command == "prices":
        rows = [{"model": model, "input": str(p.input), "cached": str(p.cached) if p.cached is not None else None, "output": str(p.output),
                 "cache_write": str(p.write) if p.write is not None else None, "source": p.source,
                 "long_context_threshold": p.long_threshold,
                 "long_input": str(p.long_input) if p.long_input is not None else None,
                 "long_cached_input": str(p.long_cached) if p.long_cached is not None else None,
                 "long_cache_write": str(p.long_write) if p.long_write is not None else None,
                 "long_output": str(p.long_output) if p.long_output is not None else None}
                for model, p in price_catalog.prices.items()]
        if args.json:
            print(json.dumps({**catalog_info(price_catalog), "prices": rows}, ensure_ascii=False, indent=2))
        else:
            print(f"API-equivalent prices · USD / 1M tokens · Source checked {price_catalog.verified_at} · {price_catalog.origin}")
            print("\n".join(table(["Model", "Input", "Cached", "Output", "Write"],
                [[r['model'], r['input'], r['cached'] if r['cached'] is not None else '-', r['output'], r['cache_write'] or '-'] for r in rows])))
            for warning in catalog_info(price_catalog)["warnings"]:
                print("Warning: " + warning)
            print("\nLong-context prices apply above each model's listed input-token threshold.")
            for r in rows:
                rule = (f" · >{r['long_context_threshold']:,} per request: "
                        f"input {r['long_input']}, cached {r['long_cached_input'] or '-'}, "
                        f"write {r['long_cache_write'] or '-'}, output {r['long_output']}") if r['long_context_threshold'] else ""
                print(f"{r['model']}{rule}: {r['source']}")
        return 0
    calendar = Calendar.make(args.timezone)
    codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    roots = [Path(r).expanduser().resolve() for r in args.root] if args.root else [codex_home / "sessions", codex_home / "archived_sessions"]
    json_stdout = args.json or args.output == "-"
    ansi, restore_ansi = terminal_ansi() if not json_stdout else (False, None)
    tty_watch = args.command == "watch" and sys.stdout.isatty() and not json_stdout and ansi
    colors = ansi and not args.no_color and "NO_COLOR" not in os.environ and (args.color or sys.stdout.isatty())
    scanner = Scanner()
    cache = ReportCache()
    screen_started = False
    scrollback = False
    try:
        count = 0
        while True:
            tick = time.monotonic()
            price_catalog, live = scheduler.snapshot()
            prices = price_overrides(args.price, price_catalog.prices)
            data = report(args, scanner, prices, calendar, roots, cache, price_catalog, live)
            if args.output and args.output != "-":
                protected = set(scanner.cache)
                if __file__ != "<stdin>":
                    protected.add(Path(__file__).resolve())
                write_json(Path(args.output), data, protected)
            if json_stdout:
                print(json.dumps(data, ensure_ascii=False, allow_nan=False,
                                 indent=None if args.command == "watch" else 2), flush=True)
            else:
                size = shutil.get_terminal_size((120, 40))
                body = render(data, args, calendar, size.columns)
                lines = [fit(line, size.columns) for line in body.splitlines()]
                if tty_watch and not scrollback and len(lines) > max(1, size.lines - 3):
                    scrollback = True
                    if screen_started:
                        sys.stdout.write("\033[?1049l\033[?25h")
                        screen_started = False
                    print("\n".join(wrap_cells(
                        "Full report exceeds terminal height; watch uses scrollback. "
                        "Scroll to view both periods and totals; Ctrl+C to stop.", size.columns)))
                footer = fit(f"Refresh {args.refresh:g}s · {datetime.now().strftime('%H:%M:%S')} · Ctrl+C to quit", size.columns)
                if tty_watch and not scrollback:
                    if not screen_started:
                        sys.stdout.write("\033[?1049h\033[?25l")
                        screen_started = True
                    if colors:
                        lines = [style_line(line) for line in lines]
                    sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n\n" + footer)
                    sys.stdout.flush()
                else:
                    print("\n".join(style_line(line) for line in lines) if colors else body, flush=True)
                    if tty_watch:
                        print(footer + "\n", flush=True)
                    if args.output:
                        print(f"\nJSON saved: {args.output}")
            count += 1
            if args.command != "watch" or (args.count and count >= args.count):
                return 0 if data["diagnostics"]["files"] else 1
            await asyncio.sleep(max(.05, args.refresh - (time.monotonic() - tick)))
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        # Avoid a second BrokenPipeError when Python flushes stdout during shutdown.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except (OSError, AttributeError):
            pass
        return 0
    except (OSError, ValueError, OverflowError) as exc:
        print(f"oai-usage: {exc}", file=sys.stderr)
        return 1
    finally:
        try:
            if screen_started:
                sys.stdout.write("\033[?1049l\033[?25h")
                sys.stdout.flush()
        finally:
            if restore_ansi:
                restore_ansi()


def main(argv: Optional[list] = None) -> int:
    try:
        return asyncio.run(async_main(argv))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
