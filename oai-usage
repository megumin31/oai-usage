def account(rollouts: list) -> tuple:
    """Union overlapping snapshots BEFORE differencing cumulative counters."""
    grouped = defaultdict(list)
    issues = Counter()
    for rollout in rollouts:
        grouped[rollout.session_id].append(rollout)
        issues.update(rollout.issues)
    sessions = []
    for sid, files in sorted(grouped.items()):
        created = [r.created_at for r in files if r.created_at]
        session = Session(sid, next((r.parent_id for r in files if r.parent_id), None),
                          min(created) if created else None, sorted(str(r.path) for r in files))
        unique = {}
        request_conflicts = set()
        model_conflicts = set()
        snapshots = []
        for r in files:
            first_own = True
            for sequence, snap in enumerate(r.snapshots):
                segment_start = r.created_at if first_own and not snap.inherited else None
                if not snap.inherited:
                    first_own = False
                if snap.at is None:
                    # No timestamp: equal counters can legitimately occur after a reset.
                    snapshots.append((str(r.path), sequence, snap, segment_start))
                    continue
                key = (snap.at, snap.cumulative)
                old = unique.get(key)
                if old is not None:
                    issues["duplicate_snapshots_removed"] += 1
                    prior = old[2]
                    last = prior.last or snap.last
                    if prior.last is not None and snap.last is not None and prior.last != snap.last:
                        request_conflicts.add(key)
                        issues["conflicting_request_metadata"] += 1
                    if key in request_conflicts:
                        last = None
                    model = snap.model if prior.model == "unknown" else prior.model
                    if prior.model != "unknown" and snap.model != "unknown" and canonical_model(prior.model) != canonical_model(snap.model):
                        model_conflicts.add(key)
                        issues["conflicting_model_metadata"] += 1
                    if key in model_conflicts:
                        model = "unknown"
                    merged = replace(prior, model=model, last=last,
                                     context_window=max(prior.context_window, snap.context_window),
                                     inherited=prior.inherited and snap.inherited)
                    starts = [v for v in (old[3], segment_start) if v is not None]
                    unique[key] = (old[0], old[1], merged, min(starts) if starts else None)
                else:
                    unique[key] = (str(r.path), sequence, snap, segment_start)
        snapshots.extend(unique.values())
        snapshots.sort(key=lambda item: (item[2].at or datetime.max.replace(tzinfo=UTC), item[0], item[1]))
        previous = None
        previous_at = None
        own_seen = False
        pending_reset = False
        for _, _, snap, segment_start in snapshots:
            cur = snap.cumulative
            # A positive reset requires a new rollout's creation boundary after
            # the previous event AND a fresh single-request cumulative baseline.
            new_segment = bool(segment_start and snap.at and previous_at and
                               previous_at < segment_start <= snap.at and snap.last == cur)
            reset = bool(previous is not None and (
                cur.total_tokens < previous.total_tokens or cur.input_tokens < previous.input_tokens or
                cur.output_tokens < previous.output_tokens or new_segment
            ))
            delta = cur if previous is None or reset else cur.difference(previous)
            if previous is not None and not reset and any(
                getattr(cur, k) < getattr(previous, k) for k in FIELDS
            ):
                issues["counter_component_corrections"] += 1
            if not snap.inherited and not own_seen and session.parent_id and previous is None:
                # A fork may retain the parent's cumulative baseline without replaying
                # the parent's token events. Only the child's last request is attributable.
                if snap.last and snap.last.total_tokens <= cur.total_tokens:
                    delta = snap.last
                    if cur.total_tokens > delta.total_tokens:
                        issues["inherited_baseline_tokens_excluded"] += cur.total_tokens - delta.total_tokens
                elif cur.total_tokens:
                    issues["unattributed_fork_baseline_tokens"] += cur.total_tokens
                    delta = Usage()
            previous = cur  # Zero is a real snapshot, including a counter reset.
            previous_at = snap.at
            if snap.inherited:
                issues["inherited_snapshots_excluded"] += 1
                continue
            own_seen = True
            pending_reset = pending_reset or reset
            if snap.context_window:
                session.context_windows.add(snap.context_window)
            if not delta.total_tokens:
                continue
            request_input = None
            if snap.last and (snap.last.input_tokens, snap.last.output_tokens) == (delta.input_tokens, delta.output_tokens):
                request_input = snap.last.input_tokens
            elif snap.last and snap.last.total_tokens > delta.total_tokens:
                issues["request_detail_exceeds_delta"] += 1
            elif snap.last is None:
                # A cumulative delta can contain multiple requests. For <= threshold,
                # none can individually exceed that threshold; larger deltas are unknown.
                issues["events_without_request_detail"] += 1
            session.events.append(Event(sid, snap.at, snap.model, delta, request_input, pending_reset))
            pending_reset = False
        if session.events:
            sessions.append(session)
    return sessions, issues


def canonical_model(model: str) -> str:
    name = model.strip().lower().replace("_", "-")
    name = re.sub(r"^gpt(?=\d)", "gpt-", name)
    name = re.sub(r"-(?:preview|latest|\d{4}-\d{2}-\d{2}|\d{8})$", "", name)
    return "gpt-6-astra" if name in ("astra", "gpt-astra") else name


@dataclass(frozen=True)
class Price:
    input: Decimal
    cached: Decimal
    output: Decimal
    write: Optional[Decimal] = None
    long_threshold: Optional[int] = None
    long_scope: str = "request"
    source: str = "custom"
    long_input: Optional[Decimal] = None
    long_cached: Optional[Decimal] = None
    long_write: Optional[Decimal] = None
    long_output: Optional[Decimal] = None


@dataclass(frozen=True)
class PriceCatalog:
    prices: dict
    verified_at: str
    origin: str


def price_cache_path() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser()
    return base / "oai-usage" / "prices.json"


def parse_price_catalog(raw: Any, origin: str) -> PriceCatalog:
    if not isinstance(raw, dict) or raw.get("schema_version") != 1 or raw.get("basis") != "standard_api_equivalent":
        raise ValueError("Invalid price catalog schema or basis")
    verified_at = raw.get("verified_at")
    try:
        if not isinstance(verified_at, str) or date.fromisoformat(verified_at).isoformat() != verified_at:
            raise ValueError()
    except ValueError:
        raise ValueError("Invalid price catalog verification date")
    models = raw.get("models")
    if not isinstance(models, dict) or not 1 <= len(models) <= 200:
        raise ValueError("Invalid price catalog models")

    def amount(value: Any, optional: bool = False) -> Optional[Decimal]:
        if optional and value is None:
            return None
        if not isinstance(value, str):
            raise ValueError("Invalid price catalog rate")
        try:
            number = Decimal(value)
        except InvalidOperation:
            raise ValueError("Invalid price catalog rate")
        if not number.is_finite() or not 0 <= number <= Decimal("1e9"):
            raise ValueError("Invalid price catalog rate")
        return number

    prices = {}
    for model, row in models.items():
        if (not isinstance(model, str) or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,79}", model)
                or model != canonical_model(model) or not isinstance(row, dict)):
            raise ValueError("Invalid price catalog model")
        source = row.get("source")
        if not isinstance(source, str) or not re.fullmatch(
                r"https://developers\.openai\.com/api/docs/(?:pricing|models/[a-z0-9][a-z0-9._-]*)", source):
            raise ValueError("Invalid price catalog source")
        long = row.get("long_context")
        if long is None:
            threshold, scope = None, "request"
        elif isinstance(long, dict):
            threshold, scope = long.get("threshold"), long.get("scope")
            if isinstance(threshold, bool) or not isinstance(threshold, int) or not 0 < threshold <= 10_000_000 or scope not in ("request", "session"):
                raise ValueError("Invalid price catalog long-context rule")
            for key in ("input", "cached_input", "output"):
                if key not in long:
                    raise ValueError("Incomplete price catalog long-context rates")
        else:
            raise ValueError("Invalid price catalog long-context rule")
        base_write = amount(row.get("cache_write"), True)
        long_write = amount(long.get("cache_write"), True) if long is not None else None
        if long is not None and (base_write is None) != (long_write is None):
            raise ValueError("Inconsistent price catalog cache-write rates")
        prices[model] = Price(amount(row.get("input")), amount(row.get("cached_input")),
                              amount(row.get("output")), base_write, threshold, scope, source,
                              amount(long.get("input")) if long is not None else None,
                              amount(long.get("cached_input")) if long is not None else None,
                              long_write, amount(long.get("output")) if long is not None else None)
    return PriceCatalog(prices, verified_at, origin)


def read_price_catalog(path: Path, origin: str) -> PriceCatalog:
    return parse_price_catalog(json.loads(path.read_text(encoding="utf-8")), origin)


def default_prices() -> dict:
    return read_price_catalog(PRICE_FILE, "bundled").prices


def cache_price_catalog(data: bytes) -> None:
    path = price_cache_path()
    if path.exists() and path.read_bytes() == data:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".prices-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def load_price_catalog(offline: bool = False) -> PriceCatalog:
    offline = offline or os.environ.get("OAI_USAGE_OFFLINE_PRICES") == "1"
    available = []
    for path, origin in ((price_cache_path(), "cache"), (PRICE_FILE, "bundled")):
        try:
            available.append(read_price_catalog(path, origin))
        except (OSError, ValueError, UnicodeError):
            continue
    fallback = max(available, key=lambda catalog: catalog.verified_at) if available else None
    if not offline:
        try:
            request = urllib.request.Request(PRICE_URL, headers={"User-Agent": "oai-usage/0.0.1"})
            with urllib.request.urlopen(request, timeout=4) as response:
                data = response.read(1_000_001)
            if len(data) > 1_000_000:
                raise ValueError("Remote price catalog is too large")
            catalog = parse_price_catalog(json.loads(data.decode("utf-8")), "github")
            if fallback is None or catalog.verified_at >= fallback.verified_at:
                try:
                    cache_price_catalog(data)
                except OSError:
                    pass  # A read-only cache must not discard valid remote prices.
                return catalog
        except (OSError, ValueError, UnicodeError):
            pass
    if fallback is not None:
        return fallback
    raise ValueError("No valid price catalog is available from GitHub, cache, or bundled prices.json")


def price_overrides(values: list, base: Optional[dict] = None) -> dict:
    original = dict(default_prices() if base is None else base)
    prices = dict(original)
    def scaled(new: Optional[Decimal], previous: Optional[Decimal], prior_long: Optional[Decimal]) -> Optional[Decimal]:
        if new is None or previous is None or prior_long is None:
            return None
        return new * prior_long / previous if previous else Decimal(0)
    for spec in values:
        try:
            model, rates = spec.split("=", 1)
            model = canonical_model(model)
            numbers = [Decimal(v.strip()) for v in rates.split(",")]
            if not model or len(numbers) not in (3, 4) or any(not n.is_finite() or n < 0 or n > Decimal("1e9") for n in numbers):
                raise ValueError()
        except (ValueError, InvalidOperation):
            raise ValueError(f"Invalid price {spec!r}; use MODEL=IN,CACHED,OUT[,WRITE] with finite, nonnegative rates")
        old = prices.get(model)
        reference = original.get(model) or old
        write = numbers[3] if len(numbers) == 4 else (
            scaled(numbers[0], reference.input, reference.write) if reference else None)
        prices[model] = Price(*numbers[:3], write, old.long_threshold if old else None,
                              old.long_scope if old else "request", "custom",
                              scaled(numbers[0], reference.input, reference.long_input) if reference else None,
                              scaled(numbers[1], reference.cached, reference.long_cached) if reference else None,
                              scaled(write, reference.write, reference.long_write) if reference else None,
                              scaled(numbers[2], reference.output, reference.long_output) if reference else None)
    return prices


@dataclass(frozen=True)
class Charge:
    amount: Decimal = Decimal(0)
    complete: bool = True
    reasons: tuple = ()


def charge(event: Event, prices: dict, session_long: bool = False) -> Charge:
    price = prices.get(canonical_model(event.model))
    if price is None:
        return Charge(complete=False, reasons=("unknown_model",))
    usage = event.usage
    reasons = []
    long = session_long or bool(price.long_threshold and event.request_input is not None and event.request_input > price.long_threshold)
    if price.long_threshold and event.request_input is None and usage.input_tokens > price.long_threshold and not long:
        reasons.append("unknown_request_size")
    input_rate = price.long_input if long else price.input
    cached_rate = price.long_cached if long else price.cached
    write_rate = price.long_write if long else price.write
    output_rate = price.long_output if long else price.output
    if usage.cache_write_input_tokens and write_rate is None:
        reasons.append("unknown_cache_write_price")
    input_cost = usage.uncached * input_rate + usage.cached_input_tokens * cached_rate
    if write_rate is not None:
        input_cost += usage.cache_write_input_tokens * write_rate
    amount = (input_cost + usage.output_tokens * output_rate) / 1000000
    return Charge(amount, not reasons, tuple(reasons))


@dataclass
class Bucket:
    usage: Usage = field(default_factory=Usage)
    amount: Decimal = Decimal(0)
    unpriced: Usage = field(default_factory=Usage)
    uncertain: Usage = field(default_factory=Usage)
    unknown_models: set = field(default_factory=set)
    reasons: Counter = field(default_factory=Counter)
    sessions: set = field(default_factory=set)
    events: int = 0
    resets: int = 0

    def add(self, event: Event, cost: Charge) -> None:
        self.usage += event.usage
        self.amount += cost.amount
        self.events += 1
        self.resets += int(event.reset)
        self.sessions.add(event.session_id)
        if "unknown_model" in cost.reasons:
            self.unpriced += event.usage
            self.unknown_models.add(event.model)
        elif not cost.complete:
            self.uncertain += event.usage
        self.reasons.update(cost.reasons)

    def export(self) -> dict:
        amount = float(round(self.amount, 8))
        return {"usage": asdict(self.usage), "known_api_cost_usd": amount,
                "api_cost_usd": None if self.reasons else amount,
                "estimate_is_partial": bool(self.reasons), "unpriced_usage": asdict(self.unpriced),
                "uncertain_pricing_usage": asdict(self.uncertain), "unpriced_models": sorted(self.unknown_models),
                "pricing_issues": dict(self.reasons), "sessions": len(self.sessions),
                "token_events": self.events, "counter_resets": self.resets,
                "ratios": {"cached_input_of_input": self.usage.cached_input_tokens / self.usage.input_tokens if self.usage.input_tokens else None}}


def group_day(day: str, by: str) -> str:
    if day == "unknown" or by == "day":
        return day
    parsed = date.fromisoformat(day)
    return day[:7] if by == "month" else (parsed - timedelta(days=parsed.weekday())).isoformat()


def included(at: Optional[datetime], start: Optional[datetime], end: Optional[datetime]) -> bool:
    if at is None:
        return start is None and end is None
    return (start is None or at >= start) and (end is None or at < end)


def priced_events(sessions: list, prices: dict) -> list:
    rows = []
    for session in sessions:
        long_models = set()
        uncertain_models = set()
        for event in session.events:
            model = canonical_model(event.model)
            price = prices.get(model)
            if not price or price.long_scope != "session" or not price.long_threshold:
                continue
            if event.request_input is not None and event.request_input > price.long_threshold:
                long_models.add(model)
            elif event.request_input is None and event.usage.input_tokens > price.long_threshold:
                uncertain_models.add(model)
        for event in session.events:
            model = canonical_model(event.model)
            cost = charge(event, prices, model in long_models)
            if model in uncertain_models and model not in long_models:
                cost = replace(cost, complete=False, reasons=tuple(sorted(set(cost.reasons) | {"unknown_session_context"})))
            rows.append((event, cost))
    return rows


def aggregate(rows: list, sessions: list, calendar: Calendar, start: Optional[datetime], end: Optional[datetime], by: str) -> dict:
    total = Bucket()
    models, days, groups, session_buckets = (defaultdict(Bucket) for _ in range(4))
    bounds = {}
    undated = 0
    for event, cost in rows:
        if not included(event.at, start, end):
            undated += int(event.at is None)
            continue
        day = calendar.day(event.at)
        total.add(event, cost)
        models[event.model].add(event, cost)
        days[day].add(event, cost)
        session_buckets[event.session_id].add(event, cost)
        if by in ("day", "week", "month"):
            groups[group_day(day, by)].add(event, cost)
        if event.at:
            old = bounds.setdefault(event.session_id, [event.at, event.at])
            old[0], old[1] = min(old[0], event.at), max(old[1], event.at)
    details = []
    for session in sessions:
        if session.session_id not in session_buckets:
            continue
        times = bounds.get(session.session_id, [None, None])
        details.append({**session_buckets[session.session_id].export(), "session_id": session.session_id,
                        "parent_session_id": session.parent_id, "source_files": session.paths,
                        "created_at": session.created_at.isoformat() if session.created_at else None,
                        "started_at": times[0].isoformat() if times[0] else None,
                        "ended_at": times[1].isoformat() if times[1] else None,
                        "context_windows": sorted(session.context_windows)})
    return {**total.export(), "by_model": {k: asdict(v.usage) for k, v in sorted(models.items())},
            "by_model_detail": {k: v.export() for k, v in sorted(models.items())},
            "by_day": {k: v.export() for k, v in sorted(days.items())}, "by_session": details,
            "group_by": by, "groups": {k: v.export() for k, v in sorted(groups.items())},
            "undated_events_excluded": undated}


def normalize_window(raw: Any) -> Optional[dict]:
    if not isinstance(raw, dict):
        return None
    used = finite(first(raw, "usedPercent", "used_percent"))
    minutes = finite(first(raw, "windowDurationMins", "window_minutes"))
    reset = finite(first(raw, "resetsAt", "resets_at"))
    try:
        reset_dt = datetime.fromtimestamp(reset, UTC) if reset is not None and reset > 0 else None
    except (OverflowError, OSError, ValueError):
        reset_dt = None
    if used is None and minutes is None and reset_dt is None:
        return None
    return {"used_percent": used, "remaining_percent": max(0, min(100, 100 - used)) if used is not None else None,
            "window_minutes": int(minutes) if minutes is not None and 0 < minutes <= 5256000 else None,
            "resets_at": int(reset_dt.timestamp()) if reset_dt else None,
            "resets_at_utc": reset_dt.isoformat() if reset_dt else None}


def normalize_bucket(raw: Any, default_id: str = "unknown") -> Optional[dict]:
    if not isinstance(raw, dict):
        return None
    bid = first(raw, "limitId", "limit_id") or default_id
    if not isinstance(bid, str):
        bid = default_id
    credits_raw = raw.get("credits")
    credits = None
    if isinstance(credits_raw, dict):
        balance = credits_raw.get("balance")
        credits = {"has_credits": first(credits_raw, "hasCredits", "has_credits"),
                   "unlimited": credits_raw.get("unlimited"),
                   "balance": str(balance) if balance is not None else None}
    return {"limit_id": bid, "limit_name": first(raw, "limitName", "limit_name"),
            "plan_type": first(raw, "planType", "plan_type"),
            "credits": credits,
            "primary": normalize_window(raw.get("primary")),
            "secondary": normalize_window(raw.get("secondary")),
            "individual_limit": normalize_window(first(raw, "individualLimit", "individual_limit"))}


def normalize_live(raw: Any, now: datetime) -> Optional[dict]:
    if not isinstance(raw, dict):
        return None
    buckets = {}
    by_id = first(raw, "rateLimitsByLimitId", "rate_limits_by_limit_id")
    if isinstance(by_id, dict):
        for key, value in by_id.items():
            bucket = normalize_bucket(value, str(key))
            if bucket:
                buckets[bucket["limit_id"]] = bucket
    single = normalize_bucket(first(raw, "rateLimits", "rate_limits"), "codex")
    if single:
        buckets.setdefault(single["limit_id"], single)
    if not buckets:
        return None
    reset = first(raw, "rateLimitResetCredits", "rate_limit_reset_credits")
    credits = finite(first(reset, "availableCount", "available_count")) if isinstance(reset, dict) else None
    return {"source": "app_server", "fetched_at": now.isoformat(), "limits": buckets,
            "rate_limit_reset_credits": {"available_count": int(credits)} if credits is not None else None}


def find_codex(explicit: Optional[str] = None) -> Optional[str]:
    candidates = [explicit] if explicit else [os.environ.get("CODEX_CLI_PATH"), shutil.which("codex"),
        "/Applications/Codex.app/Contents/Resources/codex", "/Applications/ChatGPT.app/Contents/Resources/codex"]
    for candidate in candidates:
        if candidate:
            path = Path(candidate).expanduser()
            if path.is_file() and os.access(path, os.X_OK):
                return str(path)
    return None


def fetch_live(binary: Optional[str], timeout: float, cancel: Optional[threading.Event] = None) -> tuple:
    """One bounded, cancellable JSON-RPC request. Never changes quota/credits."""
    executable = find_codex(binary)
    if not executable:
        return None, "Codex not found; specify --codex-binary or use --quota logs"
    process = None
    selector = selectors.DefaultSelector()
    deadline = time.monotonic() + timeout
    buffer = bytearray()
    try:
        process = subprocess.Popen([executable, "app-server", "--listen", "stdio://"],
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   bufsize=0)
        selector.register(process.stdout, selectors.EVENT_READ)

        def send(method: str, params: dict, request_id: Optional[int] = None) -> None:
            message = {"method": method, "params": params}
            if request_id is not None:
                message["id"] = request_id
            process.stdin.write((json.dumps(message) + "\n").encode())
            process.stdin.flush()

        def receive(request_id: int) -> dict:
            while True:
                if cancel and cancel.is_set():
                    raise InterruptedError("Query cancelled")
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError(f"Quota query exceeded {timeout:g} seconds")
                while b"\n" in buffer:
                    line, _, rest = buffer.partition(b"\n")
                    buffer[:] = rest
                    try:
                        message = json.loads(line)
                    except (ValueError, UnicodeDecodeError):
                        continue
                    if isinstance(message, dict) and message.get("id") == request_id:
                        if "error" in message:
                            raise RuntimeError("Codex App Server rejected the quota request; check your login")
                        return message
                if not selector.select(min(remaining, .1)):
                    continue
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    raise RuntimeError("Codex App Server exited before responding")
                buffer.extend(chunk)
                if len(buffer) > 8 * 1024 * 1024:
                    raise RuntimeError("Codex App Server response is too large")

        send("initialize", {"clientInfo": {"name": "oai-usage", "title": "OAI Usage", "version": VERSION}, "capabilities": {}}, 0)
        receive(0)
        send("initialized", {})
        send("account/rateLimits/read", {}, 1)
        result = normalize_live(receive(1).get("result"), datetime.now(UTC))
        return (result, None) if result else (None, "Codex returned no recognizable account quota")
    except (OSError, RuntimeError, TimeoutError, ValueError) as exc:
        return None, str(exc)
    finally:
        selector.close()
        if process:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=.5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=1)
            for stream in (process.stdin, process.stdout):
                if stream:
                    stream.close()


class QuotaPoller:
    def __init__(self, binary: Optional[str], timeout: float, interval: float) -> None:
        self.binary, self.timeout, self.interval = binary, timeout, interval
        self.cancel = threading.Event()
        self.lock = threading.Lock()
        self.result = None
        self.error = "Fetching live quota"
        self.thread = threading.Thread(target=self._run, name="oai-usage-quota", daemon=True)

    def start(self) -> None:
        self.thread.start()

    def _run(self) -> None:
        while not self.cancel.is_set():
            result, error = fetch_live(self.binary, self.timeout, self.cancel)
            with self.lock:
                self.result, self.error = result, error
            self.cancel.wait(self.interval)

    def read(self) -> tuple:
        with self.lock:
            return copy.deepcopy(self.result), self.error

    def stop(self) -> None:
        self.cancel.set()
        self.thread.join(timeout=2)


def log_limits(rollouts: list) -> Optional[dict]:
    buckets = {}
    for rollout in rollouts:
        for bid, bucket in rollout.limits.items():
            if bid not in buckets or timestamp(bucket["observed_at"]) > timestamp(buckets[bid]["observed_at"]):
                buckets[bid] = copy.deepcopy(bucket)
    return {"source": "session_log", "limits": buckets} if buckets else None


def quota_status(mode: str, rollouts: list, live: tuple, now: datetime, limit_id: Optional[str]) -> Optional[dict]:
    if mode == "off":
        return None
    current, error = live
    if mode == "logs" or (mode == "auto" and not current):
        current = log_limits(rollouts)
        if current and mode == "auto" and error:
            current["fallback_reason"] = error
    if not current:
        return {"source": "unavailable", "error": "No quota snapshot in the logs" if mode == "logs" else error or "Quota unavailable"}
    current = copy.deepcopy(current)
    buckets = current["limits"]
    chosen = limit_id or ("codex" if "codex" in buckets else next(iter(sorted(buckets))))
    current["active_limit_id"] = chosen
    for bucket in buckets.values():
        observed = timestamp(bucket.get("observed_at") or current.get("fetched_at"))
        bucket["snapshot_age_seconds"] = max(0, int((now - observed).total_seconds())) if observed else None
        for key in ("primary", "secondary", "individual_limit"):
            window = bucket.get(key)
            if window:
                reset = timestamp(window.get("resets_at_utc"))
                window["expired"] = bool(reset and now >= reset)
    if chosen not in buckets:
        current["error"] = f"Quota bucket {chosen} was not returned; available: {', '.join(sorted(buckets))}"
    return current


def projections(rows: list, current: Optional[dict], now: datetime) -> dict:
    result = {}
    if not current or current.get("source") == "unavailable":
        return result
    bid = current.get("active_limit_id")
    bucket = current.get("limits", {}).get(bid)
    if not bucket:
        return result
    observed = timestamp(bucket.get("observed_at") or current.get("fetched_at"))
    for kind in ("primary", "secondary", "individual_limit"):
        window = bucket.get(kind)
        if not window:
            continue
        value = {"available": False, "projection_available": False, "reason": None,
                 "limit_id": bid, "window_kind": kind}
        result[kind] = value
        reset = timestamp(window.get("resets_at_utc"))
        minutes = window.get("window_minutes")
        used = window.get("used_percent")
        if bid not in ("codex", "unknown"):
            value["reason"] = "Logs do not identify which models belong to this quota bucket"
            continue
        if not reset or not minutes or not observed:
            value["reason"] = "Quota snapshot is missing the window or observation time"
            continue
        # Recompute from the latest server window on every report/watch frame.
        # Manual resets may move this boundary before the previous cycle ends.
        start = reset - timedelta(minutes=minutes)
        if not start <= now < reset:
            value["reason"] = "Quota window has expired or has not started"
            continue
        if not start <= observed < reset or observed > now + timedelta(seconds=5):
            value["reason"] = "Snapshot time is outside the current cycle"
            continue
        as_of = min(observed, now)
        local = Bucket()
        for event, cost in rows:
            if event.at and start <= event.at <= as_of:
                local.add(event, cost)
        value.update(available=True, local=local.export(), period={"start": start.isoformat(),
                     "as_of": as_of.isoformat(), "resets_at": reset.isoformat(), "window_minutes": minutes},
                     account_usage={"used_percent": used, "remaining_percent": window.get("remaining_percent")},
                     projection_kind="local_machine_standard_api_equivalent_heuristic")
        if used is None or not 0 < used <= 100 or local.amount <= 0:
            value["reason"] = "A positive used percentage and local cost are required for projection"
            continue
        total = local.amount / (Decimal(str(used)) / 100)
        remaining = max(Decimal(0), total - local.amount)
        value.update(projection_available=True, estimate_is_partial=bool(local.reasons),
                     projected_full_cycle_known_api_cost_usd=float(round(total, 8)),
                     projected_remaining_known_api_cost_usd=float(round(remaining, 8)),
                     projected_full_cycle_api_cost_usd=None if local.reasons else float(round(total, 8)),
                     projected_remaining_api_cost_usd=None if local.reasons else float(round(remaining, 8)))
    return result


