@dataclass
class Rollout:
    path: Path
    session_id: str = ""
    parent_id: Optional[str] = None
    created_at: Optional[datetime] = None
    model: str = "unknown"
    metadata_seen: bool = False
    snapshots: list = field(default_factory=list)
    limits: dict = field(default_factory=dict)
    issues: Counter = field(default_factory=Counter)
    offset: int = 0
    signature: tuple = ()

    def ingest(self, record: Any) -> None:
        if not isinstance(record, dict) or not isinstance(record.get("payload"), dict):
            return
        payload = record["payload"]
        at = timestamp(record.get("timestamp"))
        kind = record.get("type")
        if kind == "session_meta":
            if self.metadata_seen:
                return  # Fork history may contain an older parent's session_meta.
            self.metadata_seen = True
            own = payload.get("id")
            if not isinstance(own, str) or not own:
                match = re.search(r"([0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$", self.path.stem)
                own = match[1] if match else payload.get("session_id")
            self.session_id = own if isinstance(own, str) and own else str(self.path.resolve())
            self.created_at = timestamp(payload.get("timestamp")) or at
            source = payload.get("source")
            spawn = source.get("subagent", {}) if isinstance(source, dict) else {}
            spawn = spawn.get("thread_spawn", {}) if isinstance(spawn, dict) else {}
            parent = payload.get("forked_from_id") or (spawn.get("parent_thread_id") if isinstance(spawn, dict) else None)
            if not parent and payload.get("session_id") != self.session_id:
                parent = payload.get("session_id")
            self.parent_id = parent if isinstance(parent, str) and parent != self.session_id else None
        elif kind == "turn_context":
            model = payload.get("model")
            settings = payload.get("thread_settings")
            if not model and isinstance(settings, dict):
                model = settings.get("model")
            if isinstance(model, str) and model:
                self.model = model
        elif kind == "event_msg" and payload.get("type") == "token_count":
            inherited = bool(self.parent_id and self.created_at and at and at < self.created_at)
            if not inherited:
                bucket = normalize_bucket(payload.get("rate_limits"))
                if bucket and at:
                    old = self.limits.get(bucket["limit_id"])
                    if not old or at >= timestamp(old["observed_at"]):
                        bucket["observed_at"] = at.isoformat()
                        self.limits[bucket["limit_id"]] = bucket
            info = payload.get("info")
            if not isinstance(info, dict):
                return
            current = Usage.parse(info.get("total_token_usage"))
            if current is None:
                self.issues["invalid_usage_snapshots"] += 1
                return
            last = Usage.parse(info.get("last_token_usage"))
            window = finite(info.get("model_context_window")) or 0
            self.snapshots.append(Snapshot(at, self.model, current, last, inherited, max(0, int(window))))


class Scanner:
    """Append-only JSONL cache; no stdout, network, or conversation retention."""

    def __init__(self) -> None:
        self.cache = {}
        self.issues = Counter()
        self.bytes_read = 0
        self.revision = 0

    def scan(self, roots: list) -> list:
        self.issues = Counter()
        paths = set()
        for root in roots:
            if not root.is_dir():
                self.issues["missing_roots"] += 1
                continue
            try:
                paths.update(p.resolve() for p in root.rglob("*.jsonl") if p.is_file())
            except OSError:
                self.issues["unreadable_roots"] += 1
        for deleted in self.cache.keys() - paths:
            del self.cache[deleted]
            self.revision += 1
        found = []
        for path in sorted(paths):
            try:
                stat = path.stat()
                sig = (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)
                rollout = self.cache.get(path)
                if rollout is not None and rollout.signature == sig:
                    found.append(rollout)
                    continue
                before = self._state(rollout)
                if rollout is None or sig[:2] != rollout.signature[:2] or sig[2] < rollout.offset or (
                    sig[2] == rollout.signature[2] and sig[3] != rollout.signature[3]
                ):
                    rollout = Rollout(path, session_id=str(path))
                with path.open("rb") as stream:
                    stream.seek(rollout.offset)
                    while True:
                        line = stream.readline()
                        self.bytes_read += len(line)
                        if not line:
                            break
                        relevant = any(word in line for word in (b'"session_meta"', b'"turn_context"', b'"token_count"'))
                        if not line.endswith(b"\n"):
                            # Leave an incomplete trailing record for the next append.
                            try:
                                record = json.loads(line)
                            except (ValueError, UnicodeDecodeError):
                                rollout.issues["pending_partial_line"] = 1
                                break
                            rollout.issues.pop("pending_partial_line", None)
                            if relevant:
                                rollout.ingest(record)
                        elif relevant:
                            try:
                                rollout.ingest(json.loads(line))
                            except (ValueError, UnicodeDecodeError, RecursionError):
                                rollout.issues["malformed_json_lines"] += 1
                            rollout.issues.pop("pending_partial_line", None)
                        rollout.offset = stream.tell()
                rollout.signature = sig
                if self._state(rollout) != before:
                    self.revision += 1
                self.cache[path] = rollout
                found.append(rollout)
            except OSError:
                self.issues["unreadable_files"] += 1
                if path in self.cache:
                    del self.cache[path]
                    self.revision += 1
        return found

    @staticmethod
    def _state(rollout: Optional[Rollout]) -> tuple:
        if rollout is None:
            return ()
        return (rollout.session_id, rollout.parent_id, rollout.created_at,
                tuple(rollout.snapshots), tuple(sorted(rollout.issues.items())))


