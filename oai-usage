def historical_continuity_window_overlap(previous: dict, current: dict) -> bool:
    """Both observations must be inside both unmodified declared windows."""
    before, after = timestamp(previous["observed_at"]), timestamp(current["observed_at"])
    for snapshot in (previous, current):
        key = snapshot["identity_key"]
        reset = timestamp(key[3])
        start = reset - timedelta(minutes=key[2])
        if not start <= before <= after < reset:
            return False
    return True


def historical_source_continuity(previous: dict, current: dict, *, anchor: tuple,
                                 generation: str, source_history: dict,
                                 accepted_keys: set, alias_witnesses: dict) -> Optional[dict]:
    """A bounded, source-aware prefix hypothesis; never alter a raw sample."""
    key, old_key = current["identity_key"], previous["identity_key"]
    at, old_at = timestamp(current["observed_at"]), timestamp(previous["observed_at"])
    incoming, outgoing = set(current["observer_labels"]), set(previous["observer_labels"])
    def within_frame(candidate):
        return (anchor[4] is not None and candidate[4] == anchor[4] and candidate[:3] == anchor[:3] and
                abs((timestamp(candidate[3]) - timestamp(anchor[3])).total_seconds()) <= 1)
    if (not incoming or not outgoing or current["conflict"] or previous["conflict"] or
            previous["epoch_status"] == "quarantined" or not 0 <= (at - old_at).total_seconds() <= 60 or
            not within_frame(key) or not within_frame(old_key) or
            not historical_continuity_window_overlap(previous, current)):
        return None
    priors = []
    for observer in sorted(incoming):
        prior = source_history.get(observer)
        if (not prior or prior["generation"] != generation or prior["conflict"] or
                prior["identity_key"] not in accepted_keys or not within_frame(prior["identity_key"]) or
                not 0 <= (at - prior["at"]).total_seconds() <= 60 or
                prior["used_percent"] > current["used_percent"] or
                not historical_continuity_window_overlap(
                    {"observed_at": prior["at"].isoformat(), "identity_key": prior["identity_key"]}, current)):
            return None
        priors.append((observer, prior))
    evidence = {"observed_at": current["observed_at"], "previous_observed_at": previous["observed_at"],
                "maximum_prefix_age_seconds": 60, "maximum_used_difference_percentage_points": 1,
                "raw_window_intersection_checked": True,
                "incoming_observer_prefix": [{"observer_label": observer, "observed_at": prior["at"].isoformat(),
                    "used_percent": prior["used_percent"], "raw_identity_key": prior["identity_key"]} for observer, prior in priors],
                "basis": "conditional_prefix_evidence_not_cache_or_reset_confirmation"}
    drop = previous["used_percent"] - current["used_percent"]
    if 0 < drop <= 1 and not incoming & outgoing and key in accepted_keys:
        evidence.update(kind="bounded_cross_observer_reordering", raw_used_drop_percentage_points=drop)
        return {"assumption": "bounded_cross_observer_reordering", "evidence": evidence}
    if key == old_key or drop > 0 or abs((timestamp(key[3]) - timestamp(old_key[3])).total_seconds()) > 1:
        return None
    if any(current["used_percent"] - prior["used_percent"] > 1 for observer, prior in priors):
        return None
    pair = tuple(sorted((old_key, key), key=str))
    witnesses = [observer for observer, prior in priors if prior["identity_key"] == old_key]
    known = alias_witnesses.get(pair)
    if not witnesses and not (known and 0 <= (at - known["at"]).total_seconds() <= 60):
        return None
    evidence.update(kind="source_witnessed_deadline_alias", fixed_anchor_identity_key=anchor,
                    maximum_anchor_deadline_distance_seconds=1,
                    pair_witness_observed_at=at.isoformat() if witnesses else known["at"].isoformat(),
                    pair_witness_observers=witnesses if witnesses else list(known["observers"]))
    return {"assumption": "source_witnessed_deadline_alias", "evidence": evidence,
            "alias_pair": pair, "new_pair_witness": {"at": at, "observers": witnesses} if witnesses else None}


def historical_quota_epochs(ordered_series: dict, *, source_aware: bool = False) -> tuple:
    """Classify each observation using its chronological prefix only.

    A declared deadline is metadata, not a unique quota epoch. Never reconnect
    two runs after a decline or identity change, even if their deadlines match.
    """
    epochs, latest, current, edge_reasons = {}, {}, {}, {}
    for pool, ordered in ordered_series.items():
        retired_keys, seen_keys = set(), set()
        previous, active = None, None
        supported_key, supported_latest = None, None
        last_known_plan = None
        source_history, decline_generations = {}, {}
        accepted_keys, alias_witnesses = set(), {}
        for at, snap in ordered:
            key = snap["identity_key"]
            classification, status, ambiguities, evidence = "initial_observation", "observed", [], {}
            boundary = previous is None
            continuity = None
            if previous is not None:
                old_key = previous["identity_key"]
                old_at = timestamp(previous["observed_at"])
                old_reset, reset = timestamp(old_key[3]), timestamp(key[3])
                old_start = old_reset - timedelta(minutes=old_key[2])
                start = reset - timedelta(minutes=key[2])
                drop = previous["used_percent"] - snap["used_percent"]
                advance = (reset - old_reset).total_seconds()
                context_changed = (old_key[2] != key[2] or
                                   (key[4] is not None and last_known_plan is not None and key[4] != last_known_plan))
                supported_window = (not context_changed and drop >= 20 and advance > 60 and start > old_start and
                                    old_at - timedelta(seconds=60) <= start <= at < reset and
                                    old_start <= old_at < old_reset and not previous["conflict"])
                evidence = {"previous_observed_at": previous["observed_at"], "used_drop_percentage_points": drop,
                            "deadline_change_seconds": advance, "inferred_window_start": start.isoformat(),
                            "minimum_used_drop_percentage_points": 20, "minimum_deadline_advance_seconds_exclusive": 60,
                            "window_start_tolerance_seconds": 60, "last_known_plan_before": last_known_plan,
                            "basis": "logged_metadata_heuristic_not_reset_confirmation"}
                if key in retired_keys:
                    classification, status = "retired_window_return", "quarantined"
                    ambiguities = ["retired_window_return"]
                    boundary = old_key != key or epochs[active]["status"] != "quarantined"
                elif snap["conflict"]:
                    classification, status, ambiguities = "conflicting_observation_ambiguous", "ambiguous", ["conflicting_quota_observation"]
                    boundary = True
                elif previous["conflict"]:
                    classification, status, ambiguities = "after_conflicting_observation", "ambiguous", ["conflicting_quota_observation"]
                    boundary = True
                else:
                    marker = decline_generations.get(key) if source_aware else None
                    old_sources = [observer for observer in snap["observer_labels"]
                                   if marker and observer in source_history and
                                   source_history[observer]["at"] < marker["at"] and
                                   source_history[observer]["identity_key"] in marker["prior_continuity_keys"]]
                    if (source_aware and key == old_key and marker and old_sources and
                            snap["used_percent"] > previous["used_percent"] + 1):
                        boundary = True
                        classification, status = "prior_generation_observer_return", "ambiguous"
                        ambiguities = ["prior_generation_observer_return"]
                        evidence.update(reset_generation_started_at=marker["at"].isoformat(),
                                        prior_generation_observers=sorted(old_sources))
                    elif source_aware and not context_changed:
                        continuity = historical_source_continuity(previous, snap, anchor=epochs[active]["identity_key"],
                            generation=active, source_history=source_history, accepted_keys=accepted_keys,
                            alias_witnesses=alias_witnesses)
                if (not boundary and continuity is None and key not in retired_keys and key != old_key):
                    boundary = True
                    if context_changed:
                        classification, status = "supported_context_change", "supported"
                    elif supported_window:
                        classification, status = "supported_new_window", "supported"
                    elif (supported_key == key and epochs[active]["status"] == "quarantined" and supported_latest is not None and
                          snap["used_percent"] >= supported_latest["used_percent"]):
                        classification, status = "supported_window_resumed", "supported"
                    elif old_key[4] is None or key[4] is None:
                        classification, status, ambiguities = "plan_metadata_unknown", "ambiguous", ["plan_metadata_unknown"]
                    elif abs(advance) <= 1 and key[2] == old_key[2] and key[4] == old_key[4]:
                        classification, status, ambiguities = "reset_alias_ambiguous", "ambiguous", ["reset_alias_ambiguous"]
                    else:
                        classification, status, ambiguities = "declared_window_change_ambiguous", "ambiguous", ["declared_window_change_ambiguous"]
                elif not boundary and continuity is None and key not in retired_keys and snap["used_percent"] < previous["used_percent"]:
                    boundary = True
                    classification, status, ambiguities = "quota_decrease_ambiguous", "ambiguous", ["quota_decrease_ambiguous"]
            elif snap["conflict"]:
                classification, status, ambiguities = "conflicting_observation_ambiguous", "ambiguous", ["conflicting_quota_observation"]
            if boundary:
                prior_continuity_keys = set(accepted_keys)
                identifier = "quota-epoch-" + hashlib.sha256(json.dumps([pool, at.isoformat(), key], separators=(",", ":")).encode()).hexdigest()[:20]
                if active is not None:
                    epochs[active]["superseded_at"], epochs[active]["superseded_by"] = at.isoformat(), identifier
                active = identifier
                accepted_keys, alias_witnesses = {key}, {}
                epochs[active] = {"quota_epoch_id": active, "identity_key": key, "started_at": at.isoformat(),
                    "last_observed_at": at.isoformat(), "classification": classification, "status": status,
                    "ambiguity_reasons": ambiguities, "supports_new_window": classification == "supported_new_window",
                    "classification_as_of": at.isoformat(), "superseded_at": None, "superseded_by": None,
                    "retired_at": at.isoformat() if status == "quarantined" else None,
                    "observer_labels": [], "support_evidence": evidence}
                if source_aware:
                    epochs[active].update(continuity_assumptions=[], continuity_evidence=[])
                    if classification == "quota_decrease_ambiguous" and previous is not None and previous["identity_key"] == key:
                        older_marker = decline_generations.get(key)
                        if older_marker:
                            prior_continuity_keys.update(older_marker["prior_continuity_keys"])
                        decline_generations[key] = {"generation": active, "at": at,
                                                    "prior_continuity_keys": prior_continuity_keys}
                if classification in ("supported_new_window", "supported_context_change"):
                    retired_keys.update(seen_keys - {key})
                    supported_key = key
                    for epoch in epochs.values():
                        if epoch["identity_key"][:2] == pool and epoch["identity_key"] in retired_keys and epoch["retired_at"] is None:
                            epoch["retired_at"] = at.isoformat()
                elif status == "ambiguous":
                    supported_key, supported_latest = None, None
            epoch = epochs[active]
            if continuity is not None:
                if continuity["assumption"] not in epoch["continuity_assumptions"]:
                    epoch["continuity_assumptions"].append(continuity["assumption"])
                epoch["continuity_evidence"].append(continuity["evidence"])
                accepted_keys.add(key)
                if continuity.get("new_pair_witness"):
                    alias_witnesses[continuity["alias_pair"]] = continuity["new_pair_witness"]
            if epoch["status"] == "supported":
                supported_key, supported_latest = key, snap
            epoch["last_observed_at"] = at.isoformat()
            epoch["observer_labels"] = sorted(set(epoch["observer_labels"]) | set(snap["observer_labels"]))
            snap.update(quota_epoch_id=active, epoch_classification=epoch["classification"],
                        classification_as_of=epoch["classification_as_of"], epoch_status=epoch["status"],
                        epoch_ambiguity_reasons=list(epoch["ambiguity_reasons"]))
            if source_aware:
                snap.update(continuity_identity_key=epoch["identity_key"],
                            continuity_assumptions=list(epoch["continuity_assumptions"]),
                            continuity_evidence=[continuity["evidence"]] if continuity is not None else [])
            latest[active] = snap
            current[pool] = {"quota_epoch_id": active if epoch["status"] != "quarantined" else None,
                             "last_observed_at": at.isoformat(), "status": "unknown" if epoch["ambiguity_reasons"] else "observed",
                             "reasons": list(epoch["ambiguity_reasons"])}
            if previous is not None:
                reasons = []
                if previous["quota_epoch_id"] != active:
                    reasons.extend(("quota_epoch_changed", epoch["classification"]))
                    if previous["identity_key"] != key:
                        reasons.append("window_reset_or_plan_changed")
                if epoch["status"] == "quarantined" or previous["epoch_status"] == "quarantined":
                    reasons.append("retired_window_return")
                edge_reasons[(previous["id"], snap["id"])] = sorted(set(reasons))
            seen_keys.add(key)
            if not snap["conflict"] and epoch["status"] != "quarantined" and key[4] is not None:
                last_known_plan = key[4]
            for observer in snap["observer_labels"]:
                source_history[observer] = {"at": at, "identity_key": key, "used_percent": snap["used_percent"],
                                            "generation": active, "conflict": snap["conflict"] or epoch["status"] == "quarantined"}
            previous = snap
    return epochs, latest, current, edge_reasons


def historical_fixed_grid(ordered: list, span: float) -> tuple:
    """Timestamp-only epoch grid, preserving real endpoint identities."""
    by_epoch = defaultdict(list)
    for at, snap in ordered:
        reset = timestamp(snap["identity_key"][3])
        if not snap["conflict"] and snap["used_percent"] < 100 and reset - timedelta(minutes=snap["identity_key"][2]) <= at < reset:
            by_epoch[snap["quota_epoch_id"]].append((at, snap))
    edge_map, records = {}, []
    positions = {snap["id"]: i for i, (at, snap) in enumerate(ordered)}
    tolerance = min(60, span / 10)
    for eid, values in by_epoch.items():
        times = [at for at, snap in values]
        start = times[0]
        boundaries = {}
        previous_index = -1
        for k in range(int((times[-1] - start).total_seconds() // span) + 2):
            target = start + timedelta(seconds=k * span)
            pos = bisect_left(times, target)
            candidates = [i for i in (pos - 1, pos) if 0 <= i < len(times) and i > previous_index and abs((times[i] - target).total_seconds()) <= tolerance]
            if candidates:
                chosen = min(candidates, key=lambda i: (abs((times[i] - target).total_seconds()), times[i]))
                boundaries[k] = values[chosen][1]
                previous_index = chosen
        last_grid = int(math.ceil((times[-1] - start).total_seconds() / span))
        for k in range(last_grid):
            left, right = boundaries.get(k), boundaries.get(k + 1)
            grid_id = f"{eid}:{span:g}:{k}"
            reasons = []
            if left is None or right is None:
                reasons.append("missing_fixed_grid_boundary")
            actual = (timestamp(right["observed_at"]) - timestamp(left["observed_at"])).total_seconds() if left and right else None
            if actual is not None and not 0.8 * span <= actual <= 1.2 * span:
                reasons.append("fixed_grid_span_outside_tolerance")
            record = {"grid_id": grid_id, "quota_epoch_id": eid,
                      "target_start": (start + timedelta(seconds=k * span)).isoformat(),
                      "target_end": (start + timedelta(seconds=(k + 1) * span)).isoformat(),
                      "before_id": left["id"] if left else None, "after_id": right["id"] if right else None,
                      "span_seconds": actual, "reasons": reasons}
            records.append(record)
            if not reasons:
                for i in range(positions[left["id"]], positions[right["id"]]):
                    a, b = ordered[i][1], ordered[i + 1][1]
                    if a["quota_epoch_id"] == b["quota_epoch_id"] == eid:
                        edge_map[(a["id"], b["id"])] = record
    return edge_map, records


def historical_target_owner(items: list, grid_id: str) -> dict:
    """Frozen, quota/cost-blind ownership of one complete robust grid.

    Count repaired ledger events, not alleged requests. Unknown and unpriced
    profiles participate; failed owners are never replaced by a runner-up.
    """
    counts, first_at = Counter(), {}
    for event, cost, profile in items:
        counts[profile] += 1
        first_at.setdefault(profile, event.at)
    ranked = sorted(counts, key=lambda p: (-counts[p], first_at[p], p))
    export = lambda p: dict(zip(("model", "mode", "effort"), p))
    owner = ranked[0] if ranked else None
    return {"profile_key": owner, "export": {
        "rule": "maximum_ledger_event_count_then_earliest_event_then_lexical_profile",
        "scope": "fixed_grid" if grid_id is not None else "unassigned_incomplete_grid",
        "grid_id": grid_id, "owner_profile": export(owner) if owner else None,
        "profile_event_counts": [{"profile": export(p), "event_count": counts[p],
                                  "first_event_at": first_at[p].isoformat()} for p in ranked],
        "quota_delta_is_not_apportioned": True, "selection_uses_quota_or_cost": False,
        "no_fallback": True,
        "sampling_bias": "event-frequency-selected profile; not a random sample or clean-usage certificate"}}


def historical_raw_graph(*, roots, source_label, account_label, now, offsets,
                         rollouts, sessions, rows, local, dated, times, ordered_series,
                         epochs, current_by_pool, quota_edge_reasons, sparse_profiles,
                         defects, reset_session_models, unknown_cache_sessions, issues,
                         global_reasons, task_markers, identity_export, snapshot_export,
                         continuity_key) -> dict:
    """Project profile cost contracts onto original adjacent observations.

    No grid owner, coarsening, fitted-rate selection, or quota apportionment is
    involved. Other local work is unallocated nonnegative nuisance. Exact-cost
    and safe zero-lower-bound edges preserve the observation path and shared
    endpoint constraints; defective costs never supply near-clean budgets.
    """
    profile_export = lambda profile: dict(zip(("model", "mode", "effort"), profile))
    endpoint_export = lambda snap: {key: snap[key] for key in ("id", "observed_at", "used_percent")}
    max_gap = 300
    raw_edges, scenarios, reason_counts = [], [], Counter()
    profile_evidence = {eid: set(sparse_profiles[eid]) for eid in epochs}
    # Shifted interval membership also establishes profile evidence. Do not let
    # the sparse display heuristic suppress a real target receipt on an edge.
    for ordered in ordered_series.values():
        for (a_at, a), (b_at, b) in zip(ordered, ordered[1:]):
            for offset in offsets:
                shift = timedelta(seconds=offset)
                left, right = bisect_right(times, a_at + shift), bisect_right(times, b_at + shift)
                profile_evidence[a["quota_epoch_id"]].update(p for e, c, p in dated[left:right])
    scenario_map = {}
    for eid in epochs:
        for profile in sorted(profile_evidence[eid]):
            for offset in offsets:
                row = {"quota_epoch_id": eid, "identity": identity_export(epochs[eid]["identity_key"]),
                       "epoch_status": epochs[eid]["status"],
                       "diagnostic_only": bool(epochs[eid]["ambiguity_reasons"]),
                       "profile": profile_export(profile), "alignment_offset_seconds": offset,
                       "policy_id": "raw_edges", "edges": []}
                scenario_map[(eid, profile, offset)] = row
                scenarios.append(row)
    for ordered in ordered_series.values():
        observation_times = [at for at, snap in ordered]
        for (a_at, a), (b_at, b) in zip(ordered, ordered[1:]):
            eid, identity = a["quota_epoch_id"], continuity_key(a)
            span = (b_at - a_at).total_seconds()
            base_reasons = list(global_reasons) + list(quota_edge_reasons[(a["id"], b["id"])])
            if span <= 0:
                base_reasons.append("nonpositive_observation_span")
            if span > max_gap:
                base_reasons.append("observation_gap_exceeds_policy")
            if a["conflict"] or b["conflict"]:
                base_reasons.append("conflicting_quota_observation")
            for at, snap in ((a_at, a), (b_at, b)):
                reset = timestamp(snap["identity_key"][3])
                if not reset - timedelta(minutes=snap["identity_key"][2]) <= at < reset:
                    base_reasons.append("observation_outside_declared_cycle")
                if snap["used_percent"] >= 100:
                    base_reasons.append("quota_saturated")
                if at > now:
                    base_reasons.append("observation_after_analysis_time")
            # A bounded source-supported negative jump stays signed and usable.
            # Incompatible declines already have an epoch-boundary reason.
            raw = {"id": "raw-edge:" + a["id"] + ":" + b["id"],
                   "before": endpoint_export(a), "after": endpoint_export(b),
                   "quota_epoch_id": eid, "after_quota_epoch_id": b["quota_epoch_id"],
                   "identity": identity_export(identity), "epoch_status": epochs[eid]["status"],
                   "diagnostic_only": bool(epochs[eid]["ambiguity_reasons"]),
                   "delta_percent": b["used_percent"] - a["used_percent"],
                   "span_seconds": span, "atomic_interval_count": 1,
                   "policy_id": "raw_edges", "max_gap_seconds": max_gap,
                   "reasons": sorted(set(base_reasons)),
                   "status": "rejected" if base_reasons else "eligible"}
            raw_edges.append(raw)
            for offset in offsets:
                shift = timedelta(seconds=offset)
                shifted_left, shifted_right = a_at + shift, b_at + shift
                left, right = bisect_right(times, shifted_left), bisect_right(times, shifted_right)
                items = dated[left:right]
                by_profile = defaultdict(list)
                for item in items:
                    by_profile[item[2]].append(item)
                total_cost = sum((c.amount for e, c, p in items), Decimal(0))
                total_usage = {name: sum(getattr(e.usage, name) for e, c, p in items) for name in FIELDS}
                alignment_reasons = []
                if shifted_right > now:
                    alignment_reasons.append("alignment_after_analysis_time")
                if offset:
                    position = bisect_right(observation_times, shifted_left) - 1
                    stop = bisect_right(observation_times, shifted_right)
                    nearby = ordered[max(position, 0):stop]
                    if any(continuity_key(s) != identity for t, s in nearby):
                        alignment_reasons.append("alignment_crosses_quota_identity")
                    if any(s["conflict"] for t, s in nearby):
                        alignment_reasons.append("alignment_touches_conflicting_quota")
                    if any(s["quota_epoch_id"] != eid for t, s in nearby):
                        alignment_reasons.append("alignment_crosses_quota_epoch")
                    raw_keys = {s["identity_key"] for t, s in nearby} | {a["identity_key"], b["identity_key"], identity}
                    if any(not timestamp(key[3]) - timedelta(minutes=key[2]) <= shifted_left < shifted_right < timestamp(key[3])
                           for key in raw_keys):
                        alignment_reasons.append("alignment_outside_declared_cycle")
                if any(e.at > now for e, c, p in items):
                    alignment_reasons.append("local_usage_after_analysis_time")
                for profile in sorted(profile_evidence[eid]):
                    target = by_profile.get(profile, [])
                    reasons = base_reasons + alignment_reasons
                    target_reasons = []
                    if "conflict" in profile[1:]:
                        target_reasons.append("conflicting_profile_metadata")
                    if profile[0] == "unknown":
                        target_reasons.append("unknown_model")
                    if any(not c.complete for e, c, p in target):
                        target_reasons.append("incomplete_local_price")
                    cache_complete = not any(e.session_id in unknown_cache_sessions for e, c, p in target)
                    if not cache_complete:
                        target_reasons.append("incomplete_target_cache_mix")
                    touched, nuisance_resets = [], 0
                    for defect in defects:
                        start, end, kind, sid, details = defect
                        overlaps = (shifted_left < start <= shifted_right if kind == "counter_reset" else
                                    (start <= shifted_right and end > shifted_left) or
                                    (start == end and shifted_left <= start <= shifted_right))
                        if not overlaps:
                            continue
                        models = reset_session_models.get(sid, set())
                        nuisance_only = (kind == "counter_reset" and models and "unknown" not in models and
                                         profile[0] not in models)
                        if nuisance_only:
                            nuisance_resets += 1
                        else:
                            touched.append(defect)
                    target_reasons.extend(d[2] for d in touched)
                    # Cost defects do not erase valid quota measurements or
                    # their shared endpoints. Zero is a safe lower bound on
                    # target consumption, but cannot supply a near-clean upper
                    # budget. Keep the original ledger subtotal for audit only.
                    reasons = sorted(set(reasons))
                    diagnostic_cost = sum((c.amount for e, c, p in target), Decimal(0))
                    cost = Decimal(0) if target_reasons else diagnostic_cost
                    usage = {name: sum(getattr(e.usage, name) for e, c, p in target) for name in FIELDS}
                    edge = {**raw, "alignment_offset_seconds": offset,
                            "profile": profile_export(profile), "status": "rejected" if reasons else "eligible",
                            "reasons": reasons, "known_api_cost_usd": float(cost),
                            "known_api_cost_decimal_usd": str(cost),
                            "diagnostic_target_known_api_cost_usd": float(diagnostic_cost),
                            "diagnostic_target_known_api_cost_decimal_usd": str(diagnostic_cost),
                            "target_cost_contract": "exact" if not target_reasons else "lower_bound_only_zero",
                            "clean_budget_eligible": not target_reasons,
                            "eligible_for_clean_anchor": not reasons and not target_reasons and cost > 0,
                            "target_receipt_interval": {"start_exclusive": shifted_left.isoformat(),
                                                        "end_inclusive": shifted_right.isoformat()},
                            "local_event_count": len(target), "usage": usage,
                            "cache_mix_complete": cache_complete,
                            "latest_local_event_at": items[-1][0].at.isoformat() if items else None,
                            "latest_target_event_at": target[-1][0].at.isoformat() if target else None,
                            "zero_delta_interval_count": int(raw["delta_percent"] == 0),
                            "observed_profiles": [profile_export(p) for p in sorted(by_profile)],
                            "affected_session_count": len({d[3] for d in touched}),
                            "target_defect_reasons": sorted(set(target_reasons)),
                            "total_local_known_api_cost_usd": float(total_cost),
                            "nuisance_local_known_api_cost_usd": float(total_cost - diagnostic_cost),
                            "total_local_usage": total_usage,
                            "nuisance_local_usage": {name: total_usage[name] - usage[name] for name in FIELDS},
                            "total_local_event_count": len(items), "nuisance_local_event_count": len(items) - len(target),
                            "nuisance_unpriced_event_count": sum(not c.complete for e, c, p in items if p != profile),
                            "nuisance_counter_reset_count": nuisance_resets,
                            "quota_delta_is_not_apportioned": True}
                    scenario_map[(eid, profile, offset)]["edges"].append(edge)
                    reason_counts.update(reasons)
    current_exports = []
    for key, state in current_by_pool.items():
        exported = {"limit_id": key[0], "window_kind": key[1], **state,
                    "latest_observed_quota_epoch_id": state["quota_epoch_id"], "analysis_time": now.isoformat()}
        if state["quota_epoch_id"] is not None:
            epoch = epochs[state["quota_epoch_id"]]
            reset = timestamp(epoch["identity_key"][3])
            if timestamp(state["last_observed_at"]) > now:
                exported.update(quota_epoch_id=None, status="unknown", reasons=["observation_after_analysis_time"])
            elif not reset - timedelta(minutes=epoch["identity_key"][2]) <= now < reset:
                exported.update(quota_epoch_id=None, status="unknown", reasons=["current_cycle_not_observed"])
        current_exports.append(exported)
    model_totals = defaultdict(Bucket)
    for event, cost in rows:
        model_totals[event.model].add(event, cost)
    raw_observations = [snapshot_export(snap) for ordered in ordered_series.values() for at, snap in ordered]
    return {"schema_version": 1, "experimental": True, "kind": "raw_quota_edge_graph",
            "trust_level": "historical_low_trust", "alternatives_not_additive": True,
            "analyzed_at": now.isoformat(),
            "source": {"label": source_label, "account_label": account_label,
                       "account_verified": False, "selected_root_count": len(roots),
                       "root_set_fingerprint": hashlib.sha256("\n".join(sorted(str(p.resolve()) for p in roots)).encode()).hexdigest()},
            "local_usage": local.export(),
            "counts": {"files": len(rollouts), "sessions": len(sessions), "local_events": len(rows),
                       "quota_observations": len(raw_observations), "raw_edges": len(raw_edges),
                       "raw_model_scenarios": len(scenarios),
                       "projected_edges_across_profiles_and_offsets": sum(len(s["edges"]) for s in scenarios),
                       "eligible_projected_edges": sum(e["status"] == "eligible" for s in scenarios for e in s["edges"])},
            "quota_epochs": [{**{k: v for k, v in epoch.items() if k != "identity_key"},
                              "identity": identity_export(epoch["identity_key"])} for epoch in epochs.values()],
            "current_quota_epochs": current_exports,
            "observed_models": [{"model": model, **bucket.export(),
                                 "scenario_count": sum(s["profile"]["model"] == model for s in scenarios),
                                 "absence_reasons": [] if any(s["profile"]["model"] == model for s in scenarios)
                                     else ["no_quota_paired_profile_evidence"]}
                                for model, bucket in sorted(model_totals.items())],
            "raw_observations": raw_observations, "raw_edges": raw_edges,
            "raw_model_scenarios": scenarios, "alignment_offsets_seconds": list(offsets),
            "selection_policy": "all_original_adjacent_edges_exact_target_profile_receipts_no_grid_ownership",
            "analysis_clock_policy": "clock_only_not_log_cutoff; future_evidence_edges_rejected; backtests_require_truncated_input",
            "max_observation_gap_seconds": max_gap,
            "task_boundary_markers": dict(sorted(Counter(kind for sid, at, kind in task_markers).items())),
            "task_boundary_count_basis": "deduplicated session/timestamp/kind; does not prove global idle intervals",
            "issues": dict(sorted(issues.items())), "global_reasons": global_reasons,
            "localized_defects": [{"start": a.isoformat(), "end": b.isoformat(), "reason": reason,
                                   "session_label": hashlib.sha256(sid.encode()).hexdigest()[:16], "details": details}
                                  for a, b, reason, sid, details in defects],
            "exclusion_reasons": dict(sorted(reason_counts.items())), "limitations": HISTORICAL_LIMITATIONS}


def historical_segments(roots: list, prices: dict, *, source_label: str = "selected_local_roots",
                        account_label: str = "unverified", now: Optional[datetime] = None,
                        policies: Optional[tuple] = None, offsets: tuple = (-60, 0, 60),
                        _block_span_seconds: Optional[dict] = None,
                        _target_profile_ownership: bool = False,
                        _source_aware_epochs: bool = False,
                        _raw_graph_only: bool = False) -> tuple:
    """Opt-in, low-trust retrospective estimator over the existing unified ledger.

    Selection depends on time, metadata and ledger defects, never a fitted ratio.
    One adjacent observation timeline covers all sessions for each pool/window.
    Shared endpoint errors telescope; disconnected fragments keep every boundary.
    """
    segment_text(source_label, "source_label")
    segment_text(account_label, "account_label")
    if _target_profile_ownership and not _block_span_seconds and not _raw_graph_only:
        raise ValueError("Target-profile ownership requires fixed block grids")
    _source_aware_epochs = _source_aware_epochs or _raw_graph_only
    now = now or datetime.now(UTC)
    policies = tuple(dict(p) for p in (HISTORICAL_POLICIES if policies is None else policies))
    for p in policies:
        segment_text(p["id"], "policy id")
        if any(type(p[k]) not in (int, float) or not math.isfinite(p[k]) or p[k] < 0 for k in
               ("min_span_seconds", "max_gap_seconds", "min_delta_percent")) or p["max_gap_seconds"] <= 0:
            raise ValueError("Historical policy thresholds must be finite and nonnegative, with a positive gap")
    if not policies or len({p["id"] for p in policies}) != len(policies):
        raise ValueError("Historical policies require distinct IDs")
    if not offsets or len(set(offsets)) != len(offsets) or any(type(n) not in (int, float) or not math.isfinite(n) or abs(n) > 86400 for n in offsets):
        raise ValueError("Historical offsets must be distinct finite seconds within +/-86400")
    scanner = Scanner()
    rollouts = scanner.scan(roots)
    sessions, accounting_issues = account(rollouts)
    rows = priced_events(sessions, prices)
    local = Bucket()
    for event, cost in rows:
        local.add(event, cost)
    files_by_session = defaultdict(list)
    for rollout in rollouts:
        files_by_session[rollout.session_id].append(rollout)
    # A reset's carried-forward Event.model does not establish the model whose
    # cumulative counter changed. Only a wholly known, non-target session can
    # be treated as nuisance-only; original records protect model switches and
    # unknown records that reconciliation may have removed from the ledger.
    reset_session_models = defaultdict(set)
    if _target_profile_ownership or _raw_graph_only:
        for rollout in rollouts:
            reset_session_models[rollout.session_id].update(
                snap.model for snap in rollout.snapshots if not snap.inherited)
            reset_session_models[rollout.session_id].update(
                receipt.model for receipt in rollout.responses
                if receipt.thread_id == rollout.session_id and not (
                    rollout.parent_id and rollout.created_at and receipt.at and receipt.at < rollout.created_at))
        for event, cost in rows:
            reset_session_models[event.session_id].add(event.model)
    issues = Counter(scanner.issues)
    issues.update(accounting_issues)
    # Defects without a timestamp are scoped to the affected logical session's
    # dated extent, not promoted to a global veto on unrelated historical data.
    defects = []
    defect_keys = {"malformed_json_lines", "pending_partial_line", "invalid_usage_records", "invalid_usage_snapshots",
                   "unreconciled_usage_intervals", "conflicting_usage_records", "conflicting_model_metadata",
                   "counter_component_corrections"}
    global_reasons = []
    if any(scanner.issues[k] for k in ("missing_roots", "unreadable_roots", "unreadable_files")):
        global_reasons.append("selected_source_coverage_incomplete")
    for sid, files in files_by_session.items():
        _, session_issues = account(files)
        dates = [item.at for f in files for item in f.snapshots if item.at and not item.inherited]
        dates.extend(item.at for f in files for item in f.responses if item.at and item.thread_id == sid and
                     not (f.parent_id and f.created_at and item.at < f.created_at))
        if dates:
            bad = sorted(k for k in defect_keys if session_issues[k])
            if bad:
                defects.append((min(dates), max(dates), "session_ledger_incomplete", sid, bad))
            if session_issues["unattributed_fork_baseline_tokens"]:
                own = [s.at for f in files for s in f.snapshots if s.at and not s.inherited]
                if own:
                    first_own = min(own)
                    defects.append((first_own, first_own, "unattributed_fork_baseline", sid,
                                    ["unattributed_fork_baseline_tokens"]))
        elif any(session_issues[k] for k in defect_keys) or session_issues["unattributed_fork_baseline_tokens"]:
            global_reasons.append("undated_ledger_defect")
    for event, cost in rows:
        if event.at is None:
            global_reasons.append("undated_local_usage")
        elif event.reset:
            defects.append((event.at, event.at, "counter_reset", event.session_id, []))

    observations, settings, task_markers = defaultdict(dict), defaultdict(dict), set()
    unknown_cache_sessions = set()
    def setting_text(value):
        # Only scalar configuration labels are retained; never stringify blobs.
        return value if isinstance(value, str) and 0 < len(value) <= 200 and not any(ord(c) < 32 for c in value) else None

    def read_settings(payload, state):
        candidates = [payload]
        if isinstance(payload.get("thread_settings"), dict):
            candidates.append(payload["thread_settings"])
        for candidate in list(candidates):
            for key in ("collaboration_mode", "collaboration_settings"):
                nested = candidate.get(key)
                if isinstance(nested, dict):
                    candidates.append(nested)
                    if isinstance(nested.get("settings"), dict):
                        candidates.append(nested["settings"])
        for candidate in candidates:
            mode = setting_text(candidate.get("service_tier"))
            effort = setting_text(first(candidate, "reasoning_effort", "effort"))
            if mode:
                state["mode"] = mode
            if effort:
                state["effort"] = effort

    for rollout in rollouts:
        state = {"mode": "unknown", "effort": "unknown"}
        try:
            stat = rollout.path.stat()
            if (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns) != rollout.signature:
                global_reasons.append("log_changed_during_historical_read")
                continue
            with rollout.path.open("rb") as handle:
                while handle.tell() < rollout.offset:
                    line = handle.readline(rollout.offset - handle.tell())
                    if not line:
                        break
                    if not any(tag in line for tag in (b'"turn_context"', b'"event_msg"', b'"token_usage_record"')):
                        continue
                    try:
                        record = json.loads(line)
                        if not isinstance(record, dict) or not isinstance(record.get("payload"), dict):
                            continue
                        payload = record["payload"]
                        kind, at = record.get("type"), timestamp(record.get("timestamp"))
                        if kind == "turn_context" or (kind == "event_msg" and payload.get("type") == "thread_settings_applied"):
                            read_settings(payload, state)
                        is_usage = kind == "token_usage_record" or (kind == "event_msg" and payload.get("type") == "token_count")
                        if not at or (rollout.parent_id and rollout.created_at and at < rollout.created_at):
                            continue
                        if (_block_span_seconds is not None or _raw_graph_only) and is_usage:
                            info = payload.get("info")
                            raw_usage = (payload.get("usage") if kind == "token_usage_record" else
                                         info.get("total_token_usage") if isinstance(info, dict) else None)
                            if Usage.parse(raw_usage) is not None and not all(k in raw_usage for k in ("input_tokens", "cached_input_tokens")):
                                unknown_cache_sessions.add(rollout.session_id)
                        if kind == "event_msg" and payload.get("type") in ("task_started", "task_complete", "turn_aborted"):
                            task_markers.add((rollout.session_id, at, payload["type"]))
                        if is_usage or kind == "turn_context" or (kind == "event_msg" and payload.get("type") == "thread_settings_applied"):
                            prior = settings[rollout.session_id].get(at)
                            values = (state["mode"], state["effort"])
                            if prior and prior != values:
                                # Copies can fill missing fields, but contradictions remain explicit.
                                values = tuple(a if a == b or b == "unknown" else b if a == "unknown" else "conflict"
                                               for a, b in zip(prior, values))
                            settings[rollout.session_id][at] = values
                        if kind != "event_msg" or payload.get("type") != "token_count":
                            continue
                        raw_bucket = payload.get("rate_limits")
                        bucket = normalize_bucket(raw_bucket)
                        if not bucket:
                            continue
                        if first(raw_bucket, "limitId", "limit_id") is not None:
                            segment_text(first(raw_bucket, "limitId", "limit_id"), "historical limit_id")
                        if bucket.get("plan_type") is not None:
                            segment_text(bucket["plan_type"], "historical plan_type")
                        for window_kind in ("primary", "secondary", "individual_limit"):
                            window = bucket.get(window_kind)
                            if not window:
                                continue
                            if (window_kind == "individual_limit" and "individualLimit" in raw_bucket and
                                    "individual_limit" in raw_bucket and raw_bucket["individualLimit"] != raw_bucket["individual_limit"]):
                                issues["conflicting_window_aliases"] += 1
                                continue
                            raw_window = first(raw_bucket, "individualLimit", "individual_limit") if window_kind == "individual_limit" else raw_bucket.get(window_kind)
                            minutes, reset, used = (first(raw_window, *keys) for keys in
                                (("windowDurationMins", "window_minutes"), ("resetsAt", "resets_at"), ("usedPercent", "used_percent")))
                            if (type(minutes) is not int or not 1 <= minutes <= 5256000 or type(reset) is not int or reset <= 0 or
                                    type(used) not in (int, float) or not math.isfinite(used) or not 0 <= used <= 100 or not window["resets_at_utc"]):
                                issues["invalid_quota_window"] += 1
                                continue
                            identity = (bucket["limit_id"], window_kind, minutes, window["resets_at_utc"], bucket.get("plan_type"))
                            key = (bucket["limit_id"], window_kind)
                            old = observations[key].get(at)
                            observer = hashlib.sha256(rollout.session_id.encode()).hexdigest()[:16]
                            snap = {"observed_at": at.isoformat(), "measurement_time": None,
                                    "timestamp_basis": "jsonl_landing_time", "source": "historical_log",
                                    "used_percent": used, "identity_key": identity,
                                    "observer_labels": [observer], "conflict": False, "source_record_count": 1}
                            if old is None:
                                observations[key][at] = snap
                            elif old["identity_key"] != identity or old["used_percent"] != used:
                                old["conflict"] = True
                                old["observer_labels"] = sorted(set(old["observer_labels"]) | {observer})
                                old["source_record_count"] += 1
                                issues["conflicting_global_quota_observation"] += 1
                            else:
                                old["source_record_count"] += 1
                                old["observer_labels"] = sorted(set(old["observer_labels"]) | {observer})
                                issues["duplicate_global_quota_observations_removed"] += 1
                    except (ValueError, TypeError, AttributeError, OverflowError, RecursionError):
                        issues["invalid_historical_metadata"] += 1
            stat = rollout.path.stat()
            if (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns) != rollout.signature:
                global_reasons.append("log_changed_during_historical_read")
        except OSError:
            global_reasons.append("historical_metadata_read_failed")
    global_reasons = sorted(set(global_reasons))
    setting_series = {sid: (sorted(values), [values[t] for t in sorted(values)]) for sid, values in settings.items()}
    dated = []
    for event, cost in rows:
        if not event.at:
            continue
        dates, values = setting_series.get(event.session_id, ([], []))
        n = bisect_right(dates, event.at) - 1
        mode, effort = values[n] if n >= 0 else ("unknown", "unknown")
        dated.append((event, cost, (event.model, mode, effort)))
    dated.sort(key=lambda item: item[0].at)
    times = [item[0].at for item in dated]
    amounts, unpriced = [Decimal(0)], [0]
    usage_prefixes = {field: [0] for field in FIELDS}
    for event, cost, profile in dated:
        amounts.append(amounts[-1] + cost.amount)
        unpriced.append(unpriced[-1] + (not cost.complete))
        for name in FIELDS:
            usage_prefixes[name].append(usage_prefixes[name][-1] + getattr(event.usage, name))
    ordered_series, snapshots_by_id = {}, {}
    serial = 0
    for key in sorted(observations):
        ordered = sorted(observations[key].items())
        for at, snap in ordered:
            serial += 1
            snap["id"] = f"historical-{serial}"
            snapshots_by_id[snap["id"]] = snap
        ordered_series[key] = ordered
    epochs, latest_by_epoch, current_by_pool, quota_edge_reasons = historical_quota_epochs(
        ordered_series, source_aware=_source_aware_epochs)
    sparse_profiles = defaultdict(set)
    for ordered in ordered_series.values():
        observation_times = [at for at, snap in ordered]
        for event, cost, profile in dated:
            n = min(bisect_left(observation_times, event.at), len(ordered) - 1)
            if n >= 0:
                at, snap = ordered[n]
                reset = timestamp(snap["identity_key"][3])
                if abs((at - event.at).total_seconds()) <= 1800 and reset - timedelta(minutes=snap["identity_key"][2]) <= event.at < reset:
                    sparse_profiles[snap["quota_epoch_id"]].add(profile)
    def identity_export(key):
        limit_id, window_kind, minutes, reset, plan = key
        return {"source_label": source_label, "account_label": account_label, "account_verified": False,
                "limit_id": limit_id, "window_kind": window_kind, "window_minutes": minutes,
                "resets_at": reset, "plan_type": plan, "source": "historical_log"}
    def profile_export(profile):
        return dict(zip(("model", "mode", "effort"), profile))
    def continuity_key(snap):
        return snap.get("continuity_identity_key", snap["identity_key"]) if _source_aware_epochs else snap["identity_key"]
    def snapshot_export(snap):
        result = {k: v for k, v in snap.items() if k not in ("identity_key", "continuity_identity_key")}
        if _source_aware_epochs:
            result.update(raw_identity=identity_export(snap["identity_key"]),
                          continuity_identity=identity_export(continuity_key(snap)))
        return result
    if _raw_graph_only:
        return historical_raw_graph(
            roots=roots, source_label=source_label, account_label=account_label, now=now, offsets=offsets,
            rollouts=rollouts, sessions=sessions, rows=rows, local=local, dated=dated, times=times,
            ordered_series=ordered_series, epochs=epochs, current_by_pool=current_by_pool,
            quota_edge_reasons=quota_edge_reasons, sparse_profiles=sparse_profiles, defects=defects,
            reset_session_models=reset_session_models, unknown_cache_sessions=unknown_cache_sessions,
            issues=issues, global_reasons=global_reasons, task_markers=task_markers,
            identity_export=identity_export, snapshot_export=snapshot_export,
            continuity_key=continuity_key), set(scanner.cache)
    def merge_usage(prior, item):
        for name in FIELDS:
            prior["usage"][name] += item["usage"][name]
        prior["cache_mix_complete"] = prior["cache_mix_complete"] and item["cache_mix_complete"]
        if _target_profile_ownership:
            for field in ("total_local_usage", "nuisance_local_usage"):
                for name in FIELDS:
                    prior[field][name] += item[field][name]
            for field in ("total_local_known_api_cost_usd", "nuisance_local_known_api_cost_usd",
                          "total_local_event_count", "nuisance_local_event_count", "nuisance_unpriced_event_count",
                          "nuisance_counter_reset_count"):
                prior[field] += item[field]
    def bounds_used(snap):
        return max(0, snap["used_percent"] - 1), min(100, snap["used_percent"] + 1)
    attempts, scenarios, fixed_grid_records = [], [], []
    for policy in policies:
        for offset in offsets:
            groups, active = defaultdict(list), None
            def flush():
                nonlocal active
                if active is None:
                    return
                active["span_seconds"] = (timestamp(active["after"]["observed_at"]) - timestamp(active["before"]["observed_at"])).total_seconds()
                if active["span_seconds"] < policy["min_span_seconds"]:
                    active["reasons"].append("block_shorter_than_minimum_span")
                if active["profile_key"] is None:
                    active["reasons"].append("no_local_usage")
                grid = active.get("fixed_grid")
                if grid and (active["before"]["id"] != grid["before_id"] or active["after"]["id"] != grid["after_id"]):
                    active["reasons"].append("incomplete_fixed_grid_block")
                active["status"] = "rejected" if active["reasons"] else "eligible"
                attempts.append(active)
                if active["profile_key"] is not None:
                    groups[(active["quota_epoch_id"], active["profile_key"])].append(active)
                active = None
            for series_key, ordered in ordered_series.items():
                flush()
                observation_times = [at for at, snap in ordered]
                target_span = (_block_span_seconds or {}).get(policy["id"])
                grid_edges, grid_records = historical_fixed_grid(ordered, target_span) if target_span else ({}, [])
                fixed_grid_records.extend({**r, "policy_id": policy["id"], "alignment_offset_seconds": offset} for r in grid_records)
                grid_owners = {}
                if _target_profile_ownership:
                    shift = timedelta(seconds=offset)
                    for grid in grid_records:
                        if grid["reasons"]:
                            continue
                        left_at = timestamp(snapshots_by_id[grid["before_id"]]["observed_at"]) + shift
                        right_at = timestamp(snapshots_by_id[grid["after_id"]]["observed_at"]) + shift
                        lo, hi = bisect_right(times, left_at), bisect_right(times, right_at)
                        grid_owners[grid["grid_id"]] = historical_target_owner(dated[lo:hi], grid["grid_id"])
                for (a_at, a), (b_at, b) in zip(ordered, ordered[1:]):
                    identity, epoch_id = continuity_key(a), a["quota_epoch_id"]
                    shift = timedelta(seconds=offset)
                    left, right = bisect_right(times, a_at + shift), bisect_right(times, b_at + shift)
                    profiles = sorted({item[2] for item in dated[left:right]})
                    profile = profiles[0] if len(profiles) == 1 else None
                    reasons = list(global_reasons)
                    grid = grid_edges.get((a["id"], b["id"]))
                    ownership = None
                    target_items = dated[left:right]
                    if _target_profile_ownership:
                        ownership = grid_owners.get(grid["grid_id"]) if grid else historical_target_owner([], None)
                        profile = ownership["profile_key"]
                        target_items = [item for item in dated[left:right] if item[2] == profile] if profile else []
                    if target_span and grid is None:
                        reasons.append("missing_fixed_grid_boundary")
                    gap = (b_at - a_at).total_seconds()
                    delta = b["used_percent"] - a["used_percent"]
                    reasons.extend(quota_edge_reasons[(a["id"], b["id"])])
                    if gap > policy["max_gap_seconds"]:
                        reasons.append("observation_gap_exceeds_policy")
                    if offset:
                        shifted_left, shifted_right = a_at + shift, b_at + shift
                        position = bisect_right(observation_times, shifted_left) - 1
                        stop = bisect_right(observation_times, shifted_right)
                        nearby = ordered[max(position, 0):stop]
                        if any(continuity_key(s) != identity for t, s in nearby):
                            reasons.append("alignment_crosses_quota_identity")
                        if any(s["conflict"] for t, s in nearby):
                            reasons.append("alignment_touches_conflicting_quota")
                        if any(s["quota_epoch_id"] != epoch_id for t, s in nearby):
                            reasons.append("alignment_crosses_quota_epoch")
                        reset = timestamp(identity[3])
                        if not reset - timedelta(minutes=identity[2]) <= shifted_left < shifted_right < reset:
                            reasons.append("alignment_outside_declared_cycle")
                        if _source_aware_epochs:
                            raw_keys = {s["identity_key"] for t, s in nearby} | {a["identity_key"], b["identity_key"]}
                            if any(not timestamp(raw[3]) - timedelta(minutes=raw[2]) <= shifted_left < shifted_right < timestamp(raw[3])
                                   for raw in raw_keys):
                                reasons.append("alignment_outside_declared_cycle")
                    if a["conflict"] or b["conflict"]:
                        reasons.append("conflicting_quota_observation")
                    for snap, at in ((a, a_at), (b, b_at)):
                        reset = timestamp(snap["identity_key"][3])
                        if not reset - timedelta(minutes=snap["identity_key"][2]) <= at < reset:
                            reasons.append("observation_outside_declared_cycle")
                        if snap["used_percent"] >= 100:
                            reasons.append("quota_saturated")
                    if len(profiles) > 1 and not _target_profile_ownership:
                        reasons.append("mixed_workload_interval")
                    checked_profiles = [profile] if _target_profile_ownership and profile else [] if _target_profile_ownership else profiles
                    if any("conflict" in p[1:] for p in checked_profiles):
                        reasons.append("conflicting_profile_metadata")
                    if any(p[0] == "unknown" for p in checked_profiles):
                        reasons.append("unknown_model")
                    if (any(not c.complete for e, c, p in target_items) if _target_profile_ownership else unpriced[right] > unpriced[left]):
                        reasons.append("incomplete_local_price")
                    if not profiles and delta != 0 and _block_span_seconds is None:
                        reasons.append("quota_change_without_local_usage")
                    touched, nuisance_resets = [], 0
                    for defect in defects:
                        start, end, kind, sid, details = defect
                        if _target_profile_ownership and kind == "counter_reset":
                            # Receipt attribution is (left,right], including
                            # offsets. A boundary event belongs to one edge.
                            overlaps = a_at + shift < start <= b_at + shift
                        else:
                            overlaps = ((start <= b_at + shift and end > a_at + shift) or
                                        (start == end and a_at + shift <= start <= b_at + shift))
                        if not overlaps:
                            continue
                        models = reset_session_models.get(sid, set())
                        nuisance_only = (_target_profile_ownership and kind == "counter_reset" and
                                         profile is not None and models and "unknown" not in models and
                                         profile[0] not in models)
                        if nuisance_only:
                            nuisance_resets += 1
                        else:
                            touched.append(defect)
                    reasons.extend(d[2] for d in touched)
                    item = {"policy_id": policy["id"], "alignment_offset_seconds": offset,
                            "identity_key": identity, "quota_epoch_id": epoch_id, "profile_key": profile, "before": a, "after": b,
                            "fixed_grid": grid,
                            "known_api_cost_usd": sum((c.amount for e, c, p in target_items), Decimal(0)) if _target_profile_ownership else amounts[right] - amounts[left], "delta_percent": delta,
                            "usage": ({name: sum(getattr(e.usage, name) for e, c, p in target_items) for name in FIELDS} if _target_profile_ownership else
                                      {name: values[right] - values[left] for name, values in usage_prefixes.items()}),
                            "cache_mix_complete": not any(e.session_id in unknown_cache_sessions for e, c, p in target_items),
                            "local_event_count": len(target_items), "zero_delta_interval_count": int(delta == 0),
                            "latest_local_event_at": dated[right - 1][0].at.isoformat() if right > left else None,
                            "atomic_interval_count": 1, "observed_profiles": profiles,
                            "reasons": sorted(set(reasons)), "span_seconds": gap,
                            "affected_session_count": len({d[3] for d in touched})}
                    if _target_profile_ownership:
                        total_usage = {name: values[right] - values[left] for name, values in usage_prefixes.items()}
                        item.update(ownership=ownership["export"],
                                    total_local_known_api_cost_usd=amounts[right] - amounts[left],
                                    nuisance_local_known_api_cost_usd=amounts[right] - amounts[left] - item["known_api_cost_usd"],
                                    total_local_usage=total_usage,
                                    nuisance_local_usage={name: total_usage[name] - item["usage"][name] for name in FIELDS},
                                    total_local_event_count=right - left, nuisance_local_event_count=right - left - len(target_items),
                                    nuisance_counter_reset_count=nuisance_resets,
                                    nuisance_unpriced_event_count=sum(not c.complete for e, c, p in dated[left:right] if p != profile))
                    if reasons:
                        flush()
                        item["status"] = "rejected"
                        attempts.append(item)
                        # A mixed interval is not apportioned into its profile scenarios.
                        for p in ([profile] if profile else []) if _target_profile_ownership else profiles:
                            groups[(epoch_id, p)].append(item)
                        continue
                    can_join = active and active["after"]["id"] == a["id"] and active["quota_epoch_id"] == epoch_id and active.get("fixed_grid") == grid and (
                        profile is None or active["profile_key"] is None or profile == active["profile_key"])
                    if not can_join:
                        flush()
                        active = item
                    else:
                        active["after"] = b
                        active["profile_key"] = active["profile_key"] or profile
                        active["observed_profiles"] = sorted(set(active["observed_profiles"] + profiles))
                        active["latest_local_event_at"] = item["latest_local_event_at"] or active["latest_local_event_at"]
                        for key in ("known_api_cost_usd", "delta_percent", "local_event_count", "zero_delta_interval_count", "atomic_interval_count"):
                            active[key] += item[key]
                        merge_usage(active, item)
                    if active is not None and grid is not None and b["id"] == grid["after_id"]:
                        flush()
                flush()
            # Even a cycle with only one snapshot gets a sparse, explicit scenario.
            for epoch_id, snap in latest_by_epoch.items():
                for profile in sparse_profiles[epoch_id]:
                    groups.setdefault((epoch_id, profile), [])
            for (epoch_id, profile), members in sorted(groups.items(), key=lambda pair: str(pair[0])):
                epoch = epochs[epoch_id]
                key = epoch["identity_key"]
                eligible = [item for item in members if item["status"] == "eligible"]
                cost = sum((item["known_api_cost_usd"] for item in eligible), Decimal(0))
                delta = sum(item["delta_percent"] for item in eligible)
                accepted_usage = {name: sum(item["usage"][name] for item in eligible) for name in FIELDS}
                coefficients = Counter()
                for item in eligible:
                    coefficients[item["before"]["id"]] -= 1
                    coefficients[item["after"]["id"]] += 1
                low, high = 0.0, 0.0
                for sid, coefficient in coefficients.items():
                    a_low, a_high = bounds_used(snapshots_by_id[sid])
                    low += coefficient * (a_low if coefficient >= 0 else a_high)
                    high += coefficient * (a_high if coefficient >= 0 else a_low)
                low, high = max(0, low), max(0, high)
                nominal = 100 * float(cost) / delta if cost > 0 and delta > 0 else None
                lower = 100 * float(cost) / high if cost > 0 and high > 0 else None
                upper = 100 * float(cost) / low if cost > 0 and low > 0 else None
                reasons = []
                if not eligible:
                    reasons.append("no_eligible_single_workload_blocks")
                if cost <= 0:
                    reasons.append("no_positive_local_cost")
                if delta <= 0:
                    reasons.append("no_positive_quota_delta")
                if delta < policy["min_delta_percent"]:
                    reasons.append("quota_delta_below_policy_signal_threshold")
                if nominal and (upper is None or (upper - lower) / nominal > 0.5):
                    reasons.append("wide_or_unbounded_quantization_range")
                if epoch["ambiguity_reasons"]:
                    reasons.append("quota_epoch_ambiguous")
                    reasons.extend(epoch["ambiguity_reasons"])
                if any(timestamp(item["after"]["observed_at"]) > now or
                       (item["latest_local_event_at"] and timestamp(item["latest_local_event_at"]) > now) for item in eligible):
                    reasons.append("calibration_after_analysis_time")
                total_ready = nominal is not None and not reasons and lower is not None and upper is not None
                latest = latest_by_epoch[epoch_id]
                reset = timestamp(key[3])
                remaining_reasons = []
                if latest["conflict"]:
                    remaining_reasons.append("conflicting_quota_observation")
                if epoch["ambiguity_reasons"]:
                    remaining_reasons.extend(("quota_epoch_ambiguous", *epoch["ambiguity_reasons"]))
                latest_at = timestamp(latest["observed_at"])
                if latest_at > now:
                    remaining_reasons.append("observation_after_analysis_time")
                if not reset - timedelta(minutes=key[2]) <= latest_at < reset:
                    remaining_reasons.append("observation_outside_declared_cycle")
                if latest["used_percent"] >= 100:
                    remaining_reasons.append("quota_saturated")
                latest_low, latest_high = bounds_used(latest)
                remain_nominal = nominal * (100 - latest["used_percent"]) / 100 if nominal is not None else None
                remain_low = lower * (100 - latest_high) / 100 if lower is not None else None
                remain_high = upper * (100 - latest_low) / 100 if upper is not None else None
                if not total_ready:
                    remaining_reasons.append("total_estimate_unavailable")
                if (remain_nominal is not None and (remain_high is None or remain_low is None or
                        remain_nominal <= 0 or (remain_high - remain_low) / remain_nominal > 0.5)):
                    remaining_reasons.append("wide_or_unbounded_remaining_quantization_range")
                pool_current = current_by_pool[key[:2]]
                in_cycle = reset - timedelta(minutes=key[2]) <= now < reset
                is_latest_epoch = pool_current["quota_epoch_id"] == epoch_id
                if latest_at > now:
                    scope = "future_observation_not_current"
                elif in_cycle and is_latest_epoch:
                    scope = "current_cycle_as_of" if pool_current["status"] == "observed" else "current_cycle_unknown"
                    if pool_current["status"] == "unknown":
                        remaining_reasons.append("current_quota_epoch_ambiguous")
                else:
                    scope = "historical_as_of"
                remaining_ready = remain_nominal is not None and not remaining_reasons
                points = [timestamp(item[end]["observed_at"]) for item in eligible for end in ("before", "after")]
                scenarios.append({"identity": identity_export(key), "quota_epoch_id": epoch_id,
                    "epoch_status": epoch["status"], "epoch_classification": epoch["classification"],
                    "epoch_started_at": epoch["started_at"], "epoch_ambiguity_reasons": list(epoch["ambiguity_reasons"]),
                    "profile": profile_export(profile),
                    "policy_id": policy["id"], "alignment_offset_seconds": offset,
                    "historical_period": {"start": min(points).isoformat() if points else None, "end": max(points).isoformat() if points else None},
                    "status": "conditional_estimate" if total_ready else "cannot_estimate",
                    "reasons": sorted(set(reasons)), "estimated_total_api_cost_usd": nominal if total_ready else None,
                    "total_quantization_range_usd": {"lower": lower if total_ready else None, "upper": upper if total_ready else None},
                    "diagnostics": {"nominal_total_api_cost_usd": nominal,
                                    "total_quantization_range_usd": {"lower": lower, "upper": upper},
                                    "nominal_remaining_api_cost_usd": remain_nominal,
                                    "remaining_quantization_range_usd": {"lower": remain_low, "upper": remain_high}},
                    "statistical_confidence_interval": None,
                    "observed": {"known_api_cost_usd": float(cost), "delta_percent": delta,
                                 "latest_local_event_at": max((item["latest_local_event_at"] for item in eligible if item["latest_local_event_at"]), default=None),
                                 "usage": accepted_usage, "cached_input_fraction": accepted_usage["cached_input_tokens"] / accepted_usage["input_tokens"] if accepted_usage["input_tokens"] else None,
                                 "delta_quantization_bounds": {"lower": low, "upper": high},
                                 "boundary_coefficient_weight": sum(abs(v) for v in coefficients.values())},
                    "exclusion_reasons": dict(sorted(Counter(reason for item in members if item["status"] == "rejected" for reason in item["reasons"]).items())),
                    "counts": {"eligible_blocks": len(eligible), "rejected_attempts": len(members) - len(eligible),
                               "candidate_local_events": sum(item["local_event_count"] for item in members),
                               "excluded_local_events": sum(item["local_event_count"] for item in members if item["status"] == "rejected"),
                               "excluded_known_api_cost_usd": float(sum((item["known_api_cost_usd"] for item in members if item["status"] == "rejected"), Decimal(0))),
                               "local_events": sum(item["local_event_count"] for item in eligible),
                               "zero_delta_intervals_retained": sum(item["zero_delta_interval_count"] for item in eligible)},
                    "remaining": {"estimated_remaining_api_cost_usd": remain_nominal if remaining_ready else None,
                                  "quantization_range_usd": {"lower": remain_low if remaining_ready else None, "upper": remain_high if remaining_ready else None},
                                  "snapshot_id": latest["id"], "observed_at": latest["observed_at"],
                                  "used_percent": latest["used_percent"], "remaining_percent": 100 - latest["used_percent"],
                                  "scope": scope, "is_live_lookup": False, "reasons": sorted(set(remaining_reasons)),
                                  "snapshot_age_seconds_at_analysis": (now - latest_at).total_seconds()}})
    # Compare the complete predeclared grid within one epoch/profile only.
    # Missing variants remain visible; no favorable variant is selected.
    sensitivity_groups = defaultdict(list)
    for scenario in scenarios:
        sensitivity_groups[(scenario["quota_epoch_id"], tuple(scenario["profile"].values()))].append(scenario)
    for members in sensitivity_groups.values():
        values = sorted(s["diagnostics"]["nominal_total_api_cost_usd"] for s in members
                        if s["diagnostics"]["nominal_total_api_cost_usd"] is not None)
        median = ((values[(len(values) - 1) // 2] + values[len(values) // 2]) / 2) if values else None
        spread = (values[-1] - values[0]) / median if median and median > 0 else None
        severe = spread is not None and spread > 0.5
        sensitivity = {"expected_variants": len(policies) * len(offsets), "available_variants": len(values),
                       "unavailable_variants": len(policies) * len(offsets) - len(values),
                       "nominal_min": min(values) if values else None, "nominal_max": max(values) if values else None,
                       "relative_spread": spread, "spread_denominator": "median_available_nominal",
                       "maximum_relative_spread": 0.5, "severe_divergence": severe}
        for scenario in members:
            scenario["sensitivity"] = dict(sensitivity)
            if severe:
                scenario["reasons"] = sorted(set(scenario["reasons"] + ["sensitivity_divergence"]))
                scenario["status"] = "cannot_estimate"
                scenario["estimated_total_api_cost_usd"] = None
                scenario["total_quantization_range_usd"] = {"lower": None, "upper": None}
                scenario["remaining"]["estimated_remaining_api_cost_usd"] = None
                scenario["remaining"]["quantization_range_usd"] = {"lower": None, "upper": None}
                scenario["remaining"]["reasons"] = sorted(set(scenario["remaining"]["reasons"] + ["sensitivity_divergence"]))
    model_totals = defaultdict(Bucket)
    for event, cost in rows:
        model_totals[event.model].add(event, cost)
    # Consecutive rejected edges with identical selection reasons are one
    # reviewable rejected block; retain their edge count and exact aggregate.
    # This changes output representation only, never the selection or estimator.
    compact_attempts = []
    for item in attempts:
        prior = compact_attempts[-1] if compact_attempts else None
        merge = prior and prior["status"] == item["status"] == "rejected" and prior["after"]["id"] == item["before"]["id"] and all(
            prior[key] == item[key] for key in ("affected_session_count", "policy_id", "alignment_offset_seconds", "identity_key", "quota_epoch_id", "profile_key", "observed_profiles", "reasons", "fixed_grid"))
        if merge and not item["affected_session_count"]:
            prior["after"] = item["after"]
            prior["latest_local_event_at"] = item["latest_local_event_at"] or prior["latest_local_event_at"]
            prior["span_seconds"] += item["span_seconds"]
            for key in ("known_api_cost_usd", "delta_percent", "local_event_count", "zero_delta_interval_count", "atomic_interval_count"):
                prior[key] += item[key]
            merge_usage(prior, item)
            prior["affected_session_count"] = max(prior["affected_session_count"], item["affected_session_count"])
        else:
            cloned = {**item, "usage": dict(item["usage"])}
            if _target_profile_ownership:
                cloned.update(total_local_usage=dict(item["total_local_usage"]), nuisance_local_usage=dict(item["nuisance_local_usage"]))
            compact_attempts.append(cloned)
    attempts = compact_attempts
    exported_attempts, reason_counts = [], Counter()
    for n, item in enumerate(attempts, 1):
        reason_counts.update({reason: item["atomic_interval_count"] for reason in item["reasons"]})
        exported_attempts.append({"id": f"attempt-{n}", "policy_id": item["policy_id"],
            "alignment_offset_seconds": item["alignment_offset_seconds"], "identity": identity_export(item["identity_key"]),
            "quota_epoch_id": item["quota_epoch_id"], "epoch_status": epochs[item["quota_epoch_id"]]["status"],
            "diagnostic_only": bool(epochs[item["quota_epoch_id"]]["ambiguity_reasons"]),
            "profile": profile_export(item["profile_key"]) if item["profile_key"] else None,
            "observed_profiles": [profile_export(p) for p in item["observed_profiles"]],
            "before": snapshot_export(item["before"]),
            "after": snapshot_export(item["after"]),
            **{k: item[k] for k in ("status", "reasons", "span_seconds", "delta_percent", "local_event_count",
                                   "zero_delta_interval_count", "atomic_interval_count", "affected_session_count", "latest_local_event_at")},
            "known_api_cost_usd": float(item["known_api_cost_usd"])})
        if _block_span_seconds is not None:
            exported_attempts[-1]["usage"] = dict(item["usage"])
            exported_attempts[-1]["cache_mix_complete"] = item["cache_mix_complete"]
            exported_attempts[-1]["fixed_grid"] = item.get("fixed_grid")
        if _target_profile_ownership:
            exported_attempts[-1].update({key: float(item[key]) if key.endswith("_cost_usd") else item[key]
                for key in ("ownership", "total_local_known_api_cost_usd", "nuisance_local_known_api_cost_usd",
                            "total_local_usage", "nuisance_local_usage", "total_local_event_count",
                            "nuisance_local_event_count", "nuisance_unpriced_event_count", "nuisance_counter_reset_count")})
    current_exports = []
    for key, state in current_by_pool.items():
        exported = {"limit_id": key[0], "window_kind": key[1], **state,
                    "latest_observed_quota_epoch_id": state["quota_epoch_id"], "analysis_time": now.isoformat()}
        if state["quota_epoch_id"] is not None:
            epoch = epochs[state["quota_epoch_id"]]
            reset = timestamp(epoch["identity_key"][3])
            if timestamp(state["last_observed_at"]) > now:
                exported.update(quota_epoch_id=None, status="unknown", reasons=["observation_after_analysis_time"])
            elif not reset - timedelta(minutes=epoch["identity_key"][2]) <= now < reset:
                exported.update(quota_epoch_id=None, status="unknown", reasons=["current_cycle_not_observed"])
        current_exports.append(exported)
    return {"schema_version": 2, "experimental": True, "kind": "historical_heuristic_quota_scenarios",
            **({"fixed_grid_blocks": fixed_grid_records} if _block_span_seconds is not None else {}),
            "quota_epochs": [{**{k: v for k, v in epoch.items() if k != "identity_key"},
                              "identity": identity_export(epoch["identity_key"])} for epoch in epochs.values()],
            "current_quota_epochs": current_exports,
            "trust_level": "historical_low_trust", "alternatives_not_additive": True,
            "status": "conditional_estimate" if any(s["estimated_total_api_cost_usd"] is not None for s in scenarios) else "cannot_estimate",
            "analyzed_at": now.isoformat(), "source": {"label": source_label, "account_label": account_label,
                  "account_verified": False, "selected_root_count": len(roots), "root_set_fingerprint": hashlib.sha256("\n".join(sorted(str(p.resolve()) for p in roots)).encode()).hexdigest()},
            "selection_policy": "all_attempts_all_policies_no_ratio_selection", "policies": list(policies),
            "analysis_clock_policy": "clock_only_not_log_cutoff; primary_future_evidence_withheld; backtests_require_truncated_input",
            "alignment_offsets_seconds": list(offsets), "quantization_assumption": {"endpoint_error_percentage_points": 1,
