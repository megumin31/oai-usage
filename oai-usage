def render_historical_segments(data: dict) -> str:
    counts = data["counts"]
    lines = ["EXPERIMENTAL historical heuristic — conditional, low trust",
             "Estimated totals are alternative local-workload API equivalents, not additive balances.",
             f"{counts['files']} files | {counts['sessions']} sessions | {counts['local_events']} deduplicated events | {counts['quota_observations']} global quota observations",
             f"{counts['eligible_blocks']}/{counts['attempted_blocks_or_rejected_intervals']} blocks/intervals eligible across all policies/offsets",
             "Display: medium / 0s; newest historical epoch per model by observation date, including unknowns, with separate profiles.",
             "Current-cycle cached rows also appear, including unknown estimates. Full nine-policy sensitivity and all attempts: --json/--output."]
    baseline = [row for row in data["model_scenarios"] if row["policy_id"] == "medium" and row["alignment_offset_seconds"] == 0]
    selected = []
    for model in data["observed_models"]:
        name = model["model"]
        rows = [row for row in baseline if row["profile"]["model"] == name]
        historical = [row for row in rows if row["remaining"]["scope"] == "historical_as_of"]
        lines.append(f"{name}: {model['token_events']} events | {model['usage']['total_tokens']} tokens | known local ${model['known_api_cost_usd']:.4f}")
        if historical:
            latest = max(historical, key=lambda row: row["epoch_started_at"])
            selected.extend(row for row in historical if row["quota_epoch_id"] == latest["quota_epoch_id"])
        if not any(row["estimated_total_api_cost_usd"] is not None for row in rows):
            reasons = sorted({reason for row in rows for reason in row["reasons"]}) or model["absence_reasons"] or ["no_baseline_profile_evidence"]
            lines.append("  Cannot estimate for medium / 0s: " + ", ".join(reasons))
        selected.extend(row for row in rows if row["remaining"]["scope"] in ("current_cycle_as_of", "current_cycle_unknown") and row not in selected)
    for current in data["current_quota_epochs"]:
        lines.append(f"Current {current['limit_id']}/{current['window_kind']}: {current['status']} | " +
                     (current['quota_epoch_id'] or "unknown epoch") + " | " + ", ".join(current["reasons"]))
    for row in selected:
        identity, profile = row["identity"], row["profile"]
        total, interval, remaining = row["estimated_total_api_cost_usd"], row["total_quantization_range_usd"], row["remaining"]
        def amount(value):
            return "unknown" if value is None else f"${value:.4f}"
        period = row["historical_period"]
        lines.append(f"{profile['model']} | mode={profile['mode']} effort={profile['effort']} | {row['status']} | {row['quota_epoch_id']} ({row['epoch_status']})")
        lines.append(f"  {identity['plan_type']} {identity['limit_id']}/{identity['window_kind']} {identity['window_minutes']}min reset={identity['resets_at']} | period {period['start']} → {period['end']}")
        lines.append(f"  Estimated total {amount(total)} | quantization-only [{amount(interval['lower'])}, {amount(interval['upper'])}]")
        lines.append(f"  Remaining ({remaining['scope']}, cached {remaining['observed_at']}, {remaining['remaining_percent']:g}%) {amount(remaining['estimated_remaining_api_cost_usd'])}")
        cache = row["observed"]["cached_input_fraction"]
        lines.append(f"  Blocks {row['counts']['eligible_blocks']} accepted / {row['counts']['rejected_attempts']} excluded | delta={row['observed']['delta_percent']:g}pp | cached-input fraction " + (f"{cache:.1%}" if cache is not None else "unknown"))
        if row["reasons"]:
            lines.append("  Signal: " + ", ".join(row["reasons"]))
    if not data["model_scenarios"]:
        lines.append("Cannot estimate: no historical model/window scenarios.")
    for reason, count in data["exclusion_reasons"].items():
        lines.append(f"Excluded atomic interval reason: {reason} ({count})")
    if data.get("price_catalog"):
        info = data["price_catalog"]
        lines.append(f"Prices: {info['catalog_source']} | verified {info['verified_at']}")
        lines.extend("Warning: " + warning for warning in info["warnings"])
    lines.extend("Warning: " + line for line in data["limitations"])
    return "\n".join(safe_text(line) for line in lines)



