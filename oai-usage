def bounds(args: argparse.Namespace, calendar: Calendar, now: datetime) -> tuple:
    if args.today:
        start = calendar.midnight(calendar.local(now).date())
    elif args.since:
        start = calendar.midnight(date.fromisoformat(args.since))
    else:
        days = 30 if args.days is None else args.days
        start = now - timedelta(days=days) if days else None
    end = calendar.midnight(date.fromisoformat(args.until) + timedelta(days=1)) if args.until else now
    if start and (start > end or (start == end and not args.today)):
        raise ValueError("Start must precede end; use both --since and --until for historical reports")
    return start, end


def report_bounds(args: argparse.Namespace, calendar: Calendar, now: datetime,
                  current: Optional[dict], estimates: dict) -> tuple:
    start, end = bounds(args, calendar, now)
    if args.today or args.since or args.until or args.days is not None:
        return start, end, {"selection": "explicit"}
    available = [(kind, estimate) for kind, estimate in estimates.items() if estimate["available"]]
    if available:
        # Prefer the longest validated account window; never infer a calendar reset.
        kind, estimate = max(available, key=lambda item: item[1]["period"]["window_minutes"])
        return timestamp(estimate["period"]["start"]), now, {
            "selection": "current_cycle", "cycle_window": kind,
            "cycle_resets_at": estimate["period"]["resets_at"]}
    reason = "Quota lookup is disabled" if current is None else current.get("error")
    if not reason:
        reason = "; ".join(dict.fromkeys(e["reason"] for e in estimates.values() if e.get("reason")))
    return start, end, {"selection": "fallback", "fallback_reason": reason or "No valid current quota window"}


def period_summaries(rows: list, summary: dict, period: dict, now: datetime) -> list:
    """Independent local totals; overlapping periods are never added together."""
    fields = Bucket().export().keys()
    selected = {"name": "Selected", "period": dict(period), "source": "local_session_logs",
                "summary": {**{key: summary[key] for key in fields},
                            "by_model": summary["by_model"], "by_model_detail": summary["by_model_detail"]}}
    periods = [selected]
    start = now - timedelta(days=30)
    if timestamp(period["start"]) == start and timestamp(period["end"]) == now:
        selected["also_last_30_days"] = True
        return periods
    local, models = Bucket(), defaultdict(Bucket)
    for event, cost in rows:
        if included(event.at, start, now):
            local.add(event, cost)
            models[event.model].add(event, cost)
    periods.append({"name": "Last 30 days", "source": "local_session_logs",
                    "period": {"start": start.isoformat(), "end": now.isoformat(),
                               "timezone": period["timezone"], "end_exclusive": True},
                    "summary": {**local.export(),
                                "by_model": {key: asdict(value.usage) for key, value in sorted(models.items())},
                                "by_model_detail": {key: value.export() for key, value in sorted(models.items())}}})
    return periods


@dataclass
class ReportCache:
    revision: int = -1
    prices_key: tuple = ()
    sessions: list = field(default_factory=list)
    issues: Counter = field(default_factory=Counter)
    rows: list = field(default_factory=list)
    times: list = field(default_factory=list)
    summary_key: tuple = ()
    summary: dict = field(default_factory=dict)

    def prepare(self, scanner: Scanner, rollouts: list, prices: dict) -> None:
        prices_key = tuple(sorted(prices.items()))
        if self.revision != scanner.revision or self.prices_key != prices_key:
            self.sessions, self.issues = account(rollouts)
            self.rows = priced_events(self.sessions, prices)
            self.times = sorted(e.at for e, _ in self.rows if e.at is not None)
            self.revision = scanner.revision
            self.prices_key = prices_key
            self.summary_key = ()

    def summarize(self, calendar: Calendar, start: Optional[datetime], end: Optional[datetime], by: str) -> dict:
        # A sliding time window needs recomputing only when it crosses an event.
        lo = bisect_left(self.times, start) if start else 0
        hi = bisect_left(self.times, end) if end else len(self.times)
        key = (self.revision, calendar.name, lo, hi, start is None and end is None, by)
        if key != self.summary_key:
            self.summary = aggregate(self.rows, self.sessions, calendar, start, end, by)
            self.summary_key = key
        return copy.deepcopy(self.summary)


def report(args: argparse.Namespace, scanner: Scanner, prices: dict, calendar: Calendar,
           roots: list, cache: Optional[ReportCache] = None,
           price_catalog: Optional[PriceCatalog] = None, live: tuple = (None, None)) -> dict:
    # The scheduler observes quota before this synchronous scan. Projection
    # cutoff remains the snapshot time even if more logs arrived meanwhile.
    if price_catalog is None:
        raise ValueError("A validated price catalog is required")
    rollouts = scanner.scan(roots)
    now = datetime.now(UTC)
    cache = cache or ReportCache()
    cache.prepare(scanner, rollouts, prices)
    rows = cache.rows
    issues = cache.issues.copy()
    issues.update(scanner.issues)
    current = quota_status(args.quota, rollouts, live, now, args.limit_id)
    estimates = projections(rows, current, now)
    start, end, selection = report_bounds(args, calendar, now, current, estimates)
    summary = cache.summarize(calendar, start, end, args.by)
    summary["current_rate_limits"] = current
    summary["cycle_estimates"] = estimates
    period = {"start": start.isoformat() if start else None, "end": end.isoformat() if end else None,
              "timezone": calendar.name, "end_exclusive": True, **selection}
    return {"version": VERSION, "generated_at": now.isoformat(),
            "period": period, "period_summaries": period_summaries(rows, summary, period, now),
            "roots": [str(p) for p in roots],
            "projection_assumptions": ["Account usage primarily occurs on this machine", "Quota consumption is approximately proportional to local API-equivalent cost",
                "Future model and cache mix remains similar", "Account percentages may be rounded", "Account ownership of log snapshots cannot be independently verified"],
            "pricing": {"basis": "standard_api_equivalent",
                **catalog_info(price_catalog),
                "historical_price_schedule": False,
                "excluded": ["tools", "regional_uplift", "fast_or_priority_service", "subscription_billing"],
                "models": {k: {"input": str(p.input), "cached_input": str(p.cached) if p.cached is not None else None, "output": str(p.output),
                    "cache_write": str(p.write) if p.write is not None else None,
                    "long_context_threshold": p.long_threshold,
                    "long_input": str(p.long_input) if p.long_input is not None else None,
                    "long_cached_input": str(p.long_cached) if p.long_cached is not None else None,
                    "long_cache_write": str(p.long_write) if p.long_write is not None else None,
                    "long_output": str(p.long_output) if p.long_output is not None else None,
                    "source": p.source}
                    for k, p in sorted(prices.items())}},
            "diagnostics": {"files": len(rollouts), "issues": dict(sorted(issues.items())),
                            "bytes_read_this_process": scanner.bytes_read},
            "summary": summary, "sessions": summary["by_session"]}


def safe_text(value: Any) -> str:
    # Logs and model names can contain terminal control sequences.
    return "".join(c for c in str(value) if not unicodedata.category(c).startswith("C"))


def width(value: str) -> int:
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in value)


def fit(value: Any, limit: int) -> str:
    text = safe_text(value)
    if width(text) <= limit:
        return text
    out = ""
    for c in text:
        if width(out + c) > limit - 1:
            return out + "…"
        out += c
    return out


def money(row: dict) -> str:
    value = row.get("api_cost_usd")
    if value is not None:
        return f"${value:,.4f}"
    known = row.get("known_api_cost_usd", 0)
    return f"${known:,.4f} + unknown" if known else "unknown"


def table(headers: list, rows: list, terminal_width: int = 120, numeric_limit: Optional[int] = 18) -> list:
    if not rows:
        return ["  No records"]
    first_width = max(12, min(40, terminal_width - 56))
    limits = [first_width] + [numeric_limit] * (len(headers) - 1)
    clean = [[fit(v, limits[i]) if limits[i] is not None else safe_text(v)
              for i, v in enumerate(row)] for row in [headers] + rows]
    widths = [max(width(row[i]) for row in clean) for i in range(len(headers))]
    lines = []
    for index, row in enumerate(clean):
        cells = [(v + " " * (widths[i] - width(v))) if i == 0 else (" " * (widths[i] - width(v)) + v) for i, v in enumerate(row)]
        lines.append("  " + "  ".join(cells))
        if index == 0:
            lines.append("  " + "  ".join("─" * n for n in widths))
    return lines


def percentage(part: int, whole: int) -> str:
    return f"{part / whole:.1%}" if whole else "-"


def wrap_cells(value: str, limit: int) -> list:
    text = safe_text(value)
    rows = []
    while width(text) > limit:
        end, cells = 0, 0
        for char in text:
            if cells + width(char) > limit:
                break
            end += 1
            cells += width(char)
        split = text.rfind(" ", 0, end + 1)
        cut = split if split > 0 else max(1, end)
        rows.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    return rows + [text]


def panel(title: str, rows: list, columns: int, wrap: bool = True) -> list:
    columns = max(8, columns)
    inner = columns - 4
    heading = fit(title, columns - 5)
    top = "╭─ " + heading + " " + "─" * max(0, columns - width(heading) - 5) + "╮"
    body = []
    for raw in rows:
        for row in wrap_cells(raw, inner) if wrap else [fit(raw, inner)]:
            body.append("│ " + row + " " * (inner - width(row)) + " │")
    return [top, *body, "╰" + "─" * (columns - 2) + "╯"]


def side_by_side(cards: list, columns: int) -> list:
    left, right = cards
    left_width = width(left[0])
    lines = []
    for i in range(max(len(left), len(right))):
        a = left[i] if i < len(left) else " " * left_width
        b = right[i] if i < len(right) else ""
        lines.append(fit(a + "  " + b, columns))
    return lines


def progress(used: Optional[float], columns: int) -> str:
    if used is None:
        return "Quota usage unavailable"
    remaining = max(0, min(100, 100 - used))
    bar_width = max(4, min(30, columns - 35))
    filled = round(bar_width * max(0, min(100, used)) / 100)
    return "█" * filled + "░" * (bar_width - filled) + f"  {used:g}% used · {remaining:g}% left"


def cycle_card(kind: str, estimate: dict, calendar: Calendar, columns: int, compact: bool,
               window: Optional[dict] = None) -> list:
    title = "Current cycle · " + kind.replace("_", " ").title()
    if not estimate["available"]:
        body = ["Local cycle unavailable: " + (estimate.get("reason") or "Insufficient data")]
        if window:
            body = ["Account: " + progress(window.get("used_percent"), columns - 12),
                    "Resets " + calendar.display(timestamp(window.get("resets_at_utc"))), *body]
        return panel(title, body, columns)
    period, account, local = estimate["period"], estimate["account_usage"], estimate["local"]
    usage = local["usage"]
    partial = local["estimate_is_partial"]
    if partial:
        title += " · PARTIAL"
    body = ["Account: " + progress(account.get("used_percent"), columns - 12)]
    if not local["token_events"]:
        body.append("No local usage records in this cycle")
    local_cost = f"${local['known_api_cost_usd']:,.6f}" + (" + unknown" if partial else "")
    total = f"~${estimate['projected_full_cycle_known_api_cost_usd']:,.4f}" if estimate["projection_available"] else "unavailable"
    remaining = f"~${estimate['projected_remaining_known_api_cost_usd']:,.4f}" if estimate["projection_available"] else "unavailable"
    if columns >= 90:
        cell = (columns - 8) // 3
        labels = ("LOCAL API COST", "EST. TOTAL", "EST. REMAINING")
        values = (local_cost, total, remaining)
        body += ["", "  ".join(s.ljust(cell) for s in labels),
                 "  ".join(fit(s, cell).ljust(cell) for s in values), ""]
    else:
        body += [f"Local Cost Used: {local_cost}", f"Est. Total: {total}", f"Est. Remaining: {remaining}"]
    # Actual dates identify the cycle. Its length can change or be reset early.
    display = (lambda v: calendar.local(timestamp(v)).strftime("%m-%d %H:%M")) if compact else (lambda v: calendar.display(timestamp(v)))
    if compact:
        body.append(f"{display(period['start'])} → {display(period['resets_at'])}")
        body.append(f"Local through {display(period['as_of'])} · {usage['total_tokens']:,} tokens")
    else:
        body += ["Started  " + display(period["start"]), "Resets   " + display(period["resets_at"]),
                 "Local through " + display(period["as_of"]), "",
                 f"Tokens: {usage['total_tokens']:,} total · {usage['input_tokens']:,} in · {usage['cached_input_tokens']:,} cached · {usage['output_tokens']:,} out",
                 f"Cache write: {usage['cache_write_input_tokens']:,} · Reasoning: {usage['reasoning_output_tokens']:,}",
                 f"Sessions: {local['sessions']:,} · Events: {local['token_events']:,}"]
        missing = local["unpriced_usage"]["total_tokens"] + local["uncertain_pricing_usage"]["total_tokens"]
        body.append(f"Fully priced tokens: {percentage(usage['total_tokens'] - missing, usage['total_tokens'])}")
    if not estimate["projection_available"] and not compact:
        body.append("Projection unavailable: " + (estimate.get("reason") or "Insufficient data"))
    return panel(title, body, columns, wrap=not compact or columns < 40)


def cycle_lines(estimates: dict, calendar: Calendar, compact: bool = False, columns: int = 120,
                windows: Optional[dict] = None) -> list:
    items = list(estimates.items())
    windows = windows or {}
    lines = []
    # Paired cards keep every cycle's money visible in a standard watch screen.
    if compact and len(items) == 2 and columns >= 96:
        size = (columns - 2) // 2
        cards = [cycle_card(kind, value, calendar, size, True, windows.get(kind)) for kind, value in items]
        return side_by_side(cards, columns)
    for kind, value in items:
        if lines:
            lines.append("")
        lines += cycle_card(kind, value, calendar, columns, compact, windows.get(kind))
    return lines


def style_line(line: str) -> str:
    """Add trusted ANSI styles only after all layout and clipping is complete."""
    if "OAI USAGE" in line:
        return "\033[1;36m" + line + "\033[0m"
    if line.startswith("Report: "):
        return "\033[2m" + line + "\033[0m"
    if line.startswith(("╭", "╰", "├")):
        return "\033[36m" + line + "\033[0m"
    if "LOCAL API COST" in line:
        return "\033[2m" + line.replace("│", "\033[36m│\033[0;2m") + "\033[0m"
    def color_bar(match: re.Match) -> str:
        bar, gap, used_text = match.group(1, 2, 3)
        used = float(used_text)
        color = "31" if used >= 85 else "33" if used >= 60 else "32"
        bar = re.sub(r"█+", lambda m: f"\033[{color}m{m[0]}\033[0m", bar)
        bar = re.sub(r"░+", lambda m: f"\033[2m{m[0]}\033[0m", bar)
        return bar + gap + used_text + "% used"
    line = re.sub(r"([█░]+)( +)([-\d.]+)% used", color_bar, line)
    line = re.sub(r"~?\$[\d,]+(?:\.\d+)?", lambda m: f"\033[1;32m{m[0]}\033[0m", line)
    line = re.sub(r"\b(?:unknown|unavailable|PARTIAL|expired)\b", lambda m: f"\033[33m{m[0]}\033[0m", line)
    return line.replace("│", "\033[36m│\033[0m")


def terminal_ansi() -> tuple:
    """Enable Windows VT output; return support and an optional mode restore."""
    if not WINDOWS or not sys.stdout.isatty():
        return True, None
    try:
        import ctypes
        import msvcrt
        from ctypes import wintypes

        console = ctypes.WinDLL("kernel32", use_last_error=True)
        console.GetConsoleMode.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
        console.GetConsoleMode.restype = wintypes.BOOL
        console.SetConsoleMode.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        console.SetConsoleMode.restype = wintypes.BOOL
        handle = wintypes.HANDLE(msvcrt.get_osfhandle(sys.stdout.fileno()))
        mode = wintypes.DWORD()
        if not console.GetConsoleMode(handle, ctypes.byref(mode)):
            return False, None
        # Preserve existing flags; VT also requires processed output.
        requested = mode.value | 0x0001 | 0x0004
        if requested == mode.value:
            return True, None
        if not console.SetConsoleMode(handle, requested):
            return False, None
        return True, lambda: console.SetConsoleMode(handle, mode.value)
    except (ImportError, OSError, ValueError):
        return False, None


def usage_rows(row: dict) -> list:
    tokens = row["usage"]
    return [f"Input {tokens['input_tokens']:,} · Cached {tokens['cached_input_tokens']:,} · Output {tokens['output_tokens']:,} · Reasoning {tokens['reasoning_output_tokens']:,} · Total {tokens['total_tokens']:,}",
            f"Cache write {tokens['cache_write_input_tokens']:,} · Cached/In {percentage(tokens['cached_input_tokens'], tokens['input_tokens'])} · Out/Total {percentage(tokens['output_tokens'], tokens['total_tokens'])}",
            f"API cost {money(row)} · Sessions {row['sessions']:,} · Events {row['token_events']:,}"]


def statistics_rows(entries: list, columns: int, total: bool = True, name: str = "Name") -> tuple:
    """Shared period/model layout, with a lossless narrow-screen fallback."""
    inner = columns - 4
    if columns >= 120 and entries:
        rows = []
        for key, row in entries:
            tokens = row["usage"]
            total_cell = (f"{tokens['total_tokens']:,}",) if total else ()
            rows.append((key, f"{tokens['input_tokens']:,}", f"{tokens['cached_input_tokens']:,}",
                         f"{tokens['output_tokens']:,}", f"{tokens['reasoning_output_tokens']:,}", *total_cell,
                         percentage(tokens['cached_input_tokens'], tokens['input_tokens']),
                         percentage(tokens['output_tokens'], tokens['total_tokens']), money(row)))
        headers = [name, "Input", "Cached", "Output", "Reasoning"] + (["Total"] if total else [])
        table_lines = [line[2:] for line in table(headers + ["Cached/In", "Out/Total", "API Cost"], rows, inner,
                                               numeric_limit=None)]
        if all(width(line) <= inner for line in table_lines):
            return table_lines, True
    body = []
    for key, row in entries:
        if body:
            body.append("")
        body += [f"{safe_text(key)} · API cost {money(row)}", *usage_rows(row)[:2],
                 f"Sessions {row['sessions']:,} · Events {row['token_events']:,}"]
    return body, False


def periods_panel(data: dict, args: argparse.Namespace, calendar: Calendar, columns: int) -> list:
    summary, selected = data["summary"], data["period"]
    # Older callers can still render the original report shape without new keys.
    periods = data.get("period_summaries") or [{"name": "Selected", "period": selected, "summary": summary}]
    lines = []
    for item in periods:
        period, row = item["period"], item["summary"]
        selection = period.get("selection")
        is_selected = item["name"] == "Selected"
        if is_selected:
            title = "This cycle · Selected" if selection == "current_cycle" else "Selected period"
            if item.get("also_last_30_days"):
                title = "Last 30 days · Selected"
        else:
            title = "Last 30 days · Reference"
        body = ["Usage source: Local Codex session logs",
                f"From {calendar.display(timestamp(period['start']))} → {calendar.display(timestamp(period['end']))}"]
        if is_selected and selection == "current_cycle":
            body.append("Cycle window: " + period["cycle_window"].replace("_", " ").title())
        elif is_selected and selection == "fallback":
            body.append("Fallback: last 30 days · " + safe_text(period["fallback_reason"]))
        elif is_selected and selection == "explicit":
            body.append("Explicit date range")
        if item.get("also_last_30_days"):
            body.append("Selected also covers the last 30 days")
        elif not is_selected:
            body.append("Reference · periods may overlap; totals are separate")
        if data.get("pricing"):
            pricing = data["pricing"]
            body.append(f"Prices: {pricing['catalog_source']} · checked {pricing['verified_at']}" + (" · STALE" if pricing.get("stale") else ""))
        body += ["", "By model"]
        entries = sorted(row["by_model_detail"].items(), key=lambda value: (-value[1]["usage"]["total_tokens"], value[0]))
        shown = entries[:args.top] if args.top else entries
        if not entries:
            body.append("No local usage records in this cycle" if is_selected and selection == "current_cycle"
                        else "No local usage records in this report period")
        # The footer uses the full period bucket, including models hidden by --top.
        # Ratios are recalculated from aggregate counters; session counts stay unique.
        model_rows, _ = statistics_rows([*shown, ("Total", row)], columns)
        body += model_rows
        if len(shown) < len(entries):
            body.append(f"Showing {len(shown)}/{len(entries)} models; Total covers all models. --top 0 shows all. JSON is always complete.")
        if lines:
            lines.append("")
        lines += panel(title, body, columns)
    return lines


def account_panel(current: dict, estimates: dict, args: argparse.Namespace,
                  calendar: Calendar, compact: bool, columns: int) -> list:
    title = "Account quota & Current cycle" if args.project else "Account quota"
    if current.get("source") == "unavailable" or current.get("error"):
        return panel(title, ["Unavailable: " + safe_text(current.get("error") or "Quota unavailable")], columns)
    bid = current["active_limit_id"]
    bucket = current["limits"][bid]
    source = "LIVE" if current["source"] == "app_server" else "LOG SNAPSHOT"
    age = bucket.get("snapshot_age_seconds")
    age_label = f"{age}s ago" if age is not None else "time unknown"
    body = [f"{source} · {safe_text(bid)} · {safe_text(bucket.get('plan_type') or 'plan unknown')} · {age_label}"]
    if any((bucket.get(kind) or {}).get("used_percent", 0) or 0
           for kind in ("primary", "secondary", "individual_limit")):
        body.append("Quota is account-wide; local logs cover only recorded local sessions.")
    if args.project and estimates:
        body += cycle_lines(estimates, calendar, compact, columns - 4, bucket)
    else:
        for kind in ("primary", "secondary", "individual_limit"):
            window = bucket.get(kind)
            if window:
                stale = " [expired]" if window.get("expired") else ""
                body += [f"{kind.replace('_', ' ').title()}: {progress(window.get('used_percent'), columns - 20)}{stale}",
                         "Resets " + calendar.display(timestamp(window.get("resets_at_utc")))]
        if args.project:
            body.append("Local cycle unavailable: No quota windows available")
    if len(current["limits"]) > 1:
        body.append("Other buckets: " + ", ".join(safe_text(k) for k in sorted(current["limits"]) if k != bid) + " (--limit)")
    if current.get("fallback_reason"):
        body.append("Fallback: " + safe_text(current["fallback_reason"]))
    credits = bucket.get("credits")
    if credits:
        balance = safe_text(credits.get("balance") if credits.get("balance") is not None else "unknown")
        body.append(f"Credits: {'unlimited' if credits.get('unlimited') else balance}")
    reset_credits = current.get("rate_limit_reset_credits")
    if reset_credits:
        body.append(f"Reset credits available: {reset_credits['available_count']}")
    return panel(title, body, columns)


def render(data: dict, args: argparse.Namespace, calendar: Calendar, columns: int = 120) -> str:
    columns = max(8, min(columns, 140))
    compact = args.command == "watch"
    summary, period = data["summary"], data["period"]
    current = summary["current_rate_limits"]
    source = {"app_server": "LIVE", "session_log": "LOG SNAPSHOT", "unavailable": "QUOTA UNAVAILABLE"}.get(
        current.get("source") if current else None, "LOCAL LOGS")
    lines = [f"OAI USAGE  {VERSION}   /   USAGE & QUOTA",
             f"Report: {calendar.display(timestamp(period['start']))} → {calendar.display(timestamp(period['end']))} · {source}"]
    if current:
        lines += account_panel(current, summary["cycle_estimates"], args, calendar, compact, columns)
        lines.append("")

    selection = period.get("selection")
    empty_message = ("No local usage records in this cycle" if selection == "current_cycle"
                     else "No local usage records in this report period")
    lines += periods_panel(data, args, calendar, columns)

    dimensions = ["model", "day", "session"] if args.all_dimensions else [args.by]
    for by in dimensions:
        if by == "model":
            continue  # Every period already includes its own model breakdown.
        if by == "session":
            entries = [(r["session_id"], r) for r in summary["by_session"]]
            title = "By session (including independent subtasks)"
        else:
            entries = list((summary["by_day"] if by == "day" else summary["groups"]).items())
            title = {"day": "By day", "week": "By week", "month": "By month"}[by]
        entries.sort(key=(lambda row: (-row[1]["usage"]["total_tokens"], row[0])) if by in ("model", "session") else (lambda row: row[0]),
                     reverse=by not in ("model", "session"))
        shown = entries[:args.top] if args.top else entries
        body, _ = statistics_rows(shown, columns, total=by == "model")
        if not body:
            body.append(empty_message)
        if len(shown) < len(entries):
            body.append(f"Showing {len(shown)}/{len(entries)} entries; --top 0 shows all. JSON is always complete.")
        lines += ["", *panel(title, body, columns)]
    issues = data["diagnostics"]["issues"]
    warnings = [(ISSUES.get(k, k), v) for k, v in issues.items() if v and k not in (
        "inherited_snapshots_excluded", "duplicate_snapshots_removed", "events_without_request_detail", "inherited_baseline_tokens_excluded",
        "duplicate_usage_records_removed", "inherited_usage_records_excluded")]
    if summary["unpriced_models"]:
        warnings.append(("Unpriced models", ", ".join(safe_text(v) for v in summary["unpriced_models"])))
    if summary["undated_events_excluded"]:
        warnings.append(("Undated events excluded", summary["undated_events_excluded"]))
    warnings.extend(("Prices", message) for message in data.get("pricing", {}).get("warnings", []))
    if warnings:
        lines += ["", *panel("Data notes", [f"{label}: {value}" for label, value in warnings], columns)]
    lines += ["", "Standard API equivalent · not a subscription bill · tools/Fast/regional charges excluded."]
    if args.project and current:
        lines.append("Estimates = local cycle cost / account usage fraction; assume usage primarily on this machine.")
    if not summary["token_events"]:
        lines += wrap_cells("Try --days all or --root to select local log directories.", columns)
    return "\n".join(fit(line, columns) for line in lines)


def write_json(path: Path, data: dict, protected: set) -> None:
    path = path.expanduser()
    if path.resolve() in protected or path.suffix.lower() == ".jsonl":
        raise ValueError("Output cannot overwrite the program or session JSONL logs; choose a separate .json file")
    encoded = json.dumps(data, ensure_ascii=False, indent=2, allow_nan=False) + "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", prefix=".oai-usage-", dir=path.parent, delete=False) as handle:
            name = handle.name
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
        name = None
    finally:
        if name:
            Path(name).unlink(missing_ok=True)


# Opt-in experiment. Deliberately separate from rollout parsing and the dashboard.
SEGMENT_ASSERTIONS = ("complete_local_receipts", "no_other_device_usage", "no_boundary_inflight",
                      "settlement_assumed", "pool_attribution")
SEGMENT_CONTEXT = {"account_key", "plan_type", "limit_id", "window_kind", "mode"}
SEGMENT_MIN_SIGNAL = 5.0
SEGMENT_MAX_RELATIVE_ERROR = 0.5
SEGMENT_LIMITATIONS = [
    "Conditional local-workload API equivalent; not an official quota, account cost, or dollar balance.",
    "Account percentages are authoritative; this experiment does not replace the normal quota report.",
    "RPC receipt time is not quota measurement time. Freshness and settlement cannot be verified.",
    "Account, pool attribution, completeness, no concurrent device use, and settlement are user assertions.",
    "Delayed posting, cached quota, hidden other-device usage, and workload changes can invalidate the result.",
    "The range covers declared percentage quantization only; it is not a statistical confidence interval.",
    "No held-out accuracy validation or future-workload guarantee is supplied.",
]


def segment_keys(value: Any, required: set, label: str) -> None:
    if not isinstance(value, dict) or set(value) != required:
        raise ValueError(f"{label}: expected exactly {', '.join(sorted(required))}")


def segment_text(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip() or len(value) > 200 or any(ord(c) < 32 for c in value):
        raise ValueError(f"{label}: expected nonempty text without control characters (max 200)")
    return value


def segment_time(value: Any, label: str) -> datetime:
    if not isinstance(value, str):
        raise ValueError(f"{label}: expected an ISO timestamp with an explicit timezone")
    try:
        at = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if at.tzinfo is None or at.utcoffset() is None:
            raise ValueError()
        return at.astimezone(UTC)
    except (ValueError, OverflowError):
        raise ValueError(f"{label}: expected an ISO timestamp with an explicit timezone")


def segment_number(value: Any, label: str, low: float, high: float) -> float:
    if type(value) not in (int, float) or not math.isfinite(value) or not low <= value <= high:
        raise ValueError(f"{label}: expected a finite number from {low:g} through {high:g}")
    return float(value)


def segment_context(value: Any) -> dict:
    segment_keys(value, SEGMENT_CONTEXT, "context")
    for key, item in value.items():
        segment_text(item, key)
    if value["window_kind"] not in ("primary", "secondary", "individual_limit"):
        raise ValueError("context: unknown window_kind")
    return dict(value)


def read_segment_json(path: Path) -> Any:
    # Bounded, duplicate-key rejecting input. Only explicit files are ever opened.
    with path.open("rb") as handle:
        data = handle.read(8 * MAX_BYTES + 1)
    if len(data) > 8 * MAX_BYTES:
        raise ValueError("Experimental input exceeds 8 MB")
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError("Duplicate experimental JSON key")
            result[key] = value
        return result
    def invalid(value):
        raise ValueError("Non-finite experimental JSON number")
    try:
        return json.loads(data, object_pairs_hook=pairs, parse_constant=invalid)
    except (RecursionError, UnicodeDecodeError) as exc:
        raise ValueError("Invalid experimental JSON encoding or nesting") from exc


def segment_snapshot(raw: Any) -> dict:
    segment_keys(raw, {"id", "context", "capture_started_at", "observed_at", "window_minutes",
                       "resets_at", "used_percent", "percent_resolution", "source",
                       "observation_basis"}, "snapshot")
    segment_text(raw["id"], "snapshot id")
    segment_context(raw["context"])
    start = segment_time(raw["capture_started_at"], "capture_started_at")
    at = segment_time(raw["observed_at"], "observed_at")
    reset = segment_time(raw["resets_at"], "resets_at")
    if start > at:
        raise ValueError("snapshot: capture_started_at is after observed_at")
    if type(raw["window_minutes"]) is not int or not 1 <= raw["window_minutes"] <= 5256000:
        raise ValueError("snapshot: window_minutes must be a positive integer (at most 5256000)")
    segment_number(raw["used_percent"], "used_percent", 0, 100)
    # v1 deliberately cannot claim precision better than one percentage point.
    segment_number(raw["percent_resolution"], "percent_resolution", 1, 100)
    if raw["source"] not in ("app_server_rpc", "user_observation", "historical_log"):
        raise ValueError("snapshot: unknown source")
    if raw["observation_basis"] != "retrieved_not_measured":
        raise ValueError("snapshot: observation_basis must be retrieved_not_measured")
    result = dict(raw)
    result.update(_start=start, _at=at, _reset=reset)
    return result


def analyze_segments(raw: Any, prices: dict, *, _details: Optional[dict] = None) -> dict:
    """Analyze declared attempts, never discover activity boundaries or infer freshness.

    Each exact window/reset/source group fails closed if an attempt is ineligible:
    dropping a bad interval after observing its delta would select the result.
    Independent reset identities are reported separately, never fitted together.
    """
    if isinstance(raw, dict) and type(raw.get("schema_version")) is int and raw["schema_version"] == 2:
        return analyze_model_segments(raw, prices)
    segment_keys(raw, {"schema_version", "context", "workload", "collection_period", "selection_policy",
                       "snapshots", "segments", "receipts"}, "manifest")
    if type(raw["schema_version"]) is not int or raw["schema_version"] != 1:
        raise ValueError("Unsupported experimental schema_version")
    context = segment_context(raw["context"])
    segment_keys(raw["workload"], {"label", "models", "effort"}, "workload")
    workload = raw["workload"]
    segment_text(workload["label"], "workload label")
    segment_text(workload["effort"], "workload effort")
    models = workload["models"]
    if not isinstance(models, list) or not models or any(not isinstance(m, str) for m in models):
        raise ValueError("workload.models must be a nonempty list of exact model IDs")
    for model in models:
        segment_text(model, "model")
    if len(set(models)) != len(models):
        raise ValueError("workload.models contains duplicates")
    if raw["selection_policy"] != "all_attempted_segments":
        raise ValueError("selection_policy must be all_attempted_segments; do not select by observed ratios")
    segment_keys(raw["collection_period"], {"start", "end"}, "collection_period")
    period_start = segment_time(raw["collection_period"]["start"], "collection start")
    period_end = segment_time(raw["collection_period"]["end"], "collection end")
    if period_start >= period_end:
        raise ValueError("collection_period must have positive duration")
    for key in ("snapshots", "segments", "receipts"):
        if not isinstance(raw[key], list) or len(raw[key]) > 100000:
            raise ValueError(f"{key}: expected a list with at most 100000 items")
    snapshots, duplicate_snapshots, observations = {}, 0, {}
    for item in raw["snapshots"]:
        snap = segment_snapshot(item)
        sid = snap["id"]
        if sid in snapshots:
            if snapshots[sid] != snap:
                raise ValueError("Conflicting duplicate snapshot id")
            duplicate_snapshots += 1
            continue
        observation = (tuple(sorted(snap["context"].items())), snap["_at"])
        signature = (snap["_start"], snap["_reset"], snap["window_minutes"], snap["used_percent"],
                     snap["percent_resolution"], snap["source"])
        if observation in observations and observations[observation] != signature:
            raise ValueError("Conflicting snapshots at the same observation time")
        observations[observation] = signature
        snapshots[sid] = snap
    attempts, ids = [], set()
    for item in raw["segments"]:
        segment_keys(item, {"id", "before", "after", "assertions"}, "segment")
        sid = segment_text(item["id"], "segment id")
        if sid in ids:
            raise ValueError("Duplicate segment id")
        ids.add(sid)
        segment_keys(item["assertions"], set(SEGMENT_ASSERTIONS), "assertions")
        if any(type(v) is not bool for v in item["assertions"].values()):
            raise ValueError("assertions must be explicit booleans")
        for endpoint in ("before", "after"):
            segment_text(item[endpoint], endpoint)
            if item[endpoint] not in snapshots:
                raise ValueError(f"Unknown {endpoint} snapshot in segment {sid}")
        a, b = snapshots[item["before"]], snapshots[item["after"]]
        reasons = set()
        if a["_at"] >= b["_start"]:
            reasons.add("unordered_or_overlapping_snapshots")
        if a["_start"] < period_start or b["_at"] > period_end:
            reasons.add("outside_collection_period")
        if a["context"] != context or b["context"] != context:
            reasons.add("context_mismatch")
        if any(s["source"] == "historical_log" for s in (a, b)):
            reasons.add("historical_cached_endpoint")
        if a["source"] != b["source"]:
            reasons.add("mixed_observation_sources")
        identity = (a["window_minutes"], a["_reset"].isoformat(), a["source"])
        if (b["window_minutes"], b["_reset"].isoformat(), b["source"]) != identity:
            reasons.add("window_or_reset_changed")
        for snap in (a, b):
            if not snap["_reset"] - timedelta(minutes=snap["window_minutes"]) <= snap["_start"] <= snap["_at"] < snap["_reset"]:
                reasons.add("snapshot_outside_cycle")
        delta = Decimal(str(b["used_percent"])) - Decimal(str(a["used_percent"]))
        if delta < 0:
            reasons.add("quota_decreased_or_cached")
        if a["used_percent"] == 100 or b["used_percent"] == 100:
            reasons.add("quota_saturated")
        for assertion in SEGMENT_ASSERTIONS:
            if not item["assertions"][assertion]:
                reasons.add("unconfirmed_" + assertion)
        attempts.append({"id": sid, "before": a, "after": b, "identity": identity, "reasons": reasons,
                         "delta_percent": delta, "amount": Decimal(0), "by_model": {}, "receipts": 0, "receipt_ids": [], "affected_receipt_ids": []})
    # Same-time aliases are not evidence of independent intervals. Reject overlap,
    # except one literally shared observation at an adjacent boundary.
    ordered = sorted(attempts, key=lambda x: x["before"]["_start"])
    for i, left in enumerate(ordered):
        for right in ordered[i + 1:]:
            if right["before"]["_start"] >= left["after"]["_at"]:
                break
            if left["after"]["id"] != right["before"]["id"]:
                left["reasons"].add("overlapping_segments")
                right["reasons"].add("overlapping_segments")
    unique, duplicates, inherited, outside = {}, 0, 0, 0
    for item in raw["receipts"]:
        segment_keys(item, {"response_id", "thread_id", "owner_thread_id", "owner_created_at", "started_at",
                           "completed_at", "model", "usage"}, "receipt")
        for key in ("response_id", "thread_id", "owner_thread_id", "model"):
            segment_text(item[key], key)
        start = segment_time(item["started_at"], "receipt started_at")
        end = segment_time(item["completed_at"], "receipt completed_at")
        created = segment_time(item["owner_created_at"], "receipt owner_created_at")
        if start > end:
            raise ValueError("receipt starts after completion")
        segment_keys(item["usage"], set(FIELDS), "receipt usage")
        usage = Usage.parse(item["usage"])
        if usage is None:
            raise ValueError("Invalid receipt usage vector")
        if item["owner_thread_id"] != item["thread_id"]:
            inherited += 1
            continue
        if start < created:
            raise ValueError("Receipt starts before its owner creation boundary")
        # Response IDs are unique; a different thread for the same ID is a conflict.
        rid = item["response_id"]
        if rid in unique:
            if unique[rid][0] != item:
                raise ValueError("Conflicting duplicate response receipt")
            duplicates += 1
            continue
        unique[rid] = (item, start, end, usage)
    for item, start, end, usage in unique.values():
        # Include touches in conflict detection: a completion timestamp alone is
        # insufficient to decide which side of a quota capture paid for a request.
        affected = [s for s in attempts if start <= s["after"]["_at"] and end >= s["before"]["_start"]]
        contained = [s for s in affected if s["before"]["_at"] < start <= end < s["after"]["_start"]]
        if not affected:
            outside += 1  # Activity in a declared gap never bridges the next baseline.
            continue
        for attempt in affected:
            attempt["affected_receipt_ids"].append(item["response_id"])
        if len(contained) != 1 or len(affected) != 1:
            for attempt in affected:
                attempt["reasons"].add("receipt_crosses_or_touches_boundary")
            continue
        attempt = contained[0]
        if item["model"] not in models:
            attempt["reasons"].add("undeclared_workload_model")
        event = Event(item["thread_id"], end, item["model"], usage, usage.input_tokens)
        cost = charge(event, prices)
        if not cost.complete:
            attempt["reasons"].update("incomplete_price_" + reason for reason in cost.reasons)
        attempt["amount"] += cost.amount
        attempt["receipts"] += 1
        attempt["receipt_ids"].append(item["response_id"])
        bucket = attempt["by_model"].setdefault(item["model"], Bucket())
        bucket.add(event, cost)
    rejected, reason_counts, groups, segment_results = 0, Counter(), {}, []
    for attempt in attempts:
        if attempt["amount"] <= 0 and attempt["delta_percent"] > 0:
            attempt["reasons"].add("quota_increase_without_local_cost")
        reasons = sorted(attempt["reasons"])
        accepted = not reasons
        rejected += not accepted
        reason_counts.update(reasons)
        a, b = attempt["before"], attempt["after"]
        segment_results.append({"id": attempt["id"], "eligible": accepted, "reasons": reasons,
            "before": a["id"], "after": b["id"], "start": a["_at"].isoformat(), "end": b["_at"].isoformat(),
            "before_used_percent": a["used_percent"], "after_used_percent": b["used_percent"],
            "delta_percent": float(attempt["delta_percent"]), "known_api_cost_usd": float(attempt["amount"]),
            "receipt_count": attempt["receipts"]})
        group = groups.setdefault(attempt["identity"], [])
        group.append(attempt)
    blocked_identities = set()
    for attempt in attempts:
        if attempt["reasons"]:
            for endpoint in ("before", "after"):
                snap = attempt[endpoint]
                blocked_identities.add((snap["window_minutes"], snap["_reset"].isoformat(), snap["source"]))
    estimates = []
    for identity, group in sorted(groups.items()):
        eligible = [s for s in group if not s["reasons"]]
        cost = sum((s["amount"] for s in eligible), Decimal(0))
        delta = sum(s["delta_percent"] for s in eligible)
        coefficients, model_totals = Counter(), {}
        for s in eligible:
            coefficients[s["before"]["id"]] -= 1
            coefficients[s["after"]["id"]] += 1
            for model, bucket in s["by_model"].items():
                total = model_totals.setdefault(model, {"cost": Decimal(0), "usage": Usage(), "receipts": 0})
                total["cost"] += bucket.amount
                total["usage"] += bucket.usage
                total["receipts"] += bucket.events
        lower = upper = Decimal(0)
        for sid, coefficient in coefficients.items():
            snap = snapshots[sid]
            used, resolution = Decimal(str(snap["used_percent"])), Decimal(str(snap["percent_resolution"]))
            lo = max(Decimal(0), used - resolution)
            hi = min(Decimal(100), used + resolution)
            lower += coefficient * (lo if coefficient >= 0 else hi)
            upper += coefficient * (hi if coefficient >= 0 else lo)
        reasons = []
        if identity in blocked_identities:
            reasons.append("group_contains_rejected_attempts")
        if not eligible:
            reasons.append("no_eligible_segments")
        if cost <= 0:
            reasons.append("no_positive_local_cost")
        if delta < SEGMENT_MIN_SIGNAL:
            reasons.append("insufficient_percentage_signal")
        if lower <= 0 or (delta > 0 and max(delta - lower, upper - delta) / delta > SEGMENT_MAX_RELATIVE_ERROR):
            reasons.append("quantization_too_large")
        ready = not reasons
        starts = [s["before"]["_at"] for s in group]
        ends = [s["after"]["_at"] for s in group]
        observations = [s[endpoint] for s in group for endpoint in ("before", "after")
                        if s[endpoint]["context"] == context and
                        (s[endpoint]["window_minutes"], s[endpoint]["_reset"].isoformat(), s[endpoint]["source"]) == identity]
        latest = max(observations, key=lambda snap: snap["_at"]) if observations else None
        estimates.append({"window_minutes": identity[0], "resets_at": identity[1], "source": identity[2],
            "recorded_account_usage": {"used_percent": latest["used_percent"],
                                       "remaining_percent": 100 - latest["used_percent"],
                                       "observed_at": latest["observed_at"]} if latest else None,
            "status": "conditional_estimate" if ready else "cannot_estimate", "reasons": reasons,
            "segment_count": len(group), "eligible_segment_count": len(eligible),
            "zero_delta_segment_count": sum(s["delta_percent"] == 0 for s in eligible),
            "receipt_count": sum(s["receipts"] for s in eligible),
            "observed_start": min(starts).isoformat(), "observed_end": max(ends).isoformat(),
            "span_seconds": (max(ends) - min(starts)).total_seconds(),
            "active_seconds": sum((s["after"]["_start"] - s["before"]["_at"]).total_seconds() for s in eligible),
            "local_api_cost_usd": float(cost), "delta_percent": float(delta),
            "quantization_delta_bounds": [float(lower), float(upper)],
            "full_cycle_api_equivalent_usd": float(100 * cost / Decimal(str(delta))) if ready else None,
            "quantization_only_range_usd": [float(100 * cost / Decimal(str(upper))),
                                               float(100 * cost / Decimal(str(lower)))] if ready else None,
            "statistical_confidence_interval": None,
            "workload_by_model": {m: {"api_cost_usd": float(v["cost"]), "usage": asdict(v["usage"]),
                                      "receipt_count": v["receipts"], "cost_fraction": float(v["cost"] / cost) if cost else None}
                                  for m, v in sorted(model_totals.items())}})
    if _details is not None:
        _details.update(snapshots=snapshots, attempts=attempts, unique=unique)
    return {"schema_version": 1, "experimental": True, "kind": "segmented_local_workload_api_equivalent",
        "trust_level": "conditional_on_user_assertions", "context": context, "workload": workload, "collection_period": raw["collection_period"],
        "selection_policy": raw["selection_policy"],
        "status": "conditional_estimate" if any(e["status"] == "conditional_estimate" for e in estimates) else "cannot_estimate",
        "policy": {"minimum_delta_percent": SEGMENT_MIN_SIGNAL,
                   "maximum_relative_quantization_error": SEGMENT_MAX_RELATIVE_ERROR,
                   "endpoint_error": "+/- percent_resolution, clipped to [0,100]",
                   "invalid_attempt_blocks_touched_identity_groups": True},
        "counts": {"attempted_segments": len(attempts), "eligible_segments": len(attempts) - rejected,
                   "rejected_segments": rejected, "unique_local_receipts": len(unique),
                   "duplicate_receipts_removed": duplicates, "inherited_receipts_excluded": inherited,
                   "outside_segment_receipts": outside, "duplicate_snapshots_removed": duplicate_snapshots},
        "rejection_reasons": dict(sorted(reason_counts.items())), "segments": segment_results,
        "groups": estimates, "limitations": SEGMENT_LIMITATIONS}


MODEL_MAX_RELATIVE_RANGE_WIDTH = Decimal("0.5")
MODEL_SCENARIO_LIMITATIONS = [
    "Each model/workload row is an alternative full-cycle scenario; totals and remaining amounts MUST NOT be added.",
    "Coefficients apply only to the declared speed, effort, cache workload and selected numeric price basis.",
    "Receipts are repriced with the supplied standard API catalog; speed labels do not add Fast/tool/regional fees.",
    "Only explicitly single-workload intervals calibrate a scenario; mixed-workload attribution/fitting is unsupported.",
    "Rounding is an explicit assumption, not a discovered official rule; these are conditional bounds, never confidence intervals.",
    "Remaining amounts are as of the explicitly selected snapshot, not a current balance or live lookup.",
    "Remaining bounds conservatively multiply nonnegative bounds; shared calibration/current errors are not assumed independent.",
    *SEGMENT_LIMITATIONS,
]


def numeric_price_fingerprint(prices: dict) -> str:
    numeric = {model: {key: value for key, value in asdict(price).items() if key != "source"}
               for model, price in sorted(prices.items())}
    # Normalize Decimal spellings: 1, 1.0, and 1.00 are the same price basis.
    encoded = json.dumps(numeric, sort_keys=True, separators=(",", ":"),
                         default=lambda value: str(value.normalize())).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def quantized_percent_bounds(snapshot: dict, rounding: str) -> tuple:
    used, step = Decimal(str(snapshot["used_percent"])), Decimal(str(snapshot["percent_resolution"]))
    if rounding != "unknown" and used not in (0, 100) and used % step:
        raise ValueError("Snapshot percentage is incompatible with the declared quantization grid")
    if rounding == "floor":
        low, high = used, used + step
    elif rounding == "ceil":
        low, high = used - step, used
    elif rounding == "nearest":
        low, high = used - step / 2, used + step / 2
    else:
        low, high = used - step, used + step
    # Closed outer bounds remain conservative for open/tie-dependent rounding.
    return max(Decimal(0), low), min(Decimal(100), high)


def scenario_quantization(attempts: list, snapshots: dict, rounding: str) -> dict:
    coefficients = Counter()
    cost = sum((s["amount"] for s in attempts), Decimal(0))
    delta = sum((s["delta_percent"] for s in attempts), Decimal(0))
    for attempt in attempts:
        coefficients[attempt["before"]["id"]] -= 1
        coefficients[attempt["after"]["id"]] += 1
    low = high = Decimal(0)
    for sid, coefficient in coefficients.items():
        lo, hi = quantized_percent_bounds(snapshots[sid], rounding)
        low += coefficient * (lo if coefficient >= 0 else hi)
        high += coefficient * (hi if coefficient >= 0 else lo)
    low, high = max(Decimal(0), low), max(Decimal(0), high)
    nominal = 100 * cost / delta if cost > 0 and delta > 0 else None
    lower = 100 * cost / high if cost > 0 and high > 0 else None
    upper = 100 * cost / low if cost > 0 and low > 0 else None
    width = (upper - lower) / nominal if upper is not None and lower is not None and nominal else None
    reasons = []
    if not attempts:
        reasons.append("no_eligible_single_workload_segments")
    if cost <= 0:
        reasons.append("no_positive_local_cost")
    if delta < SEGMENT_MIN_SIGNAL:
        reasons.append("insufficient_percentage_signal")
    if low <= 0 or (delta > 0 and max(delta - low, high - delta) / delta > Decimal(str(SEGMENT_MAX_RELATIVE_ERROR))):
        reasons.append("quantization_too_large")
    if width is None or width > MODEL_MAX_RELATIVE_RANGE_WIDTH:
        reasons.append("total_range_too_wide")
    return {"cost": cost, "delta": delta, "low": low, "high": high, "nominal": nominal,
            "lower": lower, "upper": upper, "relative_width": width, "reasons": reasons,
            "uncancelled_endpoint_count": sum(c != 0 for c in coefficients.values()),
            "boundary_coefficient_weight": sum(abs(c) for c in coefficients.values())}


def model_remaining(current: Optional[dict], identity: tuple, context: dict, all_attempts: list,
                    quantity: dict, total_ready: bool, rounding: str, missing_reason: str = "no_current_snapshot_selected") -> dict:
    reasons = []
    observed = None
    if current is None:
        reasons.append(missing_reason)
    else:
        observed = {"snapshot_id": current["id"], "used_percent": current["used_percent"],
                    "remaining_percent": 100 - current["used_percent"], "observed_at": current["observed_at"],
                    "is_live_lookup": False}
        key = (current["window_minutes"], current["_reset"].isoformat(), current["source"])
        if current["context"] != context or key != identity:
            reasons.append("current_snapshot_identity_mismatch")
        if current["source"] == "historical_log":
            reasons.append("historical_current_snapshot")
        if not current["_reset"] - timedelta(minutes=current["window_minutes"]) <= current["_start"] <= current["_at"] < current["_reset"]:
            reasons.append("current_snapshot_outside_cycle")
        # All profiles share the same account pool. Do not approve an old or
        # decreased observation just because one profile's calibration is older.
        endpoints = [s[end] for s in all_attempts for end in ("before", "after")
                     if s[end]["context"] == context and
                     (s[end]["window_minutes"], s[end]["_reset"].isoformat(), s[end]["source"]) == identity]
        if endpoints:
            latest = max(s["_at"] for s in endpoints)
            if current["_at"] < latest:
                reasons.append("current_snapshot_precedes_calibration")
            shared_latest = any(s["id"] == current["id"] and s["_at"] == latest for s in endpoints)
            if not shared_latest and current["_start"] < latest:
                reasons.append("current_capture_overlaps_calibration")
        earlier = [s for s in endpoints if s["_at"] <= current["_at"]]
        if earlier and current["used_percent"] < max(s["used_percent"] for s in earlier):
            reasons.append("current_snapshot_decreased_or_cached")
    if observed is not None:
        observed["usable_for_remaining"] = not reasons
        observed["context"] = current["context"]
        observed["resets_at"] = current["resets_at"]
    interval = point = None
    width = None
    if not reasons:
        lo, hi = quantized_percent_bounds(current, rounding)
        fraction = (100 - Decimal(str(current["used_percent"]))) / 100
        rem_low, rem_high = (100 - hi) / 100, (100 - lo) / 100
        point = quantity["nominal"] * fraction if quantity["nominal"] is not None else None
        if quantity["lower"] is not None:
            lower = quantity["lower"] * rem_low
            upper = quantity["upper"] * rem_high if quantity["upper"] is not None else (Decimal(0) if rem_high == 0 else None)
            interval = [float(lower), float(upper) if upper is not None else None]
            if upper is not None and point is not None:
                width = (upper - lower) / point if point > 0 else (Decimal(0) if upper == lower == 0 else None)
        if not total_ready:
            reasons.append("total_estimate_unavailable")
        if width is None or width > MODEL_MAX_RELATIVE_RANGE_WIDTH:
            reasons.append("remaining_range_too_wide")
    if not total_ready and "total_estimate_unavailable" not in reasons:
        reasons.append("total_estimate_unavailable")
    return {"status": "conditional_estimate" if not reasons else "cannot_estimate", "reasons": reasons,
            "recorded_account_usage": observed,
            "estimated_remaining_api_cost_usd": float(point) if not reasons and point is not None else None,
            "quantization_only_bounds_usd": interval,
            "relative_range_width": float(width) if width is not None else None}


def analyze_model_segments(raw: dict, prices: dict) -> dict:
    """Alternative profile-specific scenarios atop the same global receipt ledger.

    There is no mixed-model fit and no cross-profile quota-error cancellation.
    A missing current selection leaves historical totals intact, with no balance.
    """
    if isinstance(raw, dict) and "current_snapshot" not in raw:
        raw = {**raw, "current_snapshot": None}
    segment_keys(raw, {"schema_version", "context", "label", "workloads", "quantization", "current_snapshot",
                       "collection_period", "selection_policy", "snapshots", "segments", "receipts"}, "model manifest")
    if type(raw["schema_version"]) is not int or raw["schema_version"] != 2:
        raise ValueError("Unsupported model manifest schema_version")
    segment_text(raw["label"], "label")
    segment_keys(raw["quantization"], {"rounding"}, "quantization")
    rounding = raw["quantization"]["rounding"]
    if rounding not in ("unknown", "floor", "nearest", "ceil"):
        raise ValueError("quantization.rounding must be unknown, floor, nearest, or ceil")
    if not isinstance(raw["workloads"], list) or not 1 <= len(raw["workloads"]) <= 100:
        raise ValueError("workloads must contain 1 to 100 declared profiles")
    profiles, signatures = {}, set()
    for profile in raw["workloads"]:
        segment_keys(profile, {"id", "model", "speed", "effort", "cache_workload"}, "workload profile")
        for key, value in profile.items():
            segment_text(value, "workload " + key)
            if value != value.strip():
                raise ValueError("Workload profile fields must not have surrounding whitespace")
        signature = (profile["model"], *(profile[k].casefold() for k in ("speed", "effort", "cache_workload")))
        if profile["id"] in profiles or signature in signatures:
            raise ValueError("Duplicate workload ID or aliased applicability profile")
        profiles[profile["id"]] = dict(profile)
        signatures.add(signature)
    base = {key: value for key, value in raw.items() if key in
            ("context", "collection_period", "selection_policy", "snapshots")}
    base.update(schema_version=1, workload={"label": raw["label"], "models": sorted({p["model"] for p in profiles.values()}),
                                          "effort": "separate_declared_profiles"})
    declared, receipt_profiles = {}, {}
    for kind in ("segments", "receipts"):
        if not isinstance(raw[kind], list):
            raise ValueError(f"{kind}: expected a list")
        base[kind] = []
        for item in raw[kind]:
            if not isinstance(item, dict) or "workload_id" not in item:
                raise ValueError(f"{kind}: every item requires workload_id")
            pid = item["workload_id"]
            if pid is not None:
                segment_text(pid, "workload_id")
            if (kind == "receipts" or pid is not None) and pid not in profiles:
                raise ValueError("Unknown workload_id")
            clean = {key: value for key, value in item.items() if key != "workload_id"}
            base[kind].append(clean)
            if kind == "segments":
                # V1 performs full ID/schema validation before this map is used.
                declared[segment_text(item.get("id"), "segment id")] = pid
            elif item.get("owner_thread_id") == item.get("thread_id"):
                rid = segment_text(item.get("response_id"), "response_id")
                if rid in receipt_profiles and receipt_profiles[rid] != pid:
                    raise ValueError("Conflicting duplicate receipt workload_id")
                receipt_profiles[rid] = pid
    details = {}
    original = analyze_segments(base, prices, _details=details)
    snapshots, attempts = details["snapshots"], details["attempts"]
    for snap in snapshots.values():
        quantized_percent_bounds(snap, rounding)
    current = None
    if raw["current_snapshot"] is not None:
        segment_text(raw["current_snapshot"], "current_snapshot")
        current = snapshots.get(raw["current_snapshot"])
    groups, blocked, base_keys = defaultdict(list), defaultdict(set), set()
    result_segments, rejections, unsupported = [], Counter(), 0
    for attempt in attempts:
        pid = declared[attempt["id"]]
        observed_profiles = {receipt_profiles[rid] for rid in attempt["affected_receipt_ids"]}
        observed_models = {details["unique"][rid][0]["model"] for rid in attempt["affected_receipt_ids"]}
        mismatched_models = any(details["unique"][rid][0]["model"] != profiles[receipt_profiles[rid]]["model"]
                                for rid in attempt["affected_receipt_ids"])
        if mismatched_models:
            attempt["reasons"].add("receipt_model_profile_mismatch")
        if pid is not None and any(observed != pid for observed in observed_profiles):
            attempt["reasons"].add("unexpected_mixed_workload")
        identities = {(attempt[end]["window_minutes"], attempt[end]["_reset"].isoformat(), attempt[end]["source"])
                      for end in ("before", "after")}
        base_keys.update(identities)
        errors = set(attempt["reasons"])
        if errors:
            touched = observed_profiles | ({pid} if pid is not None else set())
            if mismatched_models:
                # Contradictory model/profile labels cannot identify the actual
                # model's speed/effort/cache variant; block every such variant.
                touched.update(key for key, profile in profiles.items() if profile["model"] in observed_models)
            # Ambiguous crossing receipts may not be wholly assigned anywhere.
            if not touched:
                touched = set(profiles)
            for identity in identities:
                for affected_pid in touched:
                    blocked[(identity, affected_pid)].update(errors)
        if pid is None:
            unsupported += 1
            reasons = sorted(errors | {"mixed_workload_attribution_unsupported"})
        else:
            groups[(attempt["identity"], pid)].append(attempt)
            reasons = sorted(errors)
        rejections.update(reasons)
        result_segments.append({"id": attempt["id"], "declared_workload_id": pid,
            "observed_workload_ids": sorted(observed_profiles), "observed_models": sorted(observed_models),
            "status": "unsupported_mixed_workload" if pid is None else ("rejected" if reasons else "eligible"),
            "reasons": reasons, "before": attempt["before"]["id"], "after": attempt["after"]["id"],
            "delta_percent": float(attempt["delta_percent"]), "known_api_cost_usd": float(attempt["amount"]),
            "receipt_count": attempt["receipts"]})
    if current and current["context"] == raw["context"]:
        base_keys.add((current["window_minutes"], current["_reset"].isoformat(), current["source"]))
    if not base_keys:
        base_keys.add((0, "unknown", "unknown"))
    fingerprint = numeric_price_fingerprint(prices)
    scenarios = []
    for identity in sorted(base_keys):
        for pid, profile in sorted(profiles.items()):
            selected = groups[(identity, pid)]
            eligible = [s for s in selected if not s["reasons"]]
            quantity = scenario_quantization(eligible, snapshots, rounding)
            reasons = list(quantity["reasons"])
            if blocked[(identity, pid)]:
                reasons.append("profile_group_contains_rejected_attempts")
            ready = not reasons
            usage = Usage()
            for attempt in eligible:
                for bucket in attempt["by_model"].values():
                    usage += bucket.usage
            bounds = [float(quantity["lower"]), float(quantity["upper"]) if quantity["upper"] is not None else None] if quantity["lower"] is not None else None
            # Bounds based on an invalidly selected subset would be misleading.
            if blocked[(identity, pid)]:
                bounds = None
            remaining = model_remaining(current, identity, raw["context"], attempts, quantity, ready, rounding,
                                        "unknown_current_snapshot" if raw["current_snapshot"] is not None else "no_current_snapshot_selected")
            if blocked[(identity, pid)]:
                remaining["quantization_only_bounds_usd"] = None
            scenarios.append({"model": profile["model"], "workload_id": pid, "applicability": {**profile, "price_fingerprint": fingerprint},
                "window_minutes": identity[0] or None, "resets_at": None if identity[1] == "unknown" else identity[1],
                "source": identity[2], "status": "conditional_estimate" if ready else "cannot_estimate", "reasons": reasons,
                "rejected_attempt_reasons": sorted(blocked[(identity, pid)]),
                "segment_count": len(selected), "eligible_segment_count": len(eligible),
                "zero_delta_segment_count": sum(s["delta_percent"] == 0 for s in eligible),
                "receipt_count": sum(s["receipts"] for s in eligible),
                "observed_start": min((s["before"]["_at"] for s in selected), default=None).isoformat() if selected else None,
                "observed_end": max((s["after"]["_at"] for s in selected), default=None).isoformat() if selected else None,
                "local_api_cost_usd": float(quantity["cost"]), "delta_percent": float(quantity["delta"]),
                "quantization_delta_bounds": [float(quantity["low"]), float(quantity["high"])],
                "uncancelled_endpoint_count": quantity["uncancelled_endpoint_count"],
                "boundary_coefficient_weight": quantity["boundary_coefficient_weight"],
                "relative_total_range_width": float(quantity["relative_width"]) if quantity["relative_width"] is not None else None,
                "estimated_total_api_cost_usd": float(quantity["nominal"]) if ready else None,
                "quantization_only_total_bounds_usd": bounds, "remaining": remaining,
                "observed_usage": asdict(usage),
                "observed_cache_read_fraction": usage.cached_input_tokens / usage.input_tokens if usage.input_tokens else None,
                "observed_cache_write_fraction": usage.cache_write_input_tokens / usage.input_tokens if usage.input_tokens else None,
                "observed_output_to_input_ratio": usage.output_tokens / usage.input_tokens if usage.input_tokens else None,
                "statistical_confidence_interval": None})
    return {"schema_version": 2, "experimental": True, "kind": "per_model_conditional_quota_scenarios",
        "trust_level": "conditional_on_user_assertions", "alternatives_not_additive": True,
        "context": raw["context"], "label": raw["label"], "collection_period": raw["collection_period"],
        "selection_policy": raw["selection_policy"], "price_fingerprint": fingerprint,
        "quantization": {"rounding_assumption": rounding, "endpoint_bounds_are_closed_outer_bounds": True},
        "current_snapshot_id": raw["current_snapshot"], "model_scenarios": scenarios,
        "status": "conditional_estimate" if any(s["status"] == "conditional_estimate" for s in scenarios) else "cannot_estimate",
        "policy": {"minimum_delta_percent": SEGMENT_MIN_SIGNAL, "maximum_relative_percentage_error": SEGMENT_MAX_RELATIVE_ERROR,
                   "maximum_relative_total_range_width": float(MODEL_MAX_RELATIVE_RANGE_WIDTH),
                   "maximum_relative_remaining_range_width": float(MODEL_MAX_RELATIVE_RANGE_WIDTH),
                   "point_basis": "ratio_using_displayed_percentages", "mixed_workload_fitting_supported": False,
                   "preregistration_verified": False},
        "counts": {**original["counts"], "eligible_segments": sum(s["status"] == "eligible" for s in result_segments),
                   "rejected_segments": sum(s["status"] == "rejected" for s in result_segments), "unsupported_mixed_segments": unsupported,
                   "available_scenarios": sum(s["status"] == "conditional_estimate" for s in scenarios),
                   "unavailable_scenarios": sum(s["status"] != "conditional_estimate" for s in scenarios)},
        "segments": result_segments, "rejection_reasons": dict(sorted(rejections.items())), "limitations": MODEL_SCENARIO_LIMITATIONS}


def render_model_segments(data: dict) -> str:
    lines = ["EXPERIMENTAL per-model API-equivalent quota scenarios", "Alternative scenarios, NOT additive. Official account percentages remain primary.",
             f"Status: {data['status']} | {data['label']}",
             f"Account label: {data['context']['account_key']} | plan {data['context']['plan_type']} | pool {data['context']['limit_id']} | {data['context']['window_kind']} | mode {data['context']['mode']}",
             f"Rounding assumption: {data['quantization']['rounding_assumption']}"]
    def bounds_text(bounds):
        if bounds is None:
            return "unavailable"
        return f"${bounds[0]:.2f}–" + (f"${bounds[1]:.2f}" if bounds[1] is not None else "unbounded")
    for scenario in data["model_scenarios"]:
        profile = scenario["applicability"]
        lines.append(f"If all quota used for {scenario['model']} | {profile['speed']} | effort {profile['effort']} | cache {profile['cache_workload']}")
        lines.append(f"  Window {scenario['window_minutes']} min | reset {scenario['resets_at']} | {scenario['source']} | {scenario['eligible_segment_count']}/{scenario['segment_count']} segments eligible | "
                     f"{scenario['zero_delta_segment_count']} zero-delta retained")
        lines.append(f"  Local ${scenario['local_api_cost_usd']:.6f} / {scenario['delta_percent']:g}pp; "
                     f"delta bounds {scenario['quantization_delta_bounds']}; {scenario['uncancelled_endpoint_count']} uncancelled endpoints")
        read_fraction = scenario["observed_cache_read_fraction"]
        write_fraction = scenario["observed_cache_write_fraction"]
        ratio = scenario["observed_output_to_input_ratio"]
        cache = f"read {100 * read_fraction:.1f}%, write {100 * write_fraction:.1f}%" if read_fraction is not None else "unknown"
        lines.append(f"  {scenario['receipt_count']} receipts | observed cache {cache} | output/input " + (f"{ratio:.3f}" if ratio is not None else "unknown"))
        total = scenario["estimated_total_api_cost_usd"]
        lines.append(f"  Estimated total: ${total:.2f}" if total is not None else "  Estimated total: unknown / 暂不能估算: " + ", ".join(scenario["reasons"]))
        lines.append("  Quantization-only total bounds: " + bounds_text(scenario["quantization_only_total_bounds_usd"]))
        remaining = scenario["remaining"]
        if remaining["recorded_account_usage"]:
            recorded = remaining["recorded_account_usage"]
            label = "Account remaining" if recorded["usable_for_remaining"] else "Unusable selected snapshot remaining"
            lines.append(f"  {label}: {recorded['remaining_percent']:g}% as of {recorded['observed_at']} (not live)")
        value = remaining["estimated_remaining_api_cost_usd"]
        lines.append(f"  Estimated remaining for this model: ${value:.2f}" if value is not None else
                     "  Estimated remaining: unknown: " + ", ".join(remaining["reasons"]))
        lines.append("  Quantization-only remaining bounds: " + bounds_text(remaining["quantization_only_bounds_usd"]))
    for reason, count in data["rejection_reasons"].items():
        lines.append(f"Excluded: {reason} ({count})")
    lines.append("Numeric price basis: " + data["price_fingerprint"])
    if data.get("price_catalog"):
        info = data["price_catalog"]
        lines.append(f"Prices: {info['catalog_source']} | verified {info['verified_at']}")
        lines.extend("Warning: " + warning for warning in info["warnings"])
    lines.extend("Warning: " + warning for warning in data["limitations"])
    return "\n".join(safe_text(line) for line in lines)


def render_segments(data: dict) -> str:
    if data.get("schema_version") == 2:
        return render_model_segments(data)
    lines = ["EXPERIMENTAL segmented local-workload API equivalent", "Official account percentages remain the primary quota.",
             f"Status: {data['status']} | segments {data['counts']['eligible_segments']}/{data['counts']['attempted_segments']} eligible",
             f"Workload: {data['workload']['label']} | effort {data['workload']['effort']} | mode {data['context']['mode']}",
             f"Account label: {data['context']['account_key']} | plan {data['context']['plan_type']} | pool {data['context']['limit_id']} | {data['context']['window_kind']}"]
    for group in data["groups"]:
        lines.append(f"Window {group['window_minutes']} min | reset {group['resets_at']} | {group['source']}")
        recorded = group["recorded_account_usage"]
        if recorded:
            lines.append(f"Last recorded account usage: {recorded['used_percent']:g}% "
                         f"at {recorded['observed_at']} (not a current lookup)")
        else:
            lines.append("No account observation matches this group's declared identity.")
        lines.append(f"Observed {group['observed_start']} to {group['observed_end']} | {group['receipt_count']} receipts")
        lines.append(f"Local ${group['local_api_cost_usd']:.6f} / {group['delta_percent']:g} percentage points; "
                     f"{group['zero_delta_segment_count']} zero-delta segments retained")
        if group["status"] == "conditional_estimate":
            low, high = group["quantization_only_range_usd"]
            lines.append(f"Conditional full-cycle equivalent: ${group['full_cycle_api_equivalent_usd']:.2f}")
            lines.append(f"Quantization-only range: ${low:.2f}–${high:.2f} (NOT a confidence interval)")
        else:
            lines.append("Cannot estimate / 暂不能估算: " + ", ".join(group["reasons"]))
        for model, row in group["workload_by_model"].items():
            lines.append(f"  {model}: ${row['api_cost_usd']:.6f}, {row['usage']['total_tokens']} tokens, {row['receipt_count']} receipts")
    if not data["groups"]:
        lines.append("Cannot estimate / 暂不能估算: no paired segments")
    for reason, count in data["rejection_reasons"].items():
        lines.append(f"Rejected: {reason} ({count})")
    if data.get("price_catalog"):
        info = data["price_catalog"]
        lines.append(f"Prices: {info['catalog_source']} | verified {info['verified_at']}")
        lines.extend("Warning: " + warning for warning in info["warnings"])
    lines.extend("Warning: " + line for line in data["limitations"])
    # User-supplied labels must not inject terminal control sequences.
    return "\n".join(safe_text(line) for line in lines)


def diagnose_segments(roots: list, prices: dict) -> tuple:
    """Existing logs can reveal evidence gaps, but cannot certify quota boundaries.

    Candidate costs use the established deduplicated ledger. They are landing-time
    subtotals across ALL selected local sessions, not attributed account charges.
    No historical candidate can become an estimator endpoint through this command.
    """
    scanner = Scanner()
    rollouts = scanner.scan(roots)
    sessions, accounting_issues = account(rollouts)
    rows = priced_events(sessions, prices)
    dated = sorted(((event, cost) for event, cost in rows if event.at), key=lambda r: r[0].at)
    times, amounts, uncertain, counts = [], [Decimal(0)], [0], [0]
    local = Bucket()
    for event, cost in rows:
        local.add(event, cost)
    for event, cost in dated:
        times.append(event.at)
        amounts.append(amounts[-1] + cost.amount)
        uncertain.append(uncertain[-1] + (not cost.complete))
        counts.append(counts[-1] + 1)
    series, task_boundaries, invalid = defaultdict(dict), Counter(), Counter()
    for rollout in rollouts:
        try:
            stat = rollout.path.stat()
            if (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns) != rollout.signature:
                invalid["log_changed_during_diagnostics"] += 1
                continue
            with rollout.path.open("rb") as handle:
                while handle.tell() < rollout.offset:
                    line = handle.readline(rollout.offset - handle.tell())
                    if not line:
                        break
                    # Do not retain prompts, tool arguments, response text, or auth.
                    if b'"event_msg"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                        if not isinstance(record, dict) or record.get("type") != "event_msg":
                            continue
                        payload = record.get("payload")
                        if not isinstance(payload, dict):
                            continue
                        at = timestamp(record.get("timestamp"))
                        if rollout.parent_id and rollout.created_at and at and at < rollout.created_at:
                            continue
                        kind = payload.get("type")
                        if kind in ("task_started", "task_complete", "turn_aborted"):
                            task_boundaries[kind] += 1
                        if kind != "token_count" or not at:
                            continue
                        raw_bucket = payload.get("rate_limits")
                        bucket = normalize_bucket(raw_bucket)
                        if not bucket:
                            continue
                        raw_id = first(raw_bucket, "limitId", "limit_id")
                        if raw_id is not None:
                            segment_text(raw_id, "historical limit_id")
                        if bucket["plan_type"] is not None:
                            segment_text(bucket["plan_type"], "historical plan_type")
                        for window_kind in ("primary", "secondary", "individual_limit"):
                            window = bucket.get(window_kind)
                            if not window:
                                continue
                            if (window_kind == "individual_limit" and "individualLimit" in raw_bucket and
                                    "individual_limit" in raw_bucket and raw_bucket["individualLimit"] != raw_bucket["individual_limit"]):
                                invalid["conflicting_window_aliases"] += 1
                                continue
                            raw_window = first(raw_bucket, "individualLimit", "individual_limit") if window_kind == "individual_limit" else raw_bucket.get(window_kind)
                            minutes = first(raw_window, "windowDurationMins", "window_minutes")
                            reset = first(raw_window, "resetsAt", "resets_at")
                            used = first(raw_window, "usedPercent", "used_percent")
                            if (type(minutes) is not int or not 1 <= minutes <= 5256000 or
                                    type(reset) is not int or reset <= 0 or type(used) not in (int, float) or
                                    not math.isfinite(used) or not 0 <= used <= 100 or not window["resets_at_utc"]):
                                invalid["invalid_quota_window"] += 1
                                continue
                            snap = {"observed_at": at.isoformat(), "used_percent": used,
                                    "window_minutes": minutes, "resets_at": window["resets_at_utc"],
                                    "plan_type": bucket.get("plan_type"), "source": "historical_log"}
                            key = (rollout.session_id, bucket["limit_id"], window_kind)
                            observation = series[key].get(at)
                            # Compare source fields, excluding the sticky diagnostic conflict flag.
                            if observation and any(observation[field] != value for field, value in snap.items()):
                                invalid["conflicting_quota_observation"] += 1
                                observation["conflict"] = True
                            elif observation is None:
                                series[key][at] = snap
                    except (ValueError, TypeError, AttributeError, OverflowError, RecursionError):
                        invalid["invalid_quota_record"] += 1
            stat = rollout.path.stat()
            if (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns) != rollout.signature:
                invalid["log_changed_during_diagnostics"] += 1
        except OSError:
            invalid["quota_file_read_failed"] += 1
    candidates = []
    # Candidate costs use (before, after] landing-time bounds only.
    for key, observations in sorted(series.items()):
        ordered = sorted(observations.items())
        for (a_at, a), (b_at, b) in zip(ordered, ordered[1:]):
            left, right = bisect_right(times, a_at), bisect_right(times, b_at)
            reasons = ["historical_cached_endpoint", "request_start_boundaries_unknown",
                       "account_and_pool_attribution_unverified", "settlement_unverified"]
            if a.get("conflict") or b.get("conflict"):
                reasons.append("conflicting_quota_observation")
            if any(a[field] != b[field] for field in ("window_minutes", "resets_at", "plan_type")):
                reasons.append("window_reset_or_plan_changed")
            delta = b["used_percent"] - a["used_percent"]
            if delta < 0:
                reasons.append("quota_decreased_or_cached")
            if uncertain[right] != uncertain[left]:
                reasons.append("incomplete_local_price")
            coverage_failed = any(scanner.issues.get(key) or accounting_issues.get(key) for key in
                                  ("missing_roots", "unreadable_roots", "unreadable_files", "malformed_json_lines",
                                   "pending_partial_line", "invalid_usage_records", "invalid_usage_snapshots",
                                   "unreconciled_usage_intervals", "conflicting_usage_records",
                                   "unattributed_fork_baseline_tokens"))
            aligned = not (invalid["log_changed_during_diagnostics"] or invalid["quota_file_read_failed"] or coverage_failed)
            if not aligned:
                reasons.append("input_changed_unreadable_or_incomplete")
            candidates.append({"session_id": key[0], "limit_id": key[1], "window_kind": key[2],
                "before": a, "after": b, "span_seconds": (b_at - a_at).total_seconds(),
                "delta_percent": delta, "possible_local_known_api_cost_usd": float(amounts[right] - amounts[left]) if aligned else None,
                "local_event_count": counts[right] - counts[left] if aligned else None,
                "cost_alignment_available": aligned, "eligible_for_estimation": False,
                "reasons": reasons})
    issues = Counter(scanner.issues)
    issues.update(accounting_issues)
    issues.update(invalid)
    return {"schema_version": 1, "experimental": True, "kind": "historical_segment_diagnostics",
        "trust_level": "historical_unverified", "status": "cannot_estimate", "full_cycle_api_equivalent_usd": None,
        "counts": {"files": len(rollouts), "sessions": len(sessions), "local_events": len(rows),
                   "undated_events": len(rows) - len(dated), "quota_observations": sum(len(v) for v in series.values()),
                   "candidate_pairs": len(candidates), "eligible_pairs": 0,
                   "zero_delta_pairs": sum(c["delta_percent"] == 0 for c in candidates)},
        "local_usage": local.export(), "task_boundary_markers": dict(sorted(task_boundaries.items())),
        "task_boundary_count_basis": "raw occurrences, including duplicate files; not unique tasks",
        "issues": dict(sorted(issues.items())), "candidates": candidates,
        "limitations": ["Historical candidates are diagnostic only; this file is not an estimator manifest.",
                        "JSONL timestamps are landing times, not quota measurement or request start times.",
                        "Adjacent snapshots and task markers do not prove active-only, complete, settled intervals.",
                        "Possible costs cover all selected local sessions; account/pool attribution is unverified.",
                        "Candidates can overlap. Never add their costs or quota deltas together.",
                        "No fixed idle timeout is used to invent boundaries; keep zero-delta pairs for inspection.",
                        "To estimate, record explicit before/after observations and preserve independent request-boundary evidence."]}, set(scanner.cache)


