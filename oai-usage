VERSION = "0.0.1"
UTC = timezone.utc
FIELDS = ("input_tokens", "cached_input_tokens", "cache_write_input_tokens",
          "output_tokens", "reasoning_output_tokens", "total_tokens")
PRICE_URL = "https://raw.githubusercontent.com/megumin31/oai-usage/main/prices.json"
