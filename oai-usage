def bounds(args: argparse.Namespace, calendar: Calendar, now: datetime) -> tuple:
    if args.today:
        start = calendar.midnight(calendar.local(now).date())
    elif args.since:
        start = calendar.midnight(date.fromisoformat(args.since))
    else:
        start = now - timedelta(days=args.days) if args.days else None
    end = calendar.midnight(date.fromisoformat(args.until) + timedelta(days=1)) if args.until else now
    if start and start >= end:
        raise ValueError("Start must precede end; use both --since and --until for historical reports")
    return start, end


@dataclass
class ReportCache:
    revision: int = -1
    prices_key: tuple = ()
    sessions: list = field(default_factory=list)
    issues: Counter = field(default_factory=Counter)
    rows: list = field(default_factory=list)
    times: list = field(default_factory=list)
    summary_key: tuple = ()
    summary: dict = field(default_factory=dict)

    def prepare(self, scanner: Scanner, rollouts: list, prices: dict) -> None:
        prices_key = tuple(sorted(prices.items()))
        if self.revision != scanner.revision or self.prices_key != prices_key:
            self.sessions, self.issues = account(rollouts)
            self.rows = priced_events(self.sessions, prices)
            self.times = sorted(e.at for e, _ in self.rows if e.at is not None)
            self.revision = scanner.revision
            self.prices_key = prices_key
            self.summary_key = ()

    def summarize(self, calendar: Calendar, start: Optional[datetime], end: Optional[datetime], by: str) -> dict:
        # A sliding time window needs recomputing only when it crosses an event.
        lo = bisect_left(self.times, start) if start else 0
        hi = bisect_left(self.times, end) if end else len(self.times)
        key = (self.revision, calendar.name, lo, hi, start is None and end is None, by)
        if key != self.summary_key:
            self.summary = aggregate(self.rows, self.sessions, calendar, start, end, by)
            self.summary_key = key
        return copy.deepcopy(self.summary)


def report(args: argparse.Namespace, scanner: Scanner, prices: dict, calendar: Calendar,
           roots: list, poller: Optional[QuotaPoller] = None, cache: Optional[ReportCache] = None,
           price_catalog: Optional[PriceCatalog] = None) -> dict:
    # For a one-shot live query, scan AFTER observing quota so the log cutoff can
    # include tokens already reflected in that quota snapshot.
    live = (None, None)
    if args.quota in ("auto", "live"):
        live = poller.read() if poller else fetch_live(args.codex_binary, args.timeout)
    rollouts = scanner.scan(roots)
    now = datetime.now(UTC)
    cache = cache or ReportCache()
    cache.prepare(scanner, rollouts, prices)
    sessions, rows = cache.sessions, cache.rows
    issues = cache.issues.copy()
    issues.update(scanner.issues)
    start, end = bounds(args, calendar, now)
    summary = cache.summarize(calendar, start, end, args.by)
    current = quota_status(args.quota, rollouts, live, now, args.limit_id)
    summary["current_rate_limits"] = current
    summary["cycle_estimates"] = projections(rows, current, now)
    price_catalog = price_catalog or read_price_catalog(PRICE_FILE, "bundled")
    return {"schema_version": 2, "version": VERSION, "generated_at": now.isoformat(),
            "period": {"start": start.isoformat() if start else None, "end": end.isoformat() if end else None,
                       "timezone": calendar.name, "end_exclusive": True},
            "roots": [str(p) for p in roots],
            "projection_assumptions": ["Account usage primarily occurs on this machine", "Quota consumption is approximately proportional to local API-equivalent cost",
                "Future model and cache mix remains similar", "Account percentages may be rounded", "Account ownership of log snapshots cannot be independently verified"],
            "pricing": {"basis": "standard_api_equivalent",
                "verified_at": price_catalog.verified_at, "catalog_source": price_catalog.origin,
                "historical_price_schedule": False,
                "excluded": ["tools", "regional_uplift", "fast_or_priority_service", "subscription_billing"],
                "models": {k: {"input": str(p.input), "cached_input": str(p.cached), "output": str(p.output),
                    "cache_write": str(p.write) if p.write is not None else None,
                    "long_context_threshold": p.long_threshold, "long_context_scope": p.long_scope,
                    "long_input": str(p.long_input) if p.long_input is not None else None,
                    "long_cached_input": str(p.long_cached) if p.long_cached is not None else None,
                    "long_cache_write": str(p.long_write) if p.long_write is not None else None,
                    "long_output": str(p.long_output) if p.long_output is not None else None,
                    "source": p.source}
                    for k, p in sorted(prices.items())}},
            "diagnostics": {"files": len(rollouts), "issues": dict(sorted(issues.items())),
                            "bytes_read_this_process": scanner.bytes_read},
            "summary": summary, "sessions": summary["by_session"]}


def safe_text(value: Any) -> str:
    # Logs and model names can contain terminal control sequences.
    return "".join(c for c in str(value) if not unicodedata.category(c).startswith("C"))


def width(value: str) -> int:
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in value)


def fit(value: Any, limit: int) -> str:
    text = safe_text(value)
    if width(text) <= limit:
        return text
    out = ""
    for c in text:
        if width(out + c) > limit - 1:
            return out + "…"
        out += c
    return out


def money(row: dict) -> str:
    value = row.get("api_cost_usd")
    if value is not None:
        return f"${value:,.4f}"
    known = row.get("known_api_cost_usd", 0)
    return f"${known:,.4f} + unknown" if known else "unknown"


def table(headers: list, rows: list, terminal_width: int = 120) -> list:
    if not rows:
        return ["  No records"]
    first_width = max(12, min(40, terminal_width - 56))
    limits = [first_width] + [18] * (len(headers) - 1)
    clean = [[fit(v, limits[i]) for i, v in enumerate(row)] for row in [headers] + rows]
    widths = [max(width(row[i]) for row in clean) for i in range(len(headers))]
    lines = []
    for index, row in enumerate(clean):
        cells = [(v + " " * (widths[i] - width(v))) if i == 0 else (" " * (widths[i] - width(v)) + v) for i, v in enumerate(row)]
        lines.append("  " + "  ".join(cells))
        if index == 0:
            lines.append("  " + "  ".join("─" * n for n in widths))
    return lines


def percentage(part: int, whole: int) -> str:
    return f"{part / whole:.1%}" if whole else "-"


def wrap_cells(value: str, limit: int) -> list:
    text = safe_text(value)
    rows = []
    while width(text) > limit:
        end, cells = 0, 0
        for char in text:
            if cells + width(char) > limit:
                break
            end += 1
            cells += width(char)
        split = text.rfind(" ", 0, end + 1)
        cut = split if split > 0 else max(1, end)
        rows.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    return rows + [text]


def panel(title: str, rows: list, columns: int, wrap: bool = True) -> list:
    columns = max(8, columns)
    inner = columns - 4
    heading = fit(title, inner)
    top = "╭─ " + heading + " " + "─" * max(0, columns - width(heading) - 5) + "╮"
    body = []
    for raw in rows:
        for row in wrap_cells(raw, inner) if wrap else [fit(raw, inner)]:
            body.append("│ " + row + " " * (inner - width(row)) + " │")
    return [top, *body, "╰" + "─" * (columns - 2) + "╯"]


def side_by_side(cards: list, columns: int) -> list:
    left, right = cards
    left_width = width(left[0])
    lines = []
    for i in range(max(len(left), len(right))):
        a = left[i] if i < len(left) else " " * left_width
        b = right[i] if i < len(right) else ""
        lines.append(fit(a + "  " + b, columns))
    return lines


def progress(used: Optional[float], columns: int) -> str:
    if used is None:
        return "Quota usage unavailable"
    remaining = max(0, min(100, 100 - used))
    bar_width = max(4, min(30, columns - 35))
    filled = round(bar_width * max(0, min(100, used)) / 100)
    return "█" * filled + "░" * (bar_width - filled) + f"  {used:g}% used · {remaining:g}% left"


def cycle_card(kind: str, estimate: dict, calendar: Calendar, columns: int, compact: bool, multiple: bool) -> list:
    title = "Current cycle" + (" · " + kind.replace("_", " ").title() if multiple else "")
    if not estimate["available"]:
        return panel(title, ["Unavailable", estimate.get("reason") or "Insufficient data"], columns, wrap=not compact)
    period, account, local = estimate["period"], estimate["account_usage"], estimate["local"]
    usage = local["usage"]
    partial = local["estimate_is_partial"]
    if partial:
        title += " · PARTIAL"
    body = [progress(account.get("used_percent"), columns - 4)]
    local_cost = f"${local['known_api_cost_usd']:,.6f}" + (" + unknown" if partial else "")
    total = f"~${estimate['projected_full_cycle_known_api_cost_usd']:,.4f}" if estimate["projection_available"] else "unavailable"
    remaining = f"~${estimate['projected_remaining_known_api_cost_usd']:,.4f}" if estimate["projection_available"] else "unavailable"
    if columns >= 90:
        cell = (columns - 8) // 3
        labels = ("LOCAL API COST", "EST. TOTAL", "EST. REMAINING")
        values = (local_cost, total, remaining)
        body += ["", "  ".join(s.ljust(cell) for s in labels),
                 "  ".join(fit(s, cell).ljust(cell) for s in values), ""]
    else:
        body += [f"Local Cost Used: {local_cost}", f"Est. Total: {total}", f"Est. Remaining: {remaining}"]
    # Actual dates identify the cycle. Its length can change or be reset early.
    display = (lambda v: calendar.local(timestamp(v)).strftime("%m-%d %H:%M")) if compact else (lambda v: calendar.display(timestamp(v)))
    if compact:
        body.append(f"{display(period['start'])} → {display(period['resets_at'])}")
        body.append(f"As of {display(period['as_of'])} · {usage['total_tokens']:,} tokens")
    else:
        body += ["Started  " + display(period["start"]), "Resets   " + display(period["resets_at"]),
                 "As of    " + display(period["as_of"]), "",
                 f"Tokens: {usage['total_tokens']:,} total · {usage['input_tokens']:,} in · {usage['cached_input_tokens']:,} cached · {usage['output_tokens']:,} out",
                 f"Cache write: {usage['cache_write_input_tokens']:,} · Reasoning: {usage['reasoning_output_tokens']:,}",
                 f"Sessions: {local['sessions']:,} · Events: {local['token_events']:,}"]
        missing = local["unpriced_usage"]["total_tokens"] + local["uncertain_pricing_usage"]["total_tokens"]
        body.append(f"Fully priced tokens: {percentage(usage['total_tokens'] - missing, usage['total_tokens'])}")
    if not estimate["projection_available"] and not compact:
        body.append("Projection unavailable: " + (estimate.get("reason") or "Insufficient data"))
    return panel(title, body, columns, wrap=not compact)


def cycle_lines(estimates: dict, calendar: Calendar, compact: bool = False, columns: int = 120) -> list:
    items = list(estimates.items())
    lines = []
    # Paired cards keep every cycle's money visible in a standard watch screen.
    if compact and len(items) == 2 and columns >= 96:
        size = (columns - 2) // 2
        cards = [cycle_card(kind, value, calendar, size, True, True) for kind, value in items]
        return side_by_side(cards, columns)
    for kind, value in items:
        if lines:
            lines.append("")
        lines += cycle_card(kind, value, calendar, columns, compact, len(items) > 1)
    return lines


def style_line(line: str) -> str:
    """Add trusted ANSI styles only after all layout and clipping is complete."""
    if "OAI USAGE" in line:
        return "\033[1;36m" + line + "\033[0m"
    if line.startswith("Report: "):
        return "\033[2m" + line + "\033[0m"
    if line.startswith(("╭", "╰", "├")):
        return "\033[36m" + line + "\033[0m"
    if "LOCAL API COST" in line:
        return "\033[2m" + line.replace("│", "\033[36m│\033[0;2m") + "\033[0m"
    def color_bar(match: re.Match) -> str:
        bar, gap, used_text = match.group(1, 2, 3)
        used = float(used_text)
        color = "31" if used >= 85 else "33" if used >= 60 else "32"
        bar = re.sub(r"█+", lambda m: f"\033[{color}m{m[0]}\033[0m", bar)
        bar = re.sub(r"░+", lambda m: f"\033[2m{m[0]}\033[0m", bar)
        return bar + gap + used_text + "% used"
    line = re.sub(r"([█░]+)( +)([-\d.]+)% used", color_bar, line)
    line = re.sub(r"~?\$[\d,]+(?:\.\d+)?", lambda m: f"\033[1;32m{m[0]}\033[0m", line)
    line = re.sub(r"\b(?:unknown|unavailable|PARTIAL|expired)\b", lambda m: f"\033[33m{m[0]}\033[0m", line)
    return line.replace("│", "\033[36m│\033[0m")


def render(data: dict, args: argparse.Namespace, calendar: Calendar, columns: int = 120) -> str:
    columns = max(8, min(columns, 140))
    compact = args.command == "watch"
    summary, period = data["summary"], data["period"]
    usage = summary["usage"]
    current = summary["current_rate_limits"]
    source = {"app_server": "LIVE", "session_log": "LOG SNAPSHOT", "unavailable": "QUOTA UNAVAILABLE"}.get(
        current.get("source") if current else None, "LOCAL LOGS")
    lines = [f"OAI USAGE  {VERSION}   /   USAGE & QUOTA",
             f"Report: {calendar.display(timestamp(period['start']))} → {calendar.display(timestamp(period['end']))} · {source}"]
    if args.project and current:
        estimates = summary["cycle_estimates"]
        if estimates:
            lines += cycle_lines(estimates, calendar, compact, columns)
        else:
            lines += panel("Current cycle", ["Unavailable: " + (current.get("error") or "No quota windows available")], columns)
        lines.append("")

    report_rows = [f"API cost  {money(summary)}   ·   {usage['total_tokens']:,} tokens   ·   {summary['sessions']:,} sessions",
                   f"Input {usage['input_tokens']:,}  ·  Cached {usage['cached_input_tokens']:,}  ·  Output {usage['output_tokens']:,}"]
    if not compact:
        report_rows += [f"Cache write {usage['cache_write_input_tokens']:,}  ·  Reasoning {usage['reasoning_output_tokens']:,}  ·  Events {summary['token_events']:,}",
                        f"Cached/In {percentage(usage['cached_input_tokens'], usage['input_tokens'])}  ·  Out/Total {percentage(usage['output_tokens'], usage['total_tokens'])}",
                        f"From {calendar.display(timestamp(period['start']))} to {calendar.display(timestamp(period['end']))}"]
    lines += panel("Selected report period", report_rows, columns, wrap=not compact)

    # Compact watch already has the quota bar and dates inside each cycle card.
    if current and (not compact or not args.project):
        quota_rows = []
        if current.get("source") == "unavailable" or current.get("error"):
            quota_rows.append(current.get("error", "Unavailable"))
        else:
            bid = current["active_limit_id"]
            bucket = current["limits"][bid]
            label = "LIVE" if current["source"] == "app_server" else "LOG SNAPSHOT"
            age = bucket.get("snapshot_age_seconds")
            age_label = f"{age}s ago" if age is not None else "time unknown"
            quota_rows.append(f"{label} · {safe_text(bid)} · {safe_text(bucket.get('plan_type') or 'plan unknown')} · {age_label}")
            for kind in ("primary", "secondary", "individual_limit"):
                window = bucket.get(kind)
                if window:
                    stale = " [expired]" if window.get("expired") else ""
                    quota_rows.append(f"{kind.replace('_', ' ').title()}: {progress(window.get('used_percent'), columns - 20)}{stale}")
                    quota_rows.append("Resets " + calendar.display(timestamp(window.get("resets_at_utc"))))
            if len(current["limits"]) > 1:
                quota_rows.append("Other buckets: " + ", ".join(safe_text(k) for k in sorted(current["limits"]) if k != bid) + " (--limit)")
            if current.get("fallback_reason"):
                quota_rows.append("Fallback: " + safe_text(current["fallback_reason"]))
            credits = bucket.get("credits")
            if credits:
                balance = safe_text(credits.get("balance") if credits.get("balance") is not None else "unknown")
                quota_rows.append(f"Credits: {'unlimited' if credits.get('unlimited') else balance}")
            reset_credits = current.get("rate_limit_reset_credits")
            if reset_credits:
                quota_rows.append(f"Reset credits available: {reset_credits['available_count']}")
        lines += ["", *panel("Account quota", quota_rows, columns)]

    dimensions = ["model", "day", "session"] if args.all_dimensions else [args.by]
    for by in dimensions:
        if by == "model":
            entries = list(summary["by_model_detail"].items())
            title = "By model"
        elif by == "session":
            entries = [(r["session_id"], r) for r in summary["by_session"]]
            title = "By session (including independent subtasks)"
        else:
            entries = list((summary["by_day"] if by == "day" else summary["groups"]).items())
            title = {"day": "By day", "week": "By week", "month": "By month"}[by]
        entries.sort(key=(lambda row: (-row[1]["usage"]["total_tokens"], row[0])) if by in ("model", "session") else (lambda row: row[0]),
                     reverse=by not in ("model", "session"))
        shown = entries[:args.top] if args.top else entries
        lines += ["", title, "─" * columns]
        if columns >= 120:
            rows = []
            for key, row in shown:
                tokens = row["usage"]
                rows.append((key, f"{tokens['input_tokens']:,}", f"{tokens['cached_input_tokens']:,}",
                             f"{tokens['output_tokens']:,}", f"{tokens['reasoning_output_tokens']:,}",
                             percentage(tokens['cached_input_tokens'], tokens['input_tokens']),
                             percentage(tokens['output_tokens'], tokens['total_tokens']), money(row)))
            lines += table(["Name", "Input", "Cached", "Output", "Reasoning", "Cached/In", "Out/Total", "API Cost"], rows, columns)
        else:
            for key, row in shown:
                tokens = row["usage"]
                lines.append(f"  {safe_text(key)}  ·  {money(row)}")
                lines.append(f"  In {tokens['input_tokens']:,} · Cached {tokens['cached_input_tokens']:,} · Out {tokens['output_tokens']:,}")
                if not compact:
                    lines.append(f"  Reasoning {tokens['reasoning_output_tokens']:,} · Cached/In {percentage(tokens['cached_input_tokens'], tokens['input_tokens'])} · Out/Total {percentage(tokens['output_tokens'], tokens['total_tokens'])}")
            if not shown:
                lines.append("  No records")
        if len(shown) < len(entries):
            lines.append(f"Showing {len(shown)}/{len(entries)} entries; --top 0 shows all. JSON is always complete.")
    issues = data["diagnostics"]["issues"]
    warnings = [(ISSUES.get(k, k), v) for k, v in issues.items() if v and k not in (
        "inherited_snapshots_excluded", "duplicate_snapshots_removed", "events_without_request_detail", "inherited_baseline_tokens_excluded")]
    if summary["unpriced_models"]:
        warnings.append(("Unpriced models", ", ".join(safe_text(v) for v in summary["unpriced_models"])))
    if summary["undated_events_excluded"]:
        warnings.append(("Undated events excluded", summary["undated_events_excluded"]))
    if warnings:
        lines += ["", *panel("Data notes", [f"{label}: {value}" for label, value in warnings], columns)]
    lines += ["", "Standard API equivalent · not a subscription bill · tools/Fast/regional charges excluded."]
    if args.project and current:
        lines.append("Estimates = local cycle cost / account usage fraction; assume usage primarily on this machine.")
    if not summary["token_events"]:
        lines.append("No usage in this report period; try --days all or --root to select log directories.")
    return "\n".join(fit(line, columns) for line in lines)


def write_json(path: Path, data: dict, protected: set) -> None:
    path = path.expanduser()
    if path.resolve() in protected or path.suffix.lower() == ".jsonl":
        raise ValueError("Output cannot overwrite the program or session JSONL logs; choose a separate .json file")
    encoded = json.dumps(data, ensure_ascii=False, indent=2, allow_nan=False) + "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", prefix=".oai-usage-", dir=path.parent, delete=False) as handle:
            name = handle.name
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
        name = None
    finally:
        if name:
            Path(name).unlink(missing_ok=True)


def positive(value: str) -> float:
    number = finite(value)
    if number is None or number <= 0 or number > 86400:
        raise argparse.ArgumentTypeError("Enter a finite number greater than 0 and at most 86400")
    return number


def days_value(value: str) -> int:
    if value.lower() == "all":
        return 0
    try:
        number = int(value)
        if not 0 <= number <= 365000:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError("Enter a nonnegative number of days, or all")


def parse_args(argv: Optional[list] = None) -> argparse.Namespace:
    args = list(sys.argv[1:] if argv is None else argv)
    legacy_watch = any(v in ("-w", "--watch") for v in args)
    if legacy_watch:
        args = [v for v in args if v not in ("-w", "--watch")]
    if not args or args[0] not in ("report", "watch", "prices", "-h", "--help", "--version"):
        args.insert(0, "watch" if legacy_watch else "report")
    parser = argparse.ArgumentParser(prog="oai-usage", description="Local Codex usage, API-equivalent costs, and account quotas",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  oai-usage                         Last 30 days and current quota-cycle costs
  oai-usage --today                  Today in the selected timezone
  oai-usage watch                    Live dashboard; Ctrl+C to quit
  oai-usage --days all --by session  All session details
  oai-usage --by day --output report.json
  oai-usage --quota off --json       Local-only JSON report
  oai-usage report --help            All filter, pricing, and quota options""")
    parser.add_argument("--version", action="version", version=f"oai-usage {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)
    for name, help_text in (("report", "Usage report (default)"), ("watch", "Continuously refresh usage")):
        p = sub.add_parser(name, help=help_text, description=help_text)
        dates = p.add_mutually_exclusive_group()
        dates.add_argument("--days", type=days_value, default=30, metavar="N|all", help="Last N x 24 hours; all for all history (default: 30)")
        dates.add_argument("--today", action="store_true", help="Today in the selected timezone")
        dates.add_argument("--since", metavar="YYYY-MM-DD", help="Inclusive start date")
        p.add_argument("--until", metavar="YYYY-MM-DD", help="Inclusive end date")
        p.add_argument("--timezone", default="local", metavar="ZONE", help="Calendar timezone, e.g. UTC or America/New_York (default: system timezone)")
        p.add_argument("--by", "--group-by", choices=("model", "day", "week", "month", "session"), default="model", help="Grouping (default: model)")
        p.add_argument("--all", "--all-dimensions", dest="all_dimensions", action="store_true", help="Show model, day, and session details together")
        p.add_argument("--top", type=int, default=15, help="Show N entries; 0 for all. JSON is never truncated (default: 15)")
        p.add_argument("--root", action="append", help="Replace default log directories; repeatable. Defaults use CODEX_HOME or ~/.codex")
        p.add_argument("--quota", "--limits-source", choices=("auto", "live", "logs", "off"), default="auto", help="Quota source (default: live with log fallback)")
        p.add_argument("--limit", dest="limit_id", help="Select a quota bucket ID (default: prefer codex)")
        projection = p.add_mutually_exclusive_group()
        projection.add_argument("--project", dest="project", action="store_true", default=True, help="Show current-cycle costs and projections (default)")
        projection.add_argument("--no-project", dest="project", action="store_false", help="Hide the current-cycle section in terminal output")
        p.add_argument("--codex-binary", help="Path to the Codex executable")
        p.add_argument("--timeout", "--limits-timeout", type=positive, default=10, help="Live quota timeout in seconds (default: 10)")
        p.add_argument("--price", action="append", default=[], metavar="MODEL=IN,CACHED,OUT[,WRITE]", help="Custom USD rates per million tokens")
        p.add_argument("--offline-prices", action="store_true", help="Use cached or bundled prices without checking GitHub")
        p.add_argument("--json", action="store_true", help="Only print JSON to stdout; watch emits one JSON document per line")
        p.add_argument("--output", "--json-out", help="Atomically save the full JSON report; - for stdout")
        color = p.add_mutually_exclusive_group()
        color.add_argument("--no-color", action="store_true", help="Disable colors")
        color.add_argument("--color", action="store_true", help="Enable title colors")
        p.add_argument("--refresh", "--interval", "-n", type=positive, default=2, help="Watch refresh interval in seconds (default: 2)")
        p.add_argument("--quota-interval", type=positive, default=30, help="Watch live quota polling interval in seconds (default: 30)")
        p.add_argument("--count", type=int, default=0, help="Exit watch after N refreshes; 0 to keep running")
    p = sub.add_parser("prices", help="Show built-in prices and official sources")
    p.add_argument("--json", action="store_true")
    p.add_argument("--offline-prices", action="store_true")
    parsed = parser.parse_args(args)
    if parsed.command != "prices":
        try:
            if parsed.top < 0 or parsed.count < 0:
                raise ValueError("--top and --count must be nonnegative")
            if parsed.today and parsed.until:
                raise ValueError("--today cannot be combined with --until")
            calendar = Calendar.make(parsed.timezone)
            bounds(parsed, calendar, datetime.now(UTC))
            price_overrides(parsed.price, {})
        except (ValueError, OverflowError, ZoneInfoNotFoundError) as exc:
            parser.error(f"Invalid date, timezone, or price option: {exc}")
    return parsed


def main(argv: Optional[list] = None) -> int:
    args = parse_args(argv)
    try:
        price_catalog = load_price_catalog(args.offline_prices)
    except (OSError, ValueError) as exc:
        print(f"oai-usage: {exc}", file=sys.stderr)
        return 1
    if args.command == "prices":
        rows = [{"model": model, "input": str(p.input), "cached": str(p.cached), "output": str(p.output),
                 "cache_write": str(p.write) if p.write is not None else None, "source": p.source,
                 "long_context_threshold": p.long_threshold, "long_context_scope": p.long_scope,
                 "long_input": str(p.long_input) if p.long_input is not None else None,
                 "long_cached_input": str(p.long_cached) if p.long_cached is not None else None,
                 "long_cache_write": str(p.long_write) if p.long_write is not None else None,
                 "long_output": str(p.long_output) if p.long_output is not None else None}
                for model, p in price_catalog.prices.items()]
        if args.json:
            print(json.dumps({"verified_at": price_catalog.verified_at,
                              "catalog_source": price_catalog.origin, "prices": rows}, ensure_ascii=False, indent=2))
        else:
            print(f"Standard API prices · USD / 1M tokens · Verified {price_catalog.verified_at} · {price_catalog.origin}")
            print("\n".join(table(["Model", "Input", "Cached", "Output", "Write"],
                [[r['model'], r['input'], r['cached'], r['output'], r['cache_write'] or '-'] for r in rows])))
            print("\nLong-context prices apply above each model's listed input-token threshold.")
            for r in rows:
                rule = (f" · >{r['long_context_threshold']:,} per {r['long_context_scope']}: "
                        f"input {r['long_input']}, cached {r['long_cached_input']}, "
                        f"write {r['long_cache_write'] or '-'}, output {r['long_output']}") if r['long_context_threshold'] else ""
                print(f"{r['model']}{rule}: {r['source']}")
        return 0
    calendar = Calendar.make(args.timezone)
    prices = price_overrides(args.price, price_catalog.prices)
    codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    roots = [Path(r).expanduser().resolve() for r in args.root] if args.root else [codex_home / "sessions", codex_home / "archived_sessions"]
    json_stdout = args.json or args.output == "-"
    tty_watch = args.command == "watch" and sys.stdout.isatty() and not json_stdout
    colors = not args.no_color and "NO_COLOR" not in os.environ and (args.color or sys.stdout.isatty())
    scanner = Scanner()
    cache = ReportCache()
    poller = None
    screen_started = False
    try:
        if args.command == "watch" and args.quota in ("auto", "live"):
            poller = QuotaPoller(args.codex_binary, args.timeout, args.quota_interval)
            poller.start()
        count = 0
        next_price_refresh = time.monotonic() + 3600
        while True:
            tick = time.monotonic()
            if args.command == "watch" and tick >= next_price_refresh:
                refreshed = load_price_catalog(args.offline_prices)
                if refreshed.verified_at >= price_catalog.verified_at:
                    price_catalog = refreshed
                    prices = price_overrides(args.price, price_catalog.prices)
                next_price_refresh = tick + 3600
            data = report(args, scanner, prices, calendar, roots, poller, cache, price_catalog)
            if args.output and args.output != "-":
                protected = {Path(__file__).resolve(), PRICE_FILE, price_cache_path()} | set(scanner.cache)
                write_json(Path(args.output), data, protected)
            if json_stdout:
                print(json.dumps(data, ensure_ascii=False, allow_nan=False,
                                 indent=None if args.command == "watch" else 2), flush=True)
            else:
                size = shutil.get_terminal_size((120, 40))
                body = render(data, args, calendar, size.columns)
                if tty_watch:
                    if not screen_started:
                        sys.stdout.write("\033[?1049h\033[?25l")
                        screen_started = True
                    footer = fit(f"Refresh {args.refresh:g}s · {datetime.now().strftime('%H:%M:%S')} · Ctrl+C to quit", size.columns)
                    lines = [fit(line, size.columns) for line in body.splitlines()]
                    available = max(1, size.lines - 3)
                    if len(lines) > available:
                        notice = fit("… Full details: oai-usage --all or --output report.json", size.columns)
                        lines = lines[:max(0, available - 1)] + [notice]
                    if colors:
                        lines = [style_line(line) for line in lines]
                    sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n\n" + footer)
                    sys.stdout.flush()
                else:
                    print("\n".join(style_line(line) for line in body.splitlines()) if colors else body, flush=True)
                    if args.output:
                        print(f"\nJSON saved: {args.output}")
            count += 1
            if args.command != "watch" or (args.count and count >= args.count):
                return 0 if data["diagnostics"]["files"] else 1
            time.sleep(max(.05, args.refresh - (time.monotonic() - tick)))
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        # Avoid a second BrokenPipeError when Python flushes stdout during shutdown.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except (OSError, AttributeError):
            pass
        return 0
    except (OSError, ValueError, OverflowError) as exc:
        print(f"oai-usage: {exc}", file=sys.stderr)
        return 1
    finally:
        if poller:
            poller.stop()
        if screen_started:
            sys.stdout.write("\033[?1049l\033[?25h")
            sys.stdout.flush()


if __name__ == "__main__":
    raise SystemExit(main())
