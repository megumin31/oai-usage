def robust_median(values: list) -> Optional[float]:
    values = sorted(values)
    return (values[(len(values) - 1) // 2] + values[len(values) // 2]) / 2 if values else None


def robust_exposure_partition(intervals: list, fraction: float = 2 / 3) -> Optional[dict]:
    """Chronological split of unioned target-workload observation exposure.

    Geometry is frozen before fitting and shared across timing alternatives.
    Overlapping variants supply no extra exposure or independent support.
    """
    if not 0 < fraction < 1:
        raise ValueError("Exposure fraction must lie strictly between zero and one")
    merged = []
    for start, end in sorted(set(intervals)):
        if end <= start:
            raise ValueError("Exposure intervals must have positive duration")
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    if not merged:
        return None
    total = sum((end - start).total_seconds() for start, end in merged)
    def point(target):
        for start, end in merged:
            duration = (end - start).total_seconds()
            if target <= duration:
                return start + timedelta(seconds=target)
            target -= duration
        return merged[-1][1]
    return {"start": merged[0][0], "end": merged[-1][1], "cutoff": point(total * fraction),
            "training_midpoint": point(total * fraction / 2),
            "observed_exposure_seconds": total, "interval_count": len(merged)}


def robust_endpoint_error(snapshot: dict, envelope: float, *, clip_endpoints: bool = True) -> tuple:
    used = snapshot["used_percent"]
    if not clip_endpoints:
        return -envelope, envelope
    # eta = displayed - true usage; clipping is asymmetric at 0 and 100.
    return used - min(100, used + envelope), used - max(0, used - envelope)


class _RobustChainSlopeHull:
    """Upper hull of exact dyadic coordinates, queried to its right.

    The minimum slope from a query to an earlier point is attained on this
    hull. Hull insertion is amortized O(1); tangent search is O(log n).
    Equal-x points are held separately until x advances: they impose a
    zero-cost constraint but must never be used as a slope denominator.
    """
    def __init__(self):
        self.points = []
        self.pending = None

    def advance(self, x):
        if self.pending is not None and self.pending[0] < x:
            point = self.pending
            self.pending = None
            # Aggregate allowances can move a query past a zero-cost start
            # before the next start at that same x arrives.
            if self.points and self.points[-1][0] == point[0]:
                if self.points[-1][1] >= point[1]:
                    return
                self.points.pop()
            while len(self.points) >= 2:
                a, b = self.points[-2:]
                if ((b[0] - a[0]) * (point[1] - b[1]) <
                        (b[1] - a[1]) * (point[0] - b[0])):
                    break
                self.points.pop()
            self.points.append(point)

    def add(self, x, y, index):
        # advance() has already moved every smaller-x group onto the hull.
        if self.pending is None or y > self.pending[1]:
            self.pending = (x, y, index)

    def tangent(self, x, y):
        if not self.points:
            return None
        left, right = 0, len(self.points) - 1
        while left < right:
            middle = (left + right) // 2
            a, b = self.points[middle:middle + 2]
            if (y - a[1]) * (x - b[0]) <= (y - b[1]) * (x - a[0]):
                right = middle
            else:
                left = middle + 1
        return self.points[left][2]


def _robust_chain_integer_coordinates(values):
    """Represent floats on one exact power-of-two grid, without rounding.

    Integer cross products keep hull predicates correct for tiny costs and
    almost-collinear points, where floating cross products can underflow or
    cancel. This changes neither prefix accumulation nor reported arithmetic.
    """
    ratios = [value.as_integer_ratio() for value in values]
    exponent = max(denominator.bit_length() for _, denominator in ratios)
    return [numerator << (exponent - denominator.bit_length())
            for numerator, denominator in ratios]


def _robust_chain_clean_portions(blocks, clean_ids, clean_portions):
    """Validate optional disjoint contiguous aggregate near-clean budgets."""
    if clean_portions is None:
        return None
    positions = {}
    for index, block in enumerate(blocks):
        if block["id"] in positions:
            raise ValueError("Aggregate clean portions require unique block IDs")
        positions[block["id"]] = index
    membership, portion_ids = {}, set()
    for portion in clean_portions:
        portion_id, ids = portion["id"], portion["atomic_block_ids"]
        if portion_id in portion_ids:
            raise ValueError("Clean portion IDs must be unique")
        portion_ids.add(portion_id)
        if not ids or len(set(ids)) != len(ids) or any(key not in positions for key in ids):
            raise ValueError("Clean portions require nonempty unique known atomic block IDs")
        indices = [positions[key] for key in ids]
        if indices != list(range(indices[0], indices[0] + len(indices))):
            raise ValueError("Clean portion atomic blocks must be contiguous and in chain order")
        for left, right in zip(indices, indices[1:]):
            if blocks[left]["after"]["id"] != blocks[right]["before"]["id"]:
                raise ValueError("Clean portions cannot cross a chain gap")
        for key in ids:
            if key in membership:
                raise ValueError("Clean portions must not overlap")
            membership[key] = portion
    if set(membership) != set(clean_ids):
        raise ValueError("Clean IDs must equal the union of clean portion atomic block IDs")
    return membership


def robust_rate_interval(blocks: list, clean_ids: set, envelope: float, *, clip_endpoints: bool = True,
                         clean_portions: Optional[list] = None) -> dict:
    """Exact chain difference-constraint interval, in O(n log n) time.

    Every subchain supplies a one-sided upper slope bound. A wholly near-clean
    subchain also supplies a lower bound. Omitted edges break the chain. Two
    streaming convex hulls optimize all these subchains without independently
    choosing errors for an endpoint shared by neighboring observations.

    Optional clean_portions apply each 5% budget to an entire selected portion,
    not separately to its constituent raw edges. A lower subpath touches whole
    portion budgets, so its denominator is its own cost plus rho times the full
    cost of all portions it touches. Dirty gaps break lower-bound reachability.

    To see sufficiency, set z_i = Q_i - eta_i - a*C_i. Raw edges require z to
    be nondecreasing; a clean portion [s,t] adds z_t-z_s <= rho*a*(C_t-C_s).
    The difference graph has backward zero-weight edges and these nonnegative
    forward chords. Only cycles through the endpoint-box ground node can be
    negative. Backward paths yield the upper bounds; shortest forward paths
    pay each touched portion once, including partial entry/exit portions.

    The upper hull uses points (C_i,Q_i-u_i) and queries (C_j,Q_j-l_j).
    Negating the lower ordinate reduces its maximum slope to another minimum:
    points (C_i+rho*C_s,l_i-Q_i), queries (C_j+rho*C_t,u_j-Q_j), where s/t
    are the full touched-portion boundaries. Costs are monotone, so insertion
    is amortized constant time and each tangent takes logarithmic time.
    """
    membership = _robust_chain_clean_portions(blocks, clean_ids, clean_portions)
    chains, chain = [], []
    for block in blocks:
        cost = block["known_api_cost_usd"]
        if not math.isfinite(cost) or cost < 0:
            raise ValueError("Chain costs must be finite and nonnegative")
        if chain and chain[-1]["after"]["id"] != block["before"]["id"]:
            chains.append(chain)
            chain = []
        chain.append(block)
    if chain:
        chains.append(chain)
    low, high, feasible = 0.0, float("inf"), True
    lower_binding, upper_binding = None, None
    lower_key, upper_key = None, None
    rho = ROBUST_PROTOCOL["near_clean_external_fraction"]
    rho_numerator, rho_denominator = rho.as_integer_ratio()
    for chain_number, chain in enumerate(chains):
        costs, quotas = [0.0], [0.0]
        snapshots = [chain[0]["before"]] + [b["after"] for b in chain]
        for b in chain:
            costs.append(costs[-1] + b["known_api_cost_usd"])
            quotas.append(quotas[-1] + b["delta_percent"])
        if not all(math.isfinite(value) for value in costs + quotas):
            raise ValueError("Chain cumulative costs and deltas must be finite")
        errors = [robust_endpoint_error(s, envelope, clip_endpoints=clip_endpoints) for s in snapshots]
        count = len(snapshots)
        xs = _robust_chain_integer_coordinates(costs)
        ys = _robust_chain_integer_coordinates(quotas + [e[0] for e in errors] + [e[1] for e in errors])
        qs, ls, us = ys[:count], ys[count:2 * count], ys[2 * count:]
        portions = [None] * len(chain)
        if membership is None:
            for index, block in enumerate(chain):
                if block["id"] in clean_ids:
                    portions[index] = (index, index + 1, None)
        else:
            indices = {block["id"]: index for index, block in enumerate(chain)}
            for index, block in enumerate(chain):
                portion = membership.get(block["id"])
                if portion is not None:
                    ids = portion["atomic_block_ids"]
                    portions[index] = (indices[ids[0]], indices[ids[-1]] + 1, portion["id"])
        upper_hull, lower_hull = _RobustChainSlopeHull(), _RobustChainSlopeHull()
        upper_hull.add(xs[0], qs[0] - us[0], 0)
        for j, block in enumerate(chain, 1):
            lj, uj = errors[j]
            upper_hull.advance(xs[j])
            i = upper_hull.tangent(xs[j], qs[j] - ls[j])
            if i is not None:
                li, ui = errors[i]
                cost, quota = costs[j] - costs[i], quotas[j] - quotas[i]
                upper_rate = (quota - (lj - ui)) / cost
                key = (chain_number, i, j)
                if upper_rate < high or (upper_rate == high and upper_key is not None and key < upper_key):
                    high, upper_key = upper_rate, key
                    upper_binding = (chain, i, j, cost, quota, lj - ui, uj - li, upper_rate)
            if upper_hull.pending is not None:
                i = upper_hull.pending[2]
                if (quotas[j] - quotas[i]) - (lj - errors[i][1]) < -1e-10:
                    feasible = False
            upper_hull.add(xs[j], qs[j] - us[j], j)
            portion = portions[j - 1]
            if portion is not None:
                start, end, _ = portion
                # Interior entry pays the entire touched portion's allowance.
                # At a shared boundary the start uses the following portion,
                # while this end uses the preceding one.
                start_x = rho_denominator * xs[j - 1] + rho_numerator * xs[start]
                query_x = rho_denominator * xs[j] + rho_numerator * xs[end]
                lower_hull.advance(start_x)
                lower_hull.add(start_x, ls[j - 1] - qs[j - 1], j - 1)
                lower_hull.advance(query_x)
                i = lower_hull.tangent(query_x, us[j] - qs[j])
                if i is not None:
                    li, ui = errors[i]
                    cost, quota = costs[j] - costs[i], quotas[j] - quotas[i]
                    cover_start = portions[i][0]
                    budget_cost = costs[end] - costs[cover_start]
                    denominator = ((1 + rho) * cost if membership is None else cost + rho * budget_cost)
                    numerator = quota - (uj - li)
                    lower_rate = (numerator / denominator if denominator else
                                  (math.copysign(float("inf"), numerator) if numerator else 0.0))
                    key = (chain_number, i, j)
                    if lower_rate > low or (lower_rate == low and lower_key is not None and key < lower_key):
                        low, lower_key = lower_rate, key
                        extra = None
                        if membership is not None:
                            extra = (portions, cover_start, end, budget_cost, denominator)
                        lower_binding = (chain, i, j, cost, quota, lj - ui, uj - li, lower_rate, extra)
                if lower_hull.pending is not None:
                    i = lower_hull.pending[2]
                    if (quotas[j] - quotas[i]) - (uj - errors[i][0]) > 1e-10:
                        feasible = False
            else:
                lower_hull = _RobustChainSlopeHull()
    low = max(0, low)
    if high < low and math.isclose(high, low, rel_tol=1e-12, abs_tol=0):
        low = high = (low + high) / 2
    feasible = feasible and high >= low and high > 0
    def explain(binding, lower_bound):
        if binding is None:
            return None
        path, i, j, cost, quota, error_low, error_high, rate = binding[:8]
        extra = binding[8] if len(binding) > 8 else None
        before, after = path[i]["before"], path[j - 1]["after"]
        result = {"before_id": before["id"], "after_id": after["id"],
                "before_observed_at": before.get("observed_at"), "after_observed_at": after.get("observed_at"),
                "before_used_percent": before["used_percent"], "after_used_percent": after["used_percent"],
                "block_ids": [b["id"] for b in path[i:j]], "block_count": j - i,
                "cost_usd": cost, "observed_delta_percent": quota,
                "endpoint_error_difference": {"lower": error_low, "upper": error_high},
                "all_near_clean": all(b["id"] in clean_ids for b in path[i:j]),
                "near_clean_external_fraction": rho if lower_bound else None,
                "rate_bound": rate, "capacity_bound_usd": 100 / rate if rate > 0 else None,
                "capacity_bound_side": "upper" if lower_bound else "lower",
                "formula": "(delta - error_difference.upper) / ((1 + rho) * cost)" if lower_bound else
                           "(delta - error_difference.lower) / cost"}
        if extra is not None:
            portions, start, end, budget_cost, denominator = extra
            selected = []
            for k in range(start, end):
                if not selected or selected[-1] != portions[k][2]:
                    selected.append(portions[k][2])
            result.update({"clean_portion_ids": selected, "near_clean_budget_cost_usd": budget_cost,
                           "near_clean_denominator_cost_usd": denominator})
            result["formula"] = "(delta - error_difference.upper) / (cost + rho * near_clean_budget_cost)"
        return result
    return {"lower": low, "upper": high if math.isfinite(high) else None,
            "feasible": feasible, "chain_count": len(chains), "chain_lengths": [len(c) for c in chains],
            "interval_kind": "conditional_feasible_rate_bounds", "not_statistical_confidence_interval": True,
            "binding_constraints": {"rate_lower": explain(lower_binding, True), "rate_upper": explain(upper_binding, False)}}


def robust_rate_contains(interval: dict, rate: Optional[float]) -> bool:
    if rate is None or rate <= 0 or not interval["feasible"]:
        return False
    lower, upper = interval["lower"], interval["upper"]
    return ((rate >= lower or math.isclose(rate, lower, rel_tol=1e-12, abs_tol=0)) and
            (upper is None or rate <= upper or math.isclose(rate, upper, rel_tol=1e-12, abs_tol=0)))


def robust_weights(blocks: list, envelope: float, target_span: float, cap: Optional[float] = None) -> dict:
    raw = {b["id"]: b["known_api_cost_usd"] / (2 * envelope) * min(1, b["span_seconds"] / target_span)
           for b in blocks if b["known_api_cost_usd"] > 0}
    if cap is None:
        cap = (robust_median(list(raw.values())) or 0) * ROBUST_PROTOCOL["weight_cap_times_median"]
    return {key: min(value, cap) for key, value in raw.items()}


def robust_endpoint_disjoint_subset(support: list, weights: dict) -> tuple:
    """Maximize cardinality, then Kish concentration, without a phase choice.

    A path of 2k-1 edges has one maximum matching; a path of 2k edges has
    k+1 (including mixed-phase) maximum matchings. Disconnected paths cannot
    be optimized separately for Kish: maximize S*S/Q on the convex hull of
    their summed (S, Q) options instead. Quadratic-over-linear is convex for
    Q > 0, so a hull vertex attains the optimum. Hull vertices grow at most
    additively under Minkowski addition, avoiding an exponential product of
    path choices. Cycles are handled exactly too. Unexpected branching uses
    a disclosed bounded search; ordinary chronological blocks form paths.

    This is an engineering weight-concentration summary, not independent
    sampling, and never uses quota/cost ratios to choose the subset.
    """
    support = sorted(support, key=lambda b: (timestamp(b["before"]["observed_at"]),
        timestamp(b["after"]["observed_at"]), b["id"]))
    adjacency = defaultdict(list)
    boundaries = []
    for i, block in enumerate(support):
        pair = (block["before"]["id"], block["after"]["id"])
        boundaries.append(set(pair))
        for endpoint in set(pair):
            adjacency[endpoint].append(i)
    scale = max((weights.get(b["id"], 0) for b in support), default=0) or 1
    values = [weights.get(b["id"], 0) / scale for b in support]

    def candidate(indices):
        indices = tuple(sorted(indices))
        return (math.fsum(values[i] for i in indices),
                math.fsum(values[i] * values[i] for i in indices), indices)

    def hull(points):
        unique = {}
        for s, q, ids in points:
            if (s, q) not in unique or ids < unique[s, q]:
                unique[s, q] = ids
        ordered = [(s, q, unique[s, q]) for s, q in sorted(unique)]
        if len(ordered) < 3:
            return ordered
        def cross(a, b, c):
            return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
        lower, upper = [], []
        for p in ordered:
            while len(lower) > 1 and cross(lower[-2], lower[-1], p) <= 0:
                lower.pop()
            lower.append(p)
        for p in reversed(ordered):
            while len(upper) > 1 and cross(upper[-2], upper[-1], p) <= 0:
                upper.pop()
            upper.append(p)
        return lower[:-1] + upper[:-1]

    components, unseen = [], set(range(len(support)))
    while unseen:
        todo, members = [min(unseen)], set()
        while todo:
            i = todo.pop()
            if i in members:
                continue
            members.add(i)
            unseen.discard(i)
            todo.extend(j for endpoint in boundaries[i] for j in adjacency[endpoint] if j not in members)
        components.append(sorted(members))
    aggregate = [(0.0, 0.0, ())]
    exact, nonpath_components, search_states = True, 0, 0
    state_limit = 50000
    for members in components:
        endpoints = {endpoint for i in members for endpoint in boundaries[i]}
        is_path_or_cycle = all(len(adjacency[e]) <= 2 for e in endpoints) and all(len(boundaries[i]) == 2 for i in members)
        if is_path_or_cycle:
            ends = sorted(e for e in endpoints if len(adjacency[e]) == 1)
            endpoint = ends[0] if ends else min(endpoints)
            path, seen = [], set()
            while True:
                choices = [i for i in adjacency[endpoint] if i not in seen]
                if not choices:
                    break
                i = min(choices)
                path.append(i)
                seen.add(i)
                endpoint = next(e for e in boundaries[i] if e != endpoint)
            n = len(path)
            if ends:
                choices = [path[::2]] if n % 2 else [path[:2 * split:2] + path[2 * split + 1::2]
                                                     for split in range(n // 2 + 1)]
            elif n % 2:
                choices = [[path[(start + 2 * j) % n] for j in range(n // 2)] for start in range(n)]
            else:
                choices = [path[::2], path[1::2]]
            options = hull(candidate(ids) for ids in choices)
        else:
            # Defensive fallback for a malformed/non-chain caller. Never imply
            # an optimal result when this finite search budget is exhausted.
            nonpath_components += 1
            best_count, options, states = -1, [], 0
            # Seed complete feasible witnesses even if an unusually large
            # component exhausts its search budget before the first leaf.
            for ordering in (members, list(reversed(members))):
                used, chosen = set(), []
                for i in ordering:
                    if not boundaries[i] & used:
                        chosen.append(i)
                        used.update(boundaries[i])
                if len(chosen) > best_count:
                    best_count, options = len(chosen), []
                if len(chosen) == best_count:
                    options.append(candidate(chosen))
            stack = [(0, frozenset(), ())]
            while stack and states < state_limit:
                position, used, chosen = stack.pop()
                states += 1
                if len(chosen) + len(members) - position < best_count:
                    continue
                if position == len(members):
                    if len(chosen) > best_count:
                        best_count, options = len(chosen), []
                    if len(chosen) == best_count:
                        options.append(candidate(chosen))
                    continue
                i = members[position]
                stack.append((position + 1, used, chosen))
                if not boundaries[i] & used:
                    stack.append((position + 1, used | boundaries[i], chosen + (i,)))
            exact = exact and not stack
            search_states += states
            options = hull(options)
        aggregate = hull((a[0] + b[0], a[1] + b[1], tuple(sorted(a[2] + b[2])))
                         for a in aggregate for b in options)
    winner = min(aggregate, key=lambda p: (-(p[0] * p[0] / p[1] if p[1] else 0), p[2]))
    return [support[i] for i in winner[2]], {
        "method": "maximum_cardinality_then_maximum_kish_convex_hull" if exact else "bounded_nonpath_matching_search_then_convex_hull",
        "maximum_cardinality_guaranteed": exact, "maximum_concentration_guaranteed": exact,
        "component_count": len(components), "nonpath_component_count": nonpath_components,
        "bounded_heuristic_used": not exact, "nonpath_search_state_limit": state_limit,
        "nonpath_search_states": search_states,
        "tie_break": "chronological_block_ids", "objective_inputs": ["endpoint_ids", "capped_weights"],
        "statistical_independence_established": False}


def robust_support(blocks: list, selected: set, weights: dict, period: Optional[tuple] = None,
                   support_midpoint: Optional[datetime] = None) -> dict:
    # Repeating a block object/ID does not create another observation or weight.
    blocks = sorted({b["id"]: b for b in blocks}.values(), key=lambda b:
        (timestamp(b["before"]["observed_at"]), timestamp(b["after"]["observed_at"]), b["id"]))
    support = [b for b in blocks if b["id"] in selected]
    subset, selection = robust_endpoint_disjoint_subset(support, weights)
    values = [weights.get(b["id"], 0) for b in subset]
    total_weight = sum(weights.values())
    effective = sum(values) ** 2 / sum(v * v for v in values) if any(values) else 0
    if period is None and blocks:
        period = (timestamp(blocks[0]["before"]["observed_at"]), max(timestamp(b["after"]["observed_at"]) for b in blocks))
    midpoint = support_midpoint if support_midpoint is not None else period[0] + (period[1] - period[0]) / 2 if period else None
    first_half, second_half = set(), set()
    for block in blocks:
        center = timestamp(block["before"]["observed_at"]) + (timestamp(block["after"]["observed_at"]) - timestamp(block["before"]["observed_at"])) / 2
        (first_half if midpoint is not None and center <= midpoint else second_half).add(block["id"])
    return {"block_count": len(blocks), "support_block_count": len(support),
            "support_weight_fraction": sum(weights.get(b["id"], 0) for b in support) / total_weight if total_weight else 0,
            "independent_support_count": len(subset), "effective_support": effective,
            "endpoint_disjoint_block_ids": [b["id"] for b in subset],
            "endpoint_disjoint_selection": selection, "statistical_independence_established": False,
            "span_seconds": sum(b["span_seconds"] for b in support),
            "observation_span_seconds": (max(timestamp(b["after"]["observed_at"]) for b in support) - timestamp(support[0]["before"]["observed_at"])).total_seconds() if support else 0,
            "capped_weights": dict(weights),
            "two_halves_supported": bool(selected & first_half and selected & second_half)}


def robust_grouped_support(blocks: list, selected: set, weights: dict, rate: Optional[float],
                           envelope: float, period: Optional[tuple] = None,
                           support_midpoint: Optional[datetime] = None) -> dict:
    """Information diagnostic at a frozen rate, without refitting or pooling.

    Adjacent selected atomic constraints accumulate until their predicted
    signal reaches E. Internal observations and per-edge nuisance constraints
    remain in robust_rate_interval; these groups only define support units.
    """
    groups, pending, unused, cost = [], [], [], 0.0
    for block in blocks:
        adjacent = not pending or (pending[-1]["after"]["id"] == block["before"]["id"] and
            all(pending[-1].get(key) == block.get(key) for key in
                ("quota_epoch_id", "profile", "policy_id", "alignment_offset_seconds")))
        if block["id"] not in selected or not adjacent:
            unused.extend(b["id"] for b in pending)
            pending, cost = [], 0.0
        if block["id"] not in selected:
            continue
        pending.append(block)
        cost += block["known_api_cost_usd"]
        if rate is not None and rate > 0 and cost > 0 and rate * cost >= envelope - 1e-10:
            groups.append({"id": f"signal-group:{pending[0]['id']}:{pending[-1]['id']}",
                           "before": pending[0]["before"], "after": pending[-1]["after"],
                           "known_api_cost_usd": cost,
                           "delta_percent": sum(b["delta_percent"] for b in pending),
                           "span_seconds": sum(b["span_seconds"] for b in pending),
                           "atomic_block_ids": [b["id"] for b in pending]})
            pending, cost = [], 0.0
    unused.extend(b["id"] for b in pending)
    group_weights = {g["id"]: sum(weights.get(bid, 0) for bid in g["atomic_block_ids"]) for g in groups}
    support = robust_support(groups, {g["id"] for g in groups}, group_weights, period, support_midpoint)
    covered = {bid for g in groups for bid in g["atomic_block_ids"]}
    total_weight = sum(weights.values())
    support.update(support_weight_fraction=sum(weights.get(bid, 0) for bid in covered) / total_weight if total_weight else 0,
                   groups=[{"id": g["id"], "atomic_block_ids": g["atomic_block_ids"],
                            "before_id": g["before"]["id"], "after_id": g["after"]["id"],
                            "predicted_delta_percent": rate * g["known_api_cost_usd"],
                            "span_seconds": g["span_seconds"]} for g in groups],
                   covered_atomic_block_count=len(covered), unused_low_signal_block_ids=unused,
                   clean_predicted_delta_percent=rate * sum(g["known_api_cost_usd"] for g in groups) if rate else None,
                   statistical_independence_established=False)
    return support


def robust_discover_components(blocks: list, weights: dict, envelope: float, period: Optional[tuple] = None,
                               support_midpoint: Optional[datetime] = None) -> list:
    rho = ROBUST_PROTOCOL["near_clean_external_fraction"]
    intervals = []
    for b in blocks:
        cost = b["known_api_cost_usd"]
        if cost <= 0:
            continue
        la, ua = robust_endpoint_error(b["before"], envelope)
        lb, ub = robust_endpoint_error(b["after"], envelope)
        intervals.append((max(envelope / cost, (b["delta_percent"] - (ub - la)) / ((1 + rho) * cost)),
                          max(0, (b["delta_percent"] - (lb - ua)) / cost), b["id"]))
    # Support intervals are closed. Their boundary points are distinct cells:
    # a singleton or a crossing-only maximum must not vanish in a midpoint
    # sweep. Discard empty intervals before adding cuts; never bridge a gap.
    intervals = [(lo, hi, bid) for lo, hi, bid in intervals if 0 < hi and lo <= hi]
    cuts = sorted({x for lo, hi, bid in intervals for x in (lo, hi)})
    regions = []
    cells = []
    for i, cut in enumerate(cuts):
        cells.append((cut, cut, "boundary_point"))
        if i + 1 < len(cuts):
            cells.append((cut, cuts[i + 1], "open_interval"))
    for lo, hi, kind in cells:
        # With all interval endpoints in cuts, coverage of an open cell is
        # equivalent to coverage of both its endpoints. Avoid midpoint
        # rounding, which can turn a tiny open cell into a boundary point.
        ids = {bid for low, high, bid in intervals if low <= lo and hi <= high}
        if not ids:
            continue
        support = robust_support(blocks, ids, weights, period, support_midpoint)
        qualified = support["support_weight_fraction"] >= 0.25
        regions.append({"lower": lo, "upper": hi, "cell_kind": kind, "selected_block_ids": sorted(ids),
                        "weight": sum(weights.get(bid, 0) for bid in ids), "qualified": qualified, "support": support})
    qualified = [r for r in regions if r["qualified"]]
    components = []
    for region in qualified:
        if components and components[-1]["upper"] == region["lower"]:
            component = components[-1]
            component["upper"] = region["upper"]
            if region["weight"] > component["peak"]["weight"]:
                component["peak"] = region
        else:
            components.append({"lower": region["lower"], "upper": region["upper"], "qualified": True, "peak": region})
    if not components and regions:
        # Explicitly unqualified density diagnostic; never a max-capacity fallback.
        region = max(regions, key=lambda r: (r["weight"], r["support"]["independent_support_count"], -r["lower"]))
        components.append({"lower": region["lower"], "upper": region["upper"], "qualified": False, "peak": region})
    return [{"id": f"component-{i + 1}", "rate_interval": {"lower": c["lower"], "upper": c["upper"]},
             "qualified": c["qualified"], "selected_block_ids": c["peak"]["selected_block_ids"],
             "peak_cell": {"kind": c["peak"]["cell_kind"], "lower": c["peak"]["lower"], "upper": c["peak"]["upper"]},
             "support": c["peak"]["support"], "weight": c["peak"]["weight"]} for i, c in enumerate(components)]


def robust_cache_fraction(blocks: list) -> Optional[float]:
    if not blocks or any(not b.get("cache_mix_complete") or not isinstance(b.get("usage"), dict) or
                         any(k not in b["usage"] for k in ("input_tokens", "cached_input_tokens")) for b in blocks):
        return None
    total = sum(b["usage"]["input_tokens"] for b in blocks)
    return sum(b["usage"]["cached_input_tokens"] for b in blocks) / total if total else None


def robust_fit_blocks(training: list, holdout: list, all_blocks: list, *, envelope: float, target_span: float,
                      training_period: Optional[tuple] = None, training_support_midpoint: Optional[datetime] = None) -> dict:
    raw_weights = [b["known_api_cost_usd"] / (2 * envelope) * min(1, b["span_seconds"] / target_span) for b in training if b["known_api_cost_usd"] > 0]
    weight_cap = 4 * (robust_median(raw_weights) or 0)
    weights = robust_weights(training, envelope, target_span, weight_cap)
    components = robust_discover_components(training, weights, envelope, training_period, training_support_midpoint)
    for component in components:
        ids = set(component["selected_block_ids"])
        component_support = robust_support(training, ids, weights, training_period, training_support_midpoint)
        physical = robust_rate_interval(training, ids, envelope)
        cost = sum(b["known_api_cost_usd"] for b in training if b["id"] in ids)
        quota = sum(b["delta_percent"] for b in training if b["id"] in ids)
        raw = quota / cost if cost else None
        rate = min(max(raw, physical["lower"]), physical["upper"]) if raw is not None and physical["feasible"] and physical["upper"] is not None else None
        rate = rate if rate is not None and rate > 0 else None
        failures = []
        if not component["qualified"] or component_support["support_weight_fraction"] < 0.25:
            failures.append("insufficient_training_support_weight")
        if component_support["independent_support_count"] < 3 or component_support["effective_support"] < 3 - 1e-9:
            failures.append("insufficient_training_endpoint_disjoint_support")
        if not component_support["two_halves_supported"]:
            failures.append("training_support_not_repeated_across_time")
        if component_support["span_seconds"] < 2 * target_span:
            failures.append("insufficient_training_support_duration")
        if not physical["feasible"]:
            failures.append("training_shared_endpoint_infeasible")
        if rate is None:
            failures.append("no_positive_candidate_rate")
        if rate is None or rate * cost < 10 - 1e-10:
            failures.append("insufficient_training_quota_information")
        if rate is None or any(rate * b["known_api_cost_usd"] < envelope - 1e-10 for b in training if b["id"] in ids):
            failures.append("frozen_core_information_gate_failed")
        component.update(training_support=component_support, physical_rate_interval=physical,
                         raw_ratio_of_sums_a=raw, a_percent_per_usd=rate, training_gate_reasons=failures,
                         clipped=rate is not None and raw is not None and not math.isclose(rate, raw, rel_tol=1e-12, abs_tol=0))
    survivors = [c for c in components if not c["training_gate_reasons"]]
    selected_component = survivors[0] if survivors else components[0] if components else None
    selected = set(selected_component["selected_block_ids"]) if selected_component else set()
    support = robust_support(training, selected, weights, training_period, training_support_midpoint)
    interval = robust_rate_interval(training, selected, envelope)
    picked = [b for b in training if b["id"] in selected]
    cost = sum(b["known_api_cost_usd"] for b in picked)
    raw_a = selected_component["raw_ratio_of_sums_a"] if selected_component else None
    a = selected_component["a_percent_per_usd"] if selected_component else None
    amount = 100 / a if a else None
    lower = 100 / interval["upper"] if interval["feasible"] and interval["upper"] and interval["upper"] > 0 else None
    upper = 100 / interval["lower"] if interval["feasible"] and interval["lower"] > 0 else None
    reasons = list(selected_component["training_gate_reasons"]) if selected_component else ["no_repeated_low_rate_cluster", "no_positive_candidate_rate"]
    if not survivors:
        reasons.append("no_repeated_low_rate_cluster")
    if amount is None or lower is None or upper is None or (upper - lower) / amount > 0.5:
        reasons.append("wide_or_unbounded_conditional_range")
    if len(survivors) > 1:
        first_rate = survivors[0]["a_percent_per_usd"]
        if first_rate and any((c["a_percent_per_usd"] - first_rate) / first_rate > 0.25 for c in survivors[1:]):
            reasons.append("multiple_separated_supported_rate_clusters")
    holdout_clean = set()
    rho = ROBUST_PROTOCOL["near_clean_external_fraction"]
    negative_count, negative_excess, positive_excess = 0, 0.0, 0.0
    residuals = []
    for b in holdout:
        if a is None:
            continue
        pred, q = a * b["known_api_cost_usd"], b["delta_percent"]
        la, ua = robust_endpoint_error(b["before"], envelope)
        lb, ub = robust_endpoint_error(b["after"], envelope)
        if pred + lb - ua <= q + 1e-10 and q <= (1 + rho) * pred + ub - la + 1e-10 and b["known_api_cost_usd"] > 0 and pred >= envelope - 1e-10:
            holdout_clean.add(b["id"])
            residuals.append(abs(q - pred))
        excess = max(0, pred + lb - ua - q)
        negative_count += excess > 1e-10
        negative_excess += excess
        positive_excess += max(0, q - pred)
    hold_weights = robust_weights(holdout, envelope, target_span, weight_cap)
    held_support = robust_support(holdout, holdout_clean, hold_weights)
    held_interval = robust_rate_interval(holdout, holdout_clean, envelope)
    held_feasible = robust_rate_contains(held_interval, a) if a is not None and holdout else None
    all_interval = robust_rate_interval(all_blocks, set(), envelope)
    one_sided_feasible = robust_rate_contains(all_interval, a) if a is not None and all_blocks else None
    if one_sided_feasible is False:
        reasons.append("one_sided_model_contradiction")
    if held_support["independent_support_count"] < 2 or held_support["effective_support"] < 2 - 1e-9:
        reasons.append("insufficient_holdout_endpoint_disjoint_support")
    if held_support["span_seconds"] < target_span:
        reasons.append("insufficient_holdout_support_duration")
    if held_support["support_weight_fraction"] < 0.25:
        reasons.append("low_rate_cluster_not_reproduced_in_holdout")
    if held_feasible is False:
        reasons.append("holdout_shared_endpoint_infeasible")
    hold_cost = sum(b["known_api_cost_usd"] for b in holdout if b["id"] in holdout_clean)
    if a is None or a * hold_cost < 5:
        reasons.append("insufficient_holdout_quota_information")
    train_cache = robust_cache_fraction(picked)
    hold_cache = robust_cache_fraction([b for b in holdout if b["id"] in holdout_clean])
    cache_change = abs(train_cache - hold_cache) if train_cache is not None and hold_cache is not None else None
    if cache_change is not None and cache_change >= 0.20 - 1e-12:
        reasons.append("workload_cache_mix_drift")
    # Additive diagnostic: freeze discovery, selected edges and the candidate.
    # Only the information accounting uses contiguous groups. In particular,
    # never raise a to E/C, discard internal endpoints, or refit on holdout.
    grouped_training = robust_grouped_support(training, selected, weights, a, envelope,
                                              training_period, training_support_midpoint)
    compatible_holdout = set()
    for b in holdout:
        if a is None or b["known_api_cost_usd"] <= 0:
            continue
        pred = a * b["known_api_cost_usd"]
        la, ua = robust_endpoint_error(b["before"], envelope)
        lb, ub = robust_endpoint_error(b["after"], envelope)
        if pred + lb - ua <= b["delta_percent"] + 1e-10 and b["delta_percent"] <= (1 + rho) * pred + ub - la + 1e-10:
            compatible_holdout.add(b["id"])
    grouped_holdout = robust_grouped_support(holdout, compatible_holdout, hold_weights, a, envelope)
    grouped_held_interval = robust_rate_interval(holdout, compatible_holdout, envelope)
    grouped_held_feasible = robust_rate_contains(grouped_held_interval, a) if a is not None and holdout else None
    replaced_gates = {"frozen_core_information_gate_failed", "insufficient_training_support_weight",
        "insufficient_training_endpoint_disjoint_support", "training_support_not_repeated_across_time",
        "insufficient_training_support_duration", "insufficient_training_quota_information",
        "no_repeated_low_rate_cluster", "insufficient_holdout_endpoint_disjoint_support",
        "insufficient_holdout_support_duration", "low_rate_cluster_not_reproduced_in_holdout",
        "holdout_shared_endpoint_infeasible", "insufficient_holdout_quota_information", "workload_cache_mix_drift"}
    grouped_reasons = [reason for reason in reasons if reason not in replaced_gates]
    for name, evidence, minimum_count, minimum_signal, minimum_duration in (
            ("training", grouped_training, 3, 10, 2 * target_span),
            ("holdout", grouped_holdout, 2, 5, target_span)):
        if evidence["independent_support_count"] < minimum_count or evidence["effective_support"] < minimum_count - 1e-9:
            grouped_reasons.append(f"insufficient_{name}_grouped_endpoint_disjoint_support")
        if evidence["support_weight_fraction"] < 0.25:
            grouped_reasons.append(f"insufficient_{name}_grouped_support_weight")
        if evidence["span_seconds"] < minimum_duration:
            grouped_reasons.append(f"insufficient_{name}_grouped_support_duration")
        if (evidence["clean_predicted_delta_percent"] or 0) < minimum_signal - 1e-10:
            grouped_reasons.append(f"insufficient_{name}_grouped_quota_information")
    if not grouped_training["two_halves_supported"]:
        grouped_reasons.append("grouped_training_support_not_repeated_across_time")
    if grouped_held_feasible is False:
        grouped_reasons.append("grouped_holdout_shared_endpoint_infeasible")
    grouped_hold_cache = robust_cache_fraction([b for b in holdout if b["id"] in compatible_holdout])
    if train_cache is not None and grouped_hold_cache is not None and abs(train_cache - grouped_hold_cache) >= .20 - 1e-12:
        grouped_reasons.append("workload_cache_mix_drift")
    one_sided_lower = 100 / all_interval["upper"] if all_interval["feasible"] and all_interval["upper"] is not None and all_interval["upper"] > 0 else None
    return {"status": "conditional_candidate" if not reasons else "diagnostic_candidate", "reasons": sorted(set(reasons)),
            "identifiability_assumptions": list(ROBUST_PROTOCOL["assumptions"]),
            "endpoint_error_percent": envelope, "weight_cap": weight_cap, "components": components,
            "selected_component_id": selected_component["id"] if selected_component else None,
            "selected_block_ids": sorted(selected), "rate_interval": interval,
            "candidate": {"a_percent_per_usd": a, "unclipped_ratio_of_sums_a": raw_a,
                          "total_api_cost_usd": amount, "conditional_range_usd": {"lower": lower, "upper": upper},
                          "range_kind": "conditional_feasible_bounds_not_confidence_interval"},
            "statistical_interval": {"status": "not_computed", "reason": ROBUST_PROTOCOL["statistical_interval"]},
            "training": {**support, "clean_predicted_delta_percent": a * cost if a else None},
            "holdout": {**held_support, "near_clean_block_ids": sorted(holdout_clean), "joint_feasible": held_feasible,
                        "consistency_assessment": "not_evaluable" if held_feasible is None else "feasible" if held_feasible else "infeasible",
                        "diagnostic_rate_interval": held_interval, "negative_residual_count": negative_count,
                        "negative_excess_percent": negative_excess, "positive_excess_percent": positive_excess,
                        "near_clean_mae_percent": sum(residuals) / len(residuals) if residuals else None,
                        "clean_predicted_delta_percent": a * hold_cost if a else None},
            "all_blocks_one_sided_feasible": one_sided_feasible,
            "one_sided_capacity_bounds": {"lower": one_sided_lower, "upper": None,
                "status": "conditional_lower_bound_only" if one_sided_lower is not None else "inconsistent_constraints" if not all_interval["feasible"] else "no_positive_cost_bound",
                "requires_near_clean_anchor": False, "finite_upper_bound_identified": False,
                "requires_valid_cost_epoch_and_bounded_endpoint_error": True,
                "rate_interval": all_interval, "not_statistical_confidence_interval": True},
            "aggregation_diagnostic": {"status": "supports_frozen_candidate" if a is not None and not grouped_reasons else "insufficient_grouped_evidence",
                "changes_primary_estimate": False, "candidate_refitted": False, "internal_atomic_constraints_retained": True,
                "minimum_predicted_signal_per_group_percent": envelope,
                "training": grouped_training, "holdout": grouped_holdout,
                "holdout_joint_feasible": grouped_held_feasible, "holdout_rate_interval": grouped_held_interval,
                "reasons": sorted(set(grouped_reasons))},
            "all_blocks_consistency_assessment": "not_evaluable" if one_sided_feasible is None else "feasible" if one_sided_feasible else "infeasible",
            "cache_mix": {"training_cached_input_fraction": train_cache, "holdout_cached_input_fraction": hold_cache,
                          "absolute_change": cache_change, "assessment": "unknown" if cache_change is None else "drift" if cache_change >= 0.20 else "within_threshold"}}


def frontier_unique_blocks(blocks: list) -> list:
    unique, physical = {}, {}
    for block in blocks:
        prior = unique.get(block["id"])
        if prior is not None and prior != block:
            raise ValueError("Conflicting repeated frontier block ID")
        unique.setdefault(block["id"], block)
        key = (block["before"]["id"], block["after"]["id"],
               block["before"].get("observed_at"), block["after"].get("observed_at"),
               repr(block.get("quota_epoch_id")), repr(block.get("profile")),
               block.get("policy_id"), block.get("alignment_offset_seconds"))
        if key in physical:
            prior = physical[key]
            if any(prior[name] != block[name] for name in ("before", "after", "known_api_cost_usd", "delta_percent", "span_seconds")):
                raise ValueError("Conflicting aliases of one physical frontier interval")
            continue
        physical[key] = block
    ordered = sorted(physical.values(), key=lambda b: (
        timestamp(b["before"].get("observed_at")) or datetime.min.replace(tzinfo=UTC),
        timestamp(b["after"].get("observed_at")) or datetime.min.replace(tzinfo=UTC), b["id"]))
    for previous, current in zip(ordered, ordered[1:]):
        previous_end = timestamp(previous["after"].get("observed_at"))
        current_start = timestamp(current["before"].get("observed_at"))
        if previous_end is not None and current_start is not None and previous_end > current_start:
            raise ValueError("Overlapping physical frontier intervals are not separate evidence")
    return ordered


def frontier_capacity_range(interval: dict) -> dict:
    feasible = interval["feasible"]
    return {"lower": 100 / interval["upper"] if feasible and interval["upper"] and interval["upper"] > 0 else None,
            "upper": 100 / interval["lower"] if feasible and interval["lower"] > 0 else None,
            "feasible": feasible, "not_confidence_interval": True}


def frontier_adjacent(left: dict, right: dict) -> bool:
    return left["after"]["id"] == right["before"]["id"] and all(
        left.get(key) == right.get(key) for key in ("quota_epoch_id", "profile", "policy_id", "alignment_offset_seconds"))


def frontier_coarsen(blocks: list, count: int) -> list:
    """Nonoverlapping timestamp-order tiling, with no quota/cost selection."""
    blocks = frontier_unique_blocks(blocks)
    groups, pending = [], []
    def flush():
        if pending:
            groups.append({"id": f"coarsen-{count}:{pending[0]['id']}:{pending[-1]['id']}",
                "before": pending[0]["before"], "after": pending[-1]["after"],
                "known_api_cost_usd": sum(b["known_api_cost_usd"] for b in pending),
                "delta_percent": sum(b["delta_percent"] for b in pending),
                "span_seconds": sum(b["span_seconds"] for b in pending),
                "atomic_block_ids": [b["id"] for b in pending], "atoms": list(pending)})
            pending.clear()
    for block in blocks:
        if pending and not frontier_adjacent(pending[-1], block):
            flush()
        pending.append(block)
        if len(pending) == count:
            flush()
    flush()
    return groups


def frontier_memberships(blocks: list, envelope: float) -> list:
    """All distinct overlap memberships; tilings never count as observations."""
    hypotheses = {}
    for count in (1, 2, 4, 8):
        intervals = []
        for unit in frontier_coarsen(blocks, count):
            if unit["known_api_cost_usd"] <= 0:
                continue
            ids = set(unit["atomic_block_ids"])
            interval = robust_rate_interval(unit["atoms"], ids, envelope)
            if interval["feasible"] and interval["upper"] is not None:
                intervals.append((interval["lower"], interval["upper"], ids))
        cuts = sorted({value for low, high, ids in intervals for value in (low, high)})
        cells = [(point, point, True) for point in cuts]
        cells.extend((low, high, False) for low, high in zip(cuts, cuts[1:]) if low < high)
        for left, right, point_cell in cells:
            if right <= 0:
                continue
            ids = frozenset(bid for low, high, members in intervals
                if (low <= left <= high if point_cell else low <= left and right <= high) for bid in members)
            if ids:
                hypotheses.setdefault(ids, set()).add(count)
    return [{"selected_block_ids": sorted(ids), "coarsening_counts": sorted(counts)}
            for ids, counts in sorted(hypotheses.items(), key=lambda item: tuple(sorted(item[0])))]


def frontier_support_groups(blocks: list, selected: set, weights: dict, rate: Optional[float], envelope: float) -> dict:
    """Maximum-count informative nonoverlapping subpaths, no swallowed prefix.

    First maximize qualifying group count, then original capped information and
    duration; chronological IDs break ties. All unused atoms remain physical
    constraints, including selected near-clean atoms. Shared endpoints are not
    independent measurements and never receive duplicated error variables.
    """
    blocks = frontier_unique_blocks(blocks)
    # DP over original edges permits skipping an uninformative prefix, but a
    # support group itself must contain an uninterrupted selected subpath.
    best = [([], 0.0, 0.0)]
    def better(left, right):
        left_key = (len(left[0]), left[1], left[2])
        right_key = (len(right[0]), right[1], right[2])
        if left_key != right_key:
            return left if left_key > right_key else right
        left_ids = tuple(g["id"] for g in left[0])
        right_ids = tuple(g["id"] for g in right[0])
        return left if left_ids <= right_ids else right
    for end, last in enumerate(blocks, 1):
        winner = best[-1]
        cost = delta = duration = information = 0.0
        for start in range(end - 1, -1, -1):
            block = blocks[start]
            if block["id"] not in selected or (start + 1 < end and not frontier_adjacent(block, blocks[start + 1])):
                break
            cost += block["known_api_cost_usd"]
            delta += block["delta_percent"]
            duration += block["span_seconds"]
            information += weights.get(block["id"], 0)
            low_before, _ = robust_endpoint_error(block["before"], envelope)
            _, high_after = robust_endpoint_error(last["after"], envelope)
            lower_signal = delta - (high_after - low_before)
            if rate is None or rate <= 0 or rate * cost < 2 * envelope - 1e-10 or lower_signal <= 1e-10:
                continue
            group = {"id": f"frontier-group:{block['id']}:{last['id']}", "before": block["before"], "after": last["after"],
                "known_api_cost_usd": cost, "delta_percent": delta, "span_seconds": duration,
                "atomic_block_ids": [b["id"] for b in blocks[start:end]], "positive_signal_lower_percent": lower_signal}
            prefix = best[start]
            winner = better(winner, (prefix[0] + [group], prefix[1] + information, prefix[2] + duration))
        best.append(winner)
    groups = best[-1][0]
    group_weights = {g["id"]: sum(weights.get(bid, 0) for bid in g["atomic_block_ids"]) for g in groups}
    support = robust_support(groups, set(group_weights), group_weights)
    covered = {bid for g in groups for bid in g["atomic_block_ids"]}
    total_weight = sum(weights.get(b["id"], 0) for b in blocks)
    covered_weight = sum(weights.get(bid, 0) for bid in covered)
    support.update(group_count=len(groups), covered_atomic_block_count=len(covered),
        original_atomic_block_count=len(blocks), covered_information_weight=covered_weight,
        support_weight_fraction=covered_weight / total_weight if total_weight else 0,
        clean_predicted_delta_percent=rate * sum(g["known_api_cost_usd"] for g in groups) if rate else None,
        positive_observed_signal_lower_sum_percent=sum(g["positive_signal_lower_percent"] for g in groups),
        unused_low_signal_block_ids=[b["id"] for b in blocks if b["id"] in selected and b["id"] not in covered],
        shared_endpoints_allowed=True, statistical_independence_established=False,
        grouping_rule="maximum_informative_nonoverlapping_groups_then_capped_information_then_duration_then_ids",
        groups=[{key: value for key, value in g.items() if key not in ("before", "after")} |
                {"before_id": g["before"]["id"], "after_id": g["after"]["id"],
                 "before_observed_at": g["before"].get("observed_at"), "after_observed_at": g["after"].get("observed_at")}
                for g in groups])
    return support


def frontier_fit(blocks: list, *, envelope: float = 1, target_span: float = 300) -> dict:
    """A retrospective conditional frontier, separate from strict validation."""
    blocks = frontier_unique_blocks(blocks)
    if blocks and any(any(b.get(key) != blocks[0].get(key) for key in
        ("quota_epoch_id", "profile", "policy_id", "alignment_offset_seconds")) for b in blocks[1:]):
        raise ValueError("Frontier fit requires one epoch, profile and timing scheme")
    raw_weights = [b["known_api_cost_usd"] / (2 * envelope) * min(1, b["span_seconds"] / target_span)
                   for b in blocks if b["known_api_cost_usd"] > 0]
    cap = 4 * (robust_median(raw_weights) or 0)
    weights = robust_weights(blocks, envelope, target_span, cap)
    hypotheses, accepted = [], []
    for serial, membership in enumerate(frontier_memberships(blocks, envelope), 1):
        ids = set(membership["selected_block_ids"])
        physical = robust_rate_interval(blocks, ids, envelope)
        cost = sum(b["known_api_cost_usd"] for b in blocks if b["id"] in ids)
        quota = sum(b["delta_percent"] for b in blocks if b["id"] in ids)
        raw = quota / cost if cost > 0 else None
        rate = min(max(raw, physical["lower"]), physical["upper"]) if raw is not None and raw > 0 and physical["feasible"] and physical["upper"] is not None else None
        support = frontier_support_groups(blocks, ids, weights, rate, envelope)
        bounds = frontier_capacity_range(physical)
        reasons = []
        if rate is None or rate <= 0:
            reasons.append("no_positive_feasible_frontier_rate")
        if not physical["feasible"]:
            reasons.append("atomic_shared_endpoint_constraints_infeasible")
        if bounds["lower"] is None or bounds["upper"] is None:
            reasons.append("no_finite_conditional_measurement_range")
        if support["group_count"] < 2:
            reasons.append("fewer_than_two_informative_nonoverlapping_groups")
        if (support["clean_predicted_delta_percent"] or 0) < 4 * envelope - 1e-10:
            reasons.append("insufficient_aggregate_quota_signal")
        row = {"id": f"frontier-hypothesis-{serial}", **membership,
            "rate_interval": physical, "a_percent_per_usd": rate, "raw_ratio_of_sums_a": raw,
            "total_api_cost_usd": 100 / rate if rate and rate > 0 else None,
            "conditional_range_usd": bounds, "support": support, "reasons": reasons,
            "status": "supported_conditional_hypothesis" if not reasons else "unsupported_hypothesis"}
        hypotheses.append(row)
        if not reasons:
            accepted.append(row)
    neighborhoods = []
    for hypothesis in sorted(accepted, key=lambda h: (h["rate_interval"]["lower"], h["rate_interval"]["upper"], h["id"])):
        interval = hypothesis["rate_interval"]
        if neighborhoods and interval["lower"] <= neighborhoods[-1]["upper"]:
            neighborhoods[-1]["upper"] = max(neighborhoods[-1]["upper"], interval["upper"])
            neighborhoods[-1]["members"].append(hypothesis)
        else:
            neighborhoods.append({"lower": interval["lower"], "upper": interval["upper"], "members": [hypothesis]})
    chosen = None
    if neighborhoods:
        # Overlapping bands cannot establish distinct frontiers. Prefer the
        # strongest original evidence there, never its most favorable B point.
        chosen = min(neighborhoods[0]["members"], key=lambda h: (
            -h["support"]["covered_information_weight"], -h["support"]["group_count"],
            -h["support"]["span_seconds"], min(h["coarsening_counts"]), tuple(h["selected_block_ids"])))
    warnings = []
    quantization = {"status": "unavailable", "rate_interval": None, "capacity_range_usd": None}
    stress = {"status": "unavailable", "rate_interval": None, "capacity_range_usd": None}
    if chosen:
        ids = set(chosen["selected_block_ids"])
        integer_display = all(float(b[side]["used_percent"]).is_integer() and 0 <= b[side]["used_percent"] < 100
                              for b in blocks for side in ("before", "after"))
        if integer_display:
            qinterval = robust_rate_interval(blocks, ids, .5, clip_endpoints=False)
            quantization = {"status": "feasible" if qinterval["feasible"] else "quantization_alone_insufficient",
                "rate_interval": qinterval, "capacity_range_usd": frontier_capacity_range(qinterval),
                "assumption": "fixed unknown-phase 1pp-wide quantizer; no timing or settlement error; no absolute clipping",
                "main_point_compatible": robust_rate_contains(qinterval, chosen["a_percent_per_usd"])}
            if not qinterval["feasible"] or not quantization["main_point_compatible"]:
                warnings.append("selected_point_requires_more_than_quantization_only_error")
        else:
            quantization["status"] = "not_applicable_to_noninteger_or_saturated_display"
        sinterval = robust_rate_interval(blocks, ids, 2)
        stress = {"status": "feasible" if sinterval["feasible"] else "infeasible", "rate_interval": sinterval,
                  "capacity_range_usd": frontier_capacity_range(sinterval), "frozen_membership": True}
        support = chosen["support"]
        if support["independent_support_count"] < 2:
            warnings.append("repeated_groups_share_endpoint_errors")
        if support["support_weight_fraction"] < .25:
            warnings.append("rare_frontier_support")
        if stress["capacity_range_usd"]["upper"] is None:
            warnings.append("stress_upper_capacity_unbounded")
        width = (chosen["conditional_range_usd"]["upper"] - chosen["conditional_range_usd"]["lower"]) / chosen["total_api_cost_usd"]
        if width > .5:
            warnings.append("wide_conditional_measurement_range")
        if len(neighborhoods) > 1:
            warnings.append("higher_rate_modes_compatible_with_contamination")
    bounds_only = robust_rate_interval(blocks, set(), envelope)
    return {"status": "conditional_frontier_estimate" if chosen else "cannot_estimate",
        "estimated_total_api_cost_usd": chosen["total_api_cost_usd"] if chosen else None,
        "a_percent_per_usd": chosen["a_percent_per_usd"] if chosen else None,
        "conditional_range_usd": chosen["conditional_range_usd"] if chosen else {"lower": None, "upper": None, "feasible": False, "not_confidence_interval": True},
        "selected_hypothesis_id": chosen["id"] if chosen else None,
        "selected_block_ids": chosen["selected_block_ids"] if chosen else [],
        "support": chosen["support"] if chosen else frontier_support_groups(blocks, set(), weights, None, envelope),
        "weight_cap": cap, "endpoint_error_percent": envelope, "quality_flags": warnings,
        "reasons": [] if chosen else sorted({reason for h in hypotheses for reason in h["reasons"]}) or ["no_quota_cost_overlap_hypothesis"],
        "quantization_only": quantization, "endpoint_error_stress": stress,
        "unconditional_identification": {"upper_capacity_usd": None, "finite_upper_identified": False,
            "conditional_measurement_lower_usd": frontier_capacity_range(bounds_only)["lower"],
            "requires_valid_cost_epoch_and_error_envelope": True},
        "evidence_basis": "retrospective_all_supplied_blocks_with_assumed_near_clean_selected_atoms",
        "selection_rule": "lowest separate feasible-rate neighborhood; strongest original information within overlapping bands",
        "coarsening_counts": [1, 2, 4, 8], "tilings_are_not_independent_samples": True,
        "neighborhoods": [{"rate_lower": n["lower"], "rate_upper": n["upper"],
            "hypothesis_ids": [h["id"] for h in n["members"]],
            "membership_sensitivity_range_usd": {"lower": 100 / n["upper"], "upper": 100 / n["lower"]},
            "not_one_fixed_membership_interval": True} for n in neighborhoods],
        "hypotheses": [{key: value for key, value in h.items() if key not in ("support", "rate_interval")} |
            {"support_group_count": h["support"]["group_count"], "endpoint_disjoint_count": h["support"]["independent_support_count"],
             "support_weight_fraction": h["support"]["support_weight_fraction"],
             "rate_bounds": {"lower": h["rate_interval"]["lower"], "upper": h["rate_interval"]["upper"], "feasible": h["rate_interval"]["feasible"]}}
            for h in hypotheses]}


def frontier_validate_frozen(training_fit: dict, holdout: list, *, envelope: float, target_span: float) -> dict:
    holdout = frontier_unique_blocks(holdout)
    rate = training_fit["a_percent_per_usd"]
    weights = robust_weights(holdout, envelope, target_span, training_fit["weight_cap"])
    compatible = set()
    rho = ROBUST_PROTOCOL["near_clean_external_fraction"]
    for b in holdout:
        if rate is None:
            break
        lower_before, upper_before = robust_endpoint_error(b["before"], envelope)
        lower_after, upper_after = robust_endpoint_error(b["after"], envelope)
        predicted = rate * b["known_api_cost_usd"]
        if predicted + lower_after - upper_before <= b["delta_percent"] + 1e-10 and b["delta_percent"] <= (1 + rho) * predicted + upper_after - lower_before + 1e-10:
            compatible.add(b["id"])
    support = frontier_support_groups(holdout, compatible, weights, rate, envelope)
    one_sided = robust_rate_interval(holdout, set(), envelope)
    near_clean = robust_rate_interval(holdout, compatible, envelope)
    one_ok = robust_rate_contains(one_sided, rate) if rate is not None and holdout else None
    clean_ok = robust_rate_contains(near_clean, rate) if rate is not None and holdout else None
    reasons = []
    if rate is None:
        status = "training_frontier_unavailable"
    elif not holdout:
        status = "no_later_evidence"
    elif one_ok is False:
        status = "contradicted_under_endpoint_error_assumption"
    else:
        if clean_ok is False:
            reasons.append("near_clean_membership_not_jointly_reproduced")
        if support["independent_support_count"] < 2:
            reasons.append("fewer_than_two_endpoint_disjoint_later_groups")
        if (support["clean_predicted_delta_percent"] or 0) < 5 - 1e-10:
            reasons.append("later_signal_below_5pp")
        if support["support_weight_fraction"] < .25:
            reasons.append("later_low_interference_support_below_25_percent")
        if support["span_seconds"] < target_span:
            reasons.append("later_support_duration_too_short")
        status = "later_recurrence_supported" if not reasons else "limited_later_recurrence"
    return {"status": status, "training_candidate_usd": training_fit["estimated_total_api_cost_usd"],
        "frozen_a_percent_per_usd": rate, "candidate_refitted_on_holdout": False,
        "support": support, "one_sided_compatible": one_ok, "near_clean_jointly_compatible": clean_ok,
        "reasons": reasons, "applies_only_to_training_candidate": True,
        "not_accuracy_against_true_capacity": True}


def robust_segments(roots: list, prices: dict, *, source_label: str = "selected_local_roots",
                    account_label: str = "unverified", now: Optional[datetime] = None,
                    policies: Optional[tuple] = None, offsets: tuple = (-60, 0, 60)) -> tuple:
    now = now or datetime.now(UTC)
    policies = tuple(dict(p) for p in (ROBUST_POLICIES if policies is None else policies))
    for policy in policies:
        span = policy.get("target_span_seconds")
        if type(span) not in (int, float) or not math.isfinite(span) or span <= 0:
            raise ValueError("Robust target_span_seconds must be finite and positive")
        policy.setdefault("min_span_seconds", span)
        policy.setdefault("max_gap_seconds", 300)
        policy.setdefault("min_delta_percent", 0)
    data, paths = historical_segments(roots, prices, source_label=source_label, account_label=account_label,
        now=now, policies=policies, offsets=offsets, _block_span_seconds={p["id"]: p["target_span_seconds"] for p in policies},
        _target_profile_ownership=True, _source_aware_epochs=True)
    epochs = {e["quota_epoch_id"]: e for e in data["quota_epochs"]}
    # A grid interval with no local receipt is still a quota-path constraint.
    # Assign it only between matching adjacent profile blocks, with an unbroken
    # endpoint chain. It never supplies a near-clean anchor or a cost weight.
    timelines = defaultdict(list)
    for block in data["attempts"]:
        timelines[(block["quota_epoch_id"], block["policy_id"], block["alignment_offset_seconds"])].append(block)
    for timeline in timelines.values():
        timeline.sort(key=lambda b: (b["before"]["observed_at"], b["after"]["observed_at"]))
        index = 0
        while index < len(timeline):
            start = index
            while index < len(timeline) and timeline[index]["profile"] is None and timeline[index]["known_api_cost_usd"] == 0 and timeline[index]["local_event_count"] == 0 and timeline[index]["reasons"] == ["no_local_usage"]:
                index += 1
            if index == start:
                index += 1
                continue
            if start == 0 or index == len(timeline):
                continue
            before, after = timeline[start - 1], timeline[index]
            chain = timeline[start - 1:index + 1]
            if (before["status"] == after["status"] == "eligible" and before["profile"] is not None and
                    before["profile"] == after["profile"] and
                    all(a["after"]["id"] == b["before"]["id"] for a, b in zip(chain, chain[1:]))):
                for block in timeline[start:index]:
                    block.update(profile=dict(before["profile"]), status="eligible", reasons=[],
                                 profile_assignment_basis="matching_adjacent_profiles_zero_cost_path_only",
                                 constraint_only=True)
                    if "ownership" in block:
                        block["ownership"] = {**block["ownership"], "owner_profile": dict(before["profile"]),
                                              "scope": "zero_cost_path_constraint_only"}
    groups = defaultdict(list)
    for row in data["model_scenarios"]:
        groups.setdefault((row["quota_epoch_id"], tuple(row["profile"].values()), row["policy_id"], row["alignment_offset_seconds"]), [])
    for block in data["attempts"]:
        if block["profile"] is not None:
            groups[(block["quota_epoch_id"], tuple(block["profile"].values()), block["policy_id"], block["alignment_offset_seconds"])].append(block)
    exposure_intervals = defaultdict(list)
    for (eid, profile, pid, offset), members in groups.items():
        for block in members:
            if block["status"] == "eligible" and block["local_event_count"] > 0:
                exposure_intervals[(eid, profile)].append((timestamp(block["before"]["observed_at"]),
                                                            timestamp(block["after"]["observed_at"])))
    exposure_partitions = {key: robust_exposure_partition(intervals)
                           for key, intervals in exposure_intervals.items()}
    by_policy = {p["id"]: p for p in policies}
    latest = {}
    for block in data["attempts"]:
        for snap in (block["before"], block["after"]):
            eid = snap["quota_epoch_id"]
            if eid not in latest or snap["observed_at"] > latest[eid]["observed_at"]:
                latest[eid] = snap
    # Sparse epochs still have an as-of snapshot in historical scenario metadata.
    for row in data["model_scenarios"]:
        if row["quota_epoch_id"] not in latest:
            latest[row["quota_epoch_id"]] = {"observed_at": row["remaining"]["observed_at"], "used_percent": row["remaining"]["used_percent"],
                                              "id": row["remaining"]["snapshot_id"], "measurement_time": None}
    scenarios, frontier_inputs = [], {}
    for (eid, profile, pid, offset), members in sorted(groups.items(), key=lambda x: str(x[0])):
        epoch = epochs[eid]
        valid = sorted((b for b in members if b["status"] == "eligible" and b["known_api_cost_usd"] >= 0),
                       key=lambda b: (b["before"]["observed_at"], b["after"]["observed_at"]))
        epoch_start, epoch_end = timestamp(epoch["started_at"]), timestamp(epoch["last_observed_at"])
        exposure = exposure_partitions.get((eid, profile))
        cutoff = exposure["cutoff"] if exposure else epoch_start + (epoch_end - epoch_start) * (2 / 3)
        training = [b for b in valid if timestamp(b["after"]["observed_at"]) <= cutoff]
        holdout = [b for b in valid if timestamp(b["before"]["observed_at"]) > cutoff]
        chosen = {b["id"] for b in training + holdout}
        purged = [b for b in valid if b["id"] not in chosen]
        if training and holdout and training[-1]["after"]["id"] == holdout[0]["before"]["id"]:
            purged, holdout = purged + holdout[:1], holdout[1:]
        fits = {name: robust_fit_blocks(training, holdout, valid, envelope=error, target_span=by_policy[pid]["target_span_seconds"],
                training_period=(exposure["start"] if exposure else epoch_start, cutoff),
                training_support_midpoint=exposure["training_midpoint"] if exposure else None)
                for name, error in ROBUST_PROTOCOL["endpoint_error_envelopes_percent"].items()}
        frontier_inputs[(eid, profile, pid, offset)] = (valid, training, holdout)
        candidate = fits["base"]["candidate"]
        reasons = sorted({reason for fit in fits.values() for reason in fit["reasons"]})
        if epoch["status"] == "quarantined":
            reasons.append("retired_window_return")
        if any(timestamp(b["after"]["observed_at"]) > now or
               (b.get("latest_local_event_at") and timestamp(b["latest_local_event_at"]) > now) for b in valid):
            reasons.append("evidence_after_analysis_time")
        if data["global_reasons"]:
            reasons.extend(data["global_reasons"])
        envelope_values = [f["candidate"]["total_api_cost_usd"] for f in fits.values() if f["candidate"]["total_api_cost_usd"] is not None]
        envelope_spread = ((max(envelope_values) - min(envelope_values)) / robust_median(envelope_values)) if len(envelope_values) == 2 else None
        if envelope_spread is None or envelope_spread > 0.5:
            reasons.append("error_envelope_sensitivity")
        ranges = [f["candidate"]["conditional_range_usd"] for f in fits.values()]
        bound_low = min(r["lower"] for r in ranges) if all(r["lower"] is not None for r in ranges) else None
        bound_high = max(r["upper"] for r in ranges) if all(r["upper"] is not None for r in ranges) else None
        point = candidate["total_api_cost_usd"]
        if point is None or bound_low is None or bound_high is None or (bound_high - bound_low) / point > 0.5:
            reasons.append("wide_or_unbounded_envelope_range")
        ready = point is not None and not reasons
        snap = latest.get(eid)
        current = next((c for c in data["current_quota_epochs"] if c["limit_id"] == epoch["identity"]["limit_id"] and c["window_kind"] == epoch["identity"]["window_kind"]), None)
        scope = "current_cycle_as_of" if current and current["quota_epoch_id"] == eid and current["status"] == "observed" else "historical_as_of"
        remain_reasons = ["unverified_snapshot_freshness"]
        if scope != "current_cycle_as_of":
            remain_reasons.append("not_verified_current_epoch")
        if epoch["ambiguity_reasons"]:
            remain_reasons.append("quota_epoch_ambiguous")
        scenarios.append({"quota_epoch_id": eid, "identity": epoch["identity"], "profile": dict(zip(("model", "mode", "effort"), profile)),
            "identifiability_assumptions": list(ROBUST_PROTOCOL["assumptions"]),
            "epoch_status": epoch["status"], "epoch_classification": epoch["classification"], "epoch_started_at": epoch["started_at"],
            "epoch_continuity_assumptions": list(epoch.get("continuity_assumptions", [])),
            "epoch_continuity_evidence_count": len(epoch.get("continuity_evidence", [])),
            "epoch_ambiguity_reasons": epoch["ambiguity_reasons"], "policy_id": pid, "alignment_offset_seconds": offset,
            "target_span_seconds": by_policy[pid]["target_span_seconds"], "status": "conditional_estimate" if ready else "cannot_estimate",
            "reasons": sorted(set(reasons)), "candidate": candidate, "fits": fits,
            "estimated_total_api_cost_usd": point if ready else None,
            "total_conditional_range_usd": {"lower": bound_low if ready else None, "upper": bound_high if ready else None},
            "statistical_confidence_interval": None, "split": {"training_block_ids": [b["id"] for b in training],
                "purged_block_ids": [b["id"] for b in purged], "purged_known_api_cost_usd": sum(b["known_api_cost_usd"] for b in purged),
                "holdout_block_ids": [b["id"] for b in holdout], "cutoff_at": cutoff.isoformat(), "epoch_start": epoch_start.isoformat(), "epoch_end": epoch_end.isoformat(),
                "basis": "canonical_union_of_eligible_target_workload_exposure" if exposure else "no_target_exposure_epoch_clock_fallback",
                "observed_exposure_seconds": exposure["observed_exposure_seconds"] if exposure else 0,
                "exposure_interval_count": exposure["interval_count"] if exposure else 0,
                "training_support_midpoint_at": exposure["training_midpoint"].isoformat() if exposure else None,
                "shared_across_timing_variants": True,
                "no_receipt_intervals_supply_exposure": False,
                "training_fraction_by_count": len(training) / len(valid) if valid else None,
                "purge_reason": "straddles_or_touches_frozen_exposure_cutoff_or_shared_frontier"},
            "counts": {"attempted_blocks": len(members), "usable_blocks": len(valid), "excluded_blocks": len(members) - len(valid),
                       "zero_delta_usable_blocks": sum(b["delta_percent"] == 0 for b in valid),
                       "zero_cost_blocks": sum(b["known_api_cost_usd"] == 0 for b in members)},
            "exclusion_reasons": dict(sorted(Counter(r for b in members if b["status"] == "rejected" for r in b["reasons"]).items())),
            "observed_period": {"start": valid[0]["before"]["observed_at"] if valid else None, "end": valid[-1]["after"]["observed_at"] if valid else None},
            "remaining": {"estimated_remaining_api_cost_usd": None,
                "diagnostic_remaining_api_cost_usd": point * (100 - snap["used_percent"]) / 100 if point is not None and snap else None,
                "scope": scope, "observed_at": snap["observed_at"] if snap else None, "used_percent": snap["used_percent"] if snap else None,
                "measurement_time": None, "is_live_lookup": False, "reasons": remain_reasons},
            "error_envelope_relative_spread": envelope_spread})
    sensitivity_groups = defaultdict(list)
    for row in scenarios:
        sensitivity_groups[(row["quota_epoch_id"], tuple(row["profile"].values()))].append(row)
    for members in sensitivity_groups.values():
        values = [r["candidate"]["total_api_cost_usd"] for r in members if r["candidate"]["total_api_cost_usd"] is not None]
        median = robust_median(values)
        spread = (max(values) - min(values)) / median if median else None
        passing = [r for r in members if r["estimated_total_api_cost_usd"] is not None]
        passing_lengths = sorted({r["target_span_seconds"] for r in passing})
        passing_offsets = sorted({r["alignment_offset_seconds"] for r in passing})
        present_variants = {(r["policy_id"], r["alignment_offset_seconds"]) for r in members}
        coverage = (len(passing) >= ROBUST_PROTOCOL["minimum_passing_timing_schemes"] and
                    len(passing_lengths) >= ROBUST_PROTOCOL["minimum_passing_block_lengths"] and
                    len(passing_offsets) >= ROBUST_PROTOCOL["minimum_passing_offsets"])
        sensitivity = {"expected_variants": len(policies) * len(offsets), "available_candidates": len(values),
                       "unavailable_candidates": len(policies) * len(offsets) - len(values),
                       "missing_variants": [{"policy_id": p["id"], "alignment_offset_seconds": offset,
                                             "reason": "no_quota_paired_profile_evidence"}
                                            for p in policies for offset in offsets if (p["id"], offset) not in present_variants],
                       "passing_timing_schemes_before_sensitivity": len(passing),
                       "passing_block_lengths_seconds": passing_lengths, "passing_offsets_seconds": passing_offsets,
                       "minimum_timing_coverage_satisfied": coverage,
                       "variant_results": [{"policy_id": r["policy_id"], "alignment_offset_seconds": r["alignment_offset_seconds"],
                                            "passes_local_gates": r in passing, "reasons": list(r["reasons"])} for r in members],
                       "candidate_min": min(values) if values else None, "candidate_max": max(values) if values else None,
                       "relative_spread": spread, "severe_divergence": spread is not None and spread > 0.5}
        for row in members:
            row["sensitivity"] = dict(sensitivity)
            extra = (["timing_alignment_sensitivity"] if sensitivity["severe_divergence"] else []) + ([] if coverage else ["insufficient_timing_scheme_coverage"])
            if extra:
                row["reasons"] = sorted(set(row["reasons"] + extra))
                row["status"] = "cannot_estimate"
                row["estimated_total_api_cost_usd"] = None
                row["total_conditional_range_usd"] = {"lower": None, "upper": None}
    # R4 separates a practical retrospective estimate from the stricter R3
    # validation certificate. Failing heldout gates no longer hides all values.
    for row in scenarios:
        key = (row["quota_epoch_id"], tuple(row["profile"].values()), row["policy_id"], row["alignment_offset_seconds"])
        valid, training, holdout = frontier_inputs[key]
        row["strict_validation"] = {"status": row["status"], "reasons": list(row["reasons"]),
            "estimated_total_api_cost_usd": row["estimated_total_api_cost_usd"],
            "total_conditional_range_usd": dict(row["total_conditional_range_usd"]),
            "timing_sensitivity": row["sensitivity"]}
        frontier = frontier_fit(valid, target_span=row["target_span_seconds"])
        training_frontier = frontier_fit(training, target_span=row["target_span_seconds"])
        validation = frontier_validate_frozen(training_frontier, holdout, envelope=1, target_span=row["target_span_seconds"])
        frontier["historical_validation"] = validation
        frontier["training_frontier"] = {k: training_frontier[k] for k in (
            "status", "estimated_total_api_cost_usd", "conditional_range_usd", "selected_block_ids", "support", "reasons")}
        old_point, full_point = training_frontier["estimated_total_api_cost_usd"], frontier["estimated_total_api_cost_usd"]
        shift = (full_point - old_point) / old_point if old_point and full_point else None
        frontier["full_vs_training_point_relative_change"] = shift
        if shift is not None and abs(shift) > .25:
            frontier["quality_flags"].append("substantial_change_from_earlier_training_estimate")
        if validation["status"] != "later_recurrence_supported":
            frontier["quality_flags"].append(validation["status"])
        if row["epoch_ambiguity_reasons"] or row.get("epoch_continuity_assumptions"):
            frontier["quality_flags"].append("conditional_epoch_interpretation")
        observed_early_cache = robust_cache_fraction(training)
        observed_later_cache = robust_cache_fraction(holdout)
        if observed_early_cache is not None and observed_later_cache is not None and abs(observed_early_cache - observed_later_cache) >= .2:
            frontier["quality_flags"].append("observed_workload_cache_mix_shift")
        chosen_ids = set(frontier["selected_block_ids"])
        early_cache = robust_cache_fraction([b for b in training if b["id"] in chosen_ids])
        later_cache = robust_cache_fraction([b for b in holdout if b["id"] in chosen_ids])
        if early_cache is not None and later_cache is not None and abs(early_cache - later_cache) >= .2:
